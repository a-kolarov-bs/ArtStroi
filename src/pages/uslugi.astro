---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { projects } from '../data/projects';

// ────────────────────────────────────────────────────────────────
// Spec-sheet services page — dense editorial, six disciplines,
// drafted in the language of a real construction specification book.
// ────────────────────────────────────────────────────────────────

const currentYear = new Date().getFullYear();
const yearsActive = currentYear - 1992;
const totalProjects = projects.length;

const services = [
  {
    code: 'A.01',
    slug: 'arch',
    tag: 'ЖИЛ',
    title: 'Жилищно строителство',
    summary:
      'Многофамилни блокове, затворени комплекси, фамилни къщи и вили. Поемаме целия цикъл — от изкопа до Акт 16.',
    segments: [
      'Многофамилни жилищни блокове',
      'Затворени жилищни комплекси',
      'Еднофамилни къщи и вили',
      'Апартхотели и ваканционни обекти',
    ],
    scope: [
      'Кофраж и стоманобетон',
      'Зидария и преградни стени',
      'Покривни конструкции',
      'Фасади и довършителни работи',
      'Партери и общи части',
    ],
    refCount: 14,
    refCat: 'Жилищни сгради',
  },
  {
    code: 'P.02',
    slug: 'pub',
    tag: 'ОБЩ',
    title: 'Обществени и индустриални сгради',
    summary:
      'Училища, читалища, спортни зали, общински и производствени обекти. Дълъг опит с обществени поръчки и държавни инвеститори.',
    segments: [
      'Образователни обекти',
      'Здравни заведения',
      'Спортни и културни обекти',
      'Производствени халета',
    ],
    scope: [
      'Изпълнение по работни проекти',
      'Сертифицирани материали',
      'Контрол по ЗУТ',
      'Приемателни актове 12 / 15 / 16',
      'Инвестиционен надзор',
    ],
    refCount: 18,
    refCat: 'Обществени сгради',
  },
  {
    code: 'I.03',
    slug: 'inf',
    tag: 'ПЪТ',
    title: 'Пътна и градска инфраструктура',
    summary:
      'Улици, площади, тротоари, подпорни стени и корекции на речни корита — включително възстановяване след свлачища.',
    segments: [
      'Общински улици и тротоари',
      'Градски площади',
      'Подпорни конструкции',
      'Свлачищни укрепвания',
      'Корекции на речни корита',
    ],
    scope: [
      'Земни работи',
      'Асфалтови настилки',
      'Бетонови съоръжения',
      'Дъждовна канализация',
      'Пътна маркировка',
    ],
    refCount: 12,
    refCat: 'Инфраструктура',
  },
  {
    code: 'R.04',
    slug: 'rnv',
    tag: 'РЕК',
    title: 'Реконструкция и енергийно саниране',
    summary:
      'Цялостна рехабилитация на стари сгради и фасадно саниране за нормативна енергийна ефективност — с пълна документация.',
    segments: [
      'Жилищни блокове',
      'Обществени сгради',
      'Хотели и СПА',
      'Исторически градски обекти',
    ],
    scope: [
      'Топлоизолация фасади и покриви',
      'Подмяна на дограма',
      'Хидроизолации',
      'Конструктивно усилване',
      'Сертификат за енергийна ефективност',
    ],
    refCount: 7,
    refCat: 'Обществени сгради',
  },
  {
    code: 'M.05',
    slug: 'mep',
    tag: 'ИНС',
    title: 'Електро, ВиК и инсталации',
    summary:
      'Вътрешни и външни инсталации — електро, ВиК, ОВиК — със сертифицирани материали, проби и приемателни актове.',
    segments: [
      'Жилищни обекти',
      'Обществени и образователни',
      'Хотели и комплекси',
      'Промишлени халета',
    ],
    scope: [
      'Електро ниско напрежение',
      'Водопровод и канализация',
      'Отопление и охлаждане',
      'Слаботокови инсталации',
      'Външни мрежи и съоръжения',
    ],
    refCount: 9,
    refCat: 'Обществени сгради',
  },
  {
    code: 'F.06',
    slug: 'fin',
    tag: 'ФИН',
    title: 'Реставрация и довършителен финиш',
    summary:
      'Декоративни ремонти, реставрация на исторически фасади, барбекюта и камини по индивидуален проект — където детайлът е продукт.',
    segments: [
      'Исторически фасади',
      'Луксозни интериори',
      'Открити терени и градини',
      'Бутикови хотели',
    ],
    scope: [
      'Каменни облицовки',
      'Дървени и метални детайли',
      'Реставрация на мазилки',
      'Барбекюта и камини',
      'Парапети и ковано желязо',
    ],
    refCount: 5,
    refCat: 'Обществени сгради',
  },
];

const inHouse = [
  'Главно изпълнение',
  'Кофраж и стоманобетон',
  'Зидария и преграждания',
  'Довършителни работи',
  'Координация на обекта',
  'Геодезичен контрол',
];
const partners = [
  'Архитектурно проектиране',
  'Конструктивно проектиране',
  'ОВК / Електро проектиране',
  'Лабораторни тестове',
  'Специализиран мониторинг',
];

const method = [
  {
    n: '01',
    title: 'Анализ',
    body: 'Анализираме терена, регулациите и инвестиционната рамка. Подходът се съгласува с проектанта и инвеститора преди договор.',
  },
  {
    n: '02',
    title: 'Договор',
    body: 'Изготвяме спецификации, оферта и срокове. Прозрачно ценообразуване по позиции — без скрити линии и междинни корекции.',
  },
  {
    n: '03',
    title: 'Изпълнение',
    body: 'Координиран екип на обекта — груб строеж, инсталации, фасади и финиш. Контрол по етапи с протоколи и снимков отчет.',
  },
  {
    n: '04',
    title: 'Предаване',
    body: 'Предаване с пълна изпълнителна документация. Гаранционна поддръжка и експлоатационна намеса по договор.',
  },
];

const pageTitle = 'Услуги · АРТСТРОЙ ООД — пълен обхват строителни услуги';
const pageDescription =
  'Жилищно и обществено строителство, инфраструктура, реконструкция, енергийно саниране, инсталации и реставрация. 33 години изпълнение под един договор.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- ════════════════════════════════════════════════════════════
       1 · HERO — dark editorial slab.
       Twelve-column split: title block left, live service index right.
       Compact py — no oceans of negative space.
       ════════════════════════════════════════════════════════════ -->
  <section class="us-hero relative isolate overflow-hidden bg-ink-950 text-white">
    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-brand"></span>

    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-d opacity-[0.16]"></div>

    <span
      aria-hidden="true"
      class="us-hero__backdrop absolute -right-6 -bottom-12 select-none pointer-events-none font-display italic text-white/[0.045] leading-[0.78]"
      style="font-size: clamp(12rem, 22vw, 26rem); font-variation-settings:'opsz' 144,'SOFT' 100;"
    >
      дисциплини
    </span>

    <div class="container-page relative pt-32 md:pt-36 lg:pt-40 pb-14 md:pb-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-end">
        <!-- LEFT — editorial title block -->
        <Reveal class="lg:col-span-7">
          <p class="eyebrow flex items-center gap-3 flex-wrap text-brand">
            <span class="inline-block h-px w-10 bg-brand"></span>
            Услуги · 1992 → {currentYear}
          </p>
          <h1
            class="mt-5 md:mt-7 font-display tracking-tight leading-[0.95] text-white max-w-[20ch]"
            style="font-size: clamp(2.5rem, 1.25rem + 5vw, 6rem); letter-spacing: -0.025em;"
          >
            Шест дисциплини.
            <span class="italic block text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
              Един договор.
            </span>
          </h1>
          <p class="mt-7 md:mt-9 max-w-[52ch] text-base md:text-lg text-white/70 leading-[1.65]">
            От първия изкоп до Акт 16 — пълен обхват строителни услуги под покрива на една фирма. Без външни подизпълнители на ключовите позиции, без размити отговорности.
          </p>

          <!-- Tight inline stats — no separate band section -->
          <dl class="mt-9 md:mt-11 grid grid-cols-3 gap-x-6 gap-y-4 max-w-xl border-t border-white/12 pt-6">
            <div>
              <dt class="sr-only">Години работа</dt>
              <dd class="us-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.8rem, 1rem + 1.8vw, 2.75rem); font-variation-settings:'opsz' 144;">
                <span data-counter={yearsActive}>0</span><span class="text-brand">+</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">Години работа</p>
            </div>
            <div>
              <dt class="sr-only">Реализирани обекти</dt>
              <dd class="us-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.8rem, 1rem + 1.8vw, 2.75rem); font-variation-settings:'opsz' 144;">
                <span data-counter={totalProjects}>0</span><span class="text-brand">+</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">Реализирани обекта</p>
            </div>
            <div>
              <dt class="sr-only">Дисциплини</dt>
              <dd class="us-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.8rem, 1rem + 1.8vw, 2.75rem); font-variation-settings:'opsz' 144;">
                <span data-counter="6" data-pad="2">0</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">Дисциплини</p>
            </div>
          </dl>
        </Reveal>

        <!-- RIGHT — live spec-sheet index, jump-links to each card -->
        <Reveal class="lg:col-span-5" delay={120}>
          <div class="us-index relative">
            <div class="flex items-baseline justify-between border-b border-white/15 pb-3">
              <p class="text-[10.5px] uppercase tracking-eyebrow text-white/55">
                Указател · Стр.&nbsp;А
              </p>
              <p class="font-display italic text-white/55 text-sm tabular-nums" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                06 / 06
              </p>
            </div>
            <ol class="us-index__list">
              {services.map((s) => (
                <li>
                  <a href={`#${s.slug}`} class="us-index__row group">
                    <span class="us-index__code font-display italic tabular-nums" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                      {s.code}
                    </span>
                    <span class="us-index__tag" aria-hidden="true">{s.tag}</span>
                    <span class="us-index__title">{s.title}</span>
                    <span class="us-index__leaders" aria-hidden="true"></span>
                    <span class="us-index__count font-display italic tabular-nums" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                      {s.refCount}
                    </span>
                    <span class="us-index__arrow" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       2 · SERVICE CARDS — 6 dense editorial blocks in a 3×2 grid.
       Each card is its own specification page: code, title, segments
       and scope all visible without hover. Density is intentional.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-cream-50 py-16 md:py-20 lg:py-24" aria-labelledby="services-grid-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet"></div>

    <div class="container-page relative">
      <Reveal class="max-w-3xl mb-10 md:mb-14">
        <p class="eyebrow">Спецификации</p>
        <h2
          id="services-grid-heading"
          class="mt-3 font-display tracking-tight text-ink-950"
          style="font-size: clamp(1.6rem, 1rem + 1.6vw, 2.45rem); line-height: 1.1;"
        >
          Какво е под нашия <span class="italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">подпис</span>.
        </h2>
      </Reveal>

      <ol class="us-grid grid grid-cols-2 lg:grid-cols-3 gap-x-px gap-y-0 lg:gap-px bg-ink-900/30 sm:bg-ink-900/10 -mx-3 sm:mx-0">
        {services.map((s, i) => (
          <Reveal as="li" delay={i * 80} class="us-card group">
            <article id={s.slug} class="us-card__inner">
              <header class="us-card__head">
                <span class="us-card__code" aria-hidden="true">{s.code} · {s.tag}</span>
                <span class="us-card__count font-display italic tabular-nums" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                  №{String(i + 1).padStart(2, '0')}
                </span>
              </header>

              <h3
                class="us-card__title font-display tracking-tight text-ink-950"
                style="font-size: clamp(1.3rem, 0.95rem + 0.85vw, 1.7rem); line-height: 1.08;"
              >
                {s.title}
              </h3>

              <span aria-hidden="true" class="us-card__hr"></span>

              <p class="us-card__summary text-[14.5px] md:text-[15px] text-ink-600 leading-[1.6]">
                {s.summary}
              </p>

              <section class="us-card__block">
                <p class="us-card__label">Сегменти</p>
                <ul class="us-card__bul">
                  {s.segments.map((seg) => (
                    <li>{seg}</li>
                  ))}
                </ul>
              </section>

              <section class="us-card__block">
                <p class="us-card__label">Обхват</p>
                <ul class="us-card__check">
                  {s.scope.map((sc) => (
                    <li>
                      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                        <path d="M2 5.5l2.2 2.2L9 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span>{sc}</span>
                    </li>
                  ))}
                </ul>
              </section>

              <footer class="us-card__foot">
                <a href={`/proekti?cat=${encodeURIComponent(s.refCat)}`} class="us-card__more">
                  <span>{s.refCount} проекта в архива</span>
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </footer>
            </article>
          </Reveal>
        ))}
      </ol>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       3 · CAPABILITY MATRIX — what we keep in-house vs partner.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-cream-100 border-y border-ink-900/[0.08] py-14 md:py-20" aria-labelledby="matrix-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>

    <div class="container-page relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <Reveal class="lg:col-span-4">
          <p class="eyebrow">Контрол</p>
          <h2
            id="matrix-heading"
            class="mt-3 font-display tracking-tight text-ink-950"
            style="font-size: clamp(1.6rem, 1rem + 1.5vw, 2.3rem); line-height: 1.1;"
          >
            Какво поемаме <span class="italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">сами</span>.
          </h2>
          <p class="mt-5 max-w-md text-[15px] text-ink-600 leading-[1.65]">
            Ключовите дисциплини са под собствен контрол — собствени бригади, собствено оборудване, прозрачен график. Специализираните работи — с дългогодишни партньори.
          </p>
        </Reveal>

        <Reveal class="lg:col-span-8" delay={120}>
          <div class="grid sm:grid-cols-2 gap-px bg-ink-900/12">
            <div class="bg-cream-100 p-6 md:p-7">
              <div class="flex items-baseline justify-between mb-5">
                <p class="text-[10.5px] uppercase tracking-eyebrow text-brand font-semibold">Собствено изпълнение</p>
                <span class="font-display italic text-ink-900/35 tabular-nums text-sm" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                  {String(inHouse.length).padStart(2, '0')}
                </span>
              </div>
              <ul class="space-y-2.5">
                {inHouse.map((x) => (
                  <li class="us-matrix__row flex items-baseline gap-3 text-[14.5px] text-ink-950">
                    <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 rounded-full bg-brand shrink-0"></span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-cream-100 p-6 md:p-7">
              <div class="flex items-baseline justify-between mb-5">
                <p class="text-[10.5px] uppercase tracking-eyebrow text-ink-900/60 font-semibold">Сертифицирани партньори</p>
                <span class="font-display italic text-ink-900/35 tabular-nums text-sm" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                  {String(partners.length).padStart(2, '0')}
                </span>
              </div>
              <ul class="space-y-2.5">
                {partners.map((x) => (
                  <li class="us-matrix__row us-matrix__row--alt flex items-baseline gap-3 text-[14.5px] text-ink-600">
                    <span aria-hidden="true" class="mt-[5px] inline-block h-px w-3 bg-ink-900/40 shrink-0"></span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       4 · METHOD — compressed 4-step strip on dark.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-ink-950 text-white py-16 md:py-24" aria-labelledby="method-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-c opacity-[0.18]"></div>

    <div class="container-page relative">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-end mb-10 md:mb-14">
        <Reveal class="lg:col-span-7">
          <p class="eyebrow text-brand flex items-center gap-3">
            <span class="inline-block h-px w-10 bg-brand"></span>
            Метод
          </p>
          <h2
            id="method-heading"
            class="mt-4 font-display tracking-tight text-white max-w-[20ch]"
            style="font-size: clamp(1.85rem, 1rem + 2.2vw, 3rem); line-height: 1.05;"
          >
            Четири стъпки — една <span class="italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">отговорност</span>.
          </h2>
        </Reveal>
        <Reveal class="lg:col-span-5 lg:pb-2" delay={120}>
          <p class="text-[15px] md:text-base text-white/70 leading-[1.65] max-w-[44ch]">
            Дисциплиниран процес от анализ до предаване на ключа. Прозрачни срокове, протоколи по етапи и пълна изпълнителна документация.
          </p>
        </Reveal>
      </div>

      <ol class="us-method grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/10">
        {method.map((m, i) => (
          <Reveal as="li" delay={i * 80} class="us-method__cell group">
            <div class="flex items-baseline justify-between">
              <span
                class="us-method__n font-display block text-brand leading-none"
                style="font-size: clamp(2.5rem, 2rem + 1.4vw, 3.25rem); font-variation-settings:'opsz' 144,'SOFT' 0;"
              >
                {m.n}
              </span>
              <span class="us-method__step" aria-hidden="true">Стъпка</span>
            </div>
            <span aria-hidden="true" class="mt-4 block h-px w-10 bg-white/25 transition-[width,background-color] duration-700 ease-out-expo group-hover:w-20 group-hover:bg-brand"></span>
            <h3 class="mt-5 font-display text-xl md:text-[1.35rem] leading-tight text-white">
              {m.title}
            </h3>
            <p class="mt-3 text-[14px] md:text-[14.5px] text-white/70 leading-[1.65]">
              {m.body}
            </p>
          </Reveal>
        ))}
      </ol>
    </div>
