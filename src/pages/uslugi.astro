---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { projects, type ProjectCategory } from '../data/projects';
import { company, yearsActive as getYearsActive, cprsGroupsLabel } from '../data/company';

// ────────────────────────────────────────────────────────────────
// Spec-sheet services page — dense editorial, six disciplines,
// drafted in the language of a real construction specification book.
// ────────────────────────────────────────────────────────────────

import CtaBand from '../components/CtaBand.astro';
import { imageSize } from '../data/assets';

const currentYear = new Date().getFullYear();
const yearsActive = getYearsActive();
const totalProjects = projects.length;
const cprsLabel = cprsGroupsLabel();

// „1 реализиран обект“ / „N реализирани обекта“
const objectsLabel = (n: number) => (n === 1 ? '1 реализиран обект' : `${n} реализирани обекта`);

const heroStats = [
  ...(yearsActive !== null ? [{ label: 'Години работа', value: yearsActive, pad: 0, plus: true }] : []),
  { label: 'Реализирани обекта', value: totalProjects, pad: 0, plus: false },
  { label: 'Услуги', value: 6, pad: 2, plus: false },
];

const serviceDefs = [
  {
    code: 'A.01',
    slug: 'arch',
    tag: 'ЖИЛ',
    title: 'Жилищно строителство',
    summary:
      'Многофамилни блокове, затворени комплекси, фамилни къщи и вили. Поемаме целия цикъл, от изкопа до Акт 16.',
    segments: [
      'Многофамилни жилищни блокове',
      'Затворени жилищни комплекси',
      'Еднофамилни къщи и вили',
      'Апартхотели и ваканционни обекти',
    ],
    scope: [
      'Кофраж и стоманобетон',
      'Зидария и преградни стени',
      'Покривни конструкции',
      'Фасади и довършителни работи',
      'Партери и общи части',
    ],
    refCat: 'Жилищни сгради',
    photoId: 51,
  },
  {
    code: 'P.02',
    slug: 'pub',
    tag: 'ОБЩ',
    title: 'Обществени и индустриални сгради',
    summary:
      'Училища, читалища, спортни зали, общински и производствени обекти. Изпълняваме обществени поръчки за общини и държавни институции.',
    segments: [
      'Образователни обекти',
      'Здравни заведения',
      'Спортни и културни обекти',
      'Производствени халета',
    ],
    scope: [
      'Изпълнение по работни проекти',
      'Сертифицирани материали',
      'Контрол по ЗУТ',
      'Приемателни актове 12 / 15 / 16',
      'Инвестиционен надзор',
    ],
    refCat: 'Обществени сгради',
    photoId: 45,
  },
  {
    code: 'I.03',
    slug: 'inf',
    tag: 'ПЪТ',
    title: 'Пътна и градска инфраструктура',
    summary:
      'Улици, площади, тротоари, подпорни стени и корекции на речни корита, включително укрепване на свлачища.',
    segments: [
      'Общински улици и тротоари',
      'Градски площади',
      'Подпорни конструкции',
      'Свлачищни укрепвания',
      'Корекции на речни корита',
    ],
    scope: [
      'Земни работи',
      'Асфалтови настилки',
      'Бетонови съоръжения',
      'Дъждовна канализация',
      'Пътна маркировка',
    ],
    refCat: 'Инфраструктура',
    photoId: 9,
  },
  {
    code: 'R.04',
    slug: 'rnv',
    tag: 'РЕК',
    title: 'Реконструкция и енергийно саниране',
    summary:
      'Цялостна рехабилитация на стари сгради и саниране на фасади и покриви до нормативната енергийна ефективност, с пълна документация.',
    segments: [
      'Жилищни блокове',
      'Обществени сгради',
      'Хотели и СПА',
      'Исторически градски обекти',
    ],
    scope: [
      'Топлоизолация фасади и покриви',
      'Подмяна на дограма',
      'Хидроизолации',
      'Конструктивно усилване',
      'Сертификат за енергийна ефективност',
    ],
    refCat: 'Обществени сгради',
    photoId: 18,
  },
  {
    code: 'M.05',
    slug: 'mep',
    tag: 'ИНС',
    title: 'Електро, ВиК и инсталации',
    summary:
      'Вътрешни и външни инсталации: електро, ВиК, отопление, вентилация и климатизация. Със сертифицирани материали, проби и приемателни актове.',
    segments: [
      'Жилищни обекти',
      'Обществени и образователни',
      'Хотели и комплекси',
      'Промишлени халета',
    ],
    scope: [
      'Електро ниско напрежение',
      'Водопровод и канализация',
      'Отопление и охлаждане',
      'Слаботокови инсталации',
      'Външни мрежи и съоръжения',
    ],
    refCat: 'Обществени сгради',
    photoId: 41,
  },
  {
    code: 'F.06',
    slug: 'fin',
    tag: 'ФИН',
    title: 'Реставрация и довършителен финиш',
    summary:
      'Декоративни ремонти, реставрация на исторически фасади, барбекюта и камини по индивидуален проект.',
    segments: [
      'Исторически фасади',
      'Луксозни интериори',
      'Открити терени и градини',
      'Бутикови хотели',
    ],
    scope: [
      'Каменни облицовки',
      'Дървени и метални детайли',
      'Реставрация на мазилки',
      'Барбекюта и камини',
      'Парапети и ковано желязо',
    ],
    refCat: 'Обществени сгради',
    photoId: 12,
  },
] satisfies ({ refCat: ProjectCategory } & Record<string, unknown>)[];

// The count on each card is the number of cards the linked /proekti
// filter shows, so the two can never disagree.
const services = serviceDefs.map((s) => ({
  ...s,
  refCount: projects.filter((p) => p.category === s.refCat).length,
}));

const inHouse = [
  'Главно изпълнение',
  'Кофраж и стоманобетон',
  'Зидария и преграждания',
  'Довършителни работи',
  'Координация на обекта',
  'Геодезичен контрол',
];
const partners = [
  'Архитектурно проектиране',
  'Конструктивно проектиране',
  'ОВК / Електро проектиране',
  'Лабораторни тестове',
  'Специализиран мониторинг',
];

const method = [
  {
    n: '01',
    title: 'Анализ',
    body: 'Анализираме терена, регулациите и инвестиционната рамка. Подходът се съгласува с проектанта и инвеститора преди договор.',
  },
  {
    n: '02',
    title: 'Договор',
    body: 'Изготвяме спецификации, оферта и срокове. Цената в офертата е разписана по позиции.',
  },
  {
    n: '03',
    title: 'Изпълнение',
    body: 'Координиран екип на обекта: груб строеж, инсталации, фасади и довършителни работи. Контрол по етапи с протоколи и снимков отчет.',
  },
  {
    n: '04',
    title: 'Предаване',
    body: 'Предаваме обекта с пълна изпълнителна документация. Поддръжката след това е по договор.',
  },
];

// Card photo: `photoId` picks a real project of the same kind; its cover
// and title come from the data. A missing project or cover fails the build
// instead of showing a gap.
const cards = services.map((s) => {
  const ref = projects.find((p) => p.id === s.photoId);
  if (!ref || !ref.coverImageUrl) throw new Error(`uslugi: project ${s.photoId} has no cover`);
  return { ...s, photo: { src: ref.coverImageUrl, title: ref.title, href: `/proekti/${ref.slug}` } };
});

const pageTitle = 'Строителни услуги · АРТСТРОЙ ООД, Смолян';
const pageDescription =
  `Жилищно и обществено строителство, инфраструктура, реконструкция, енергийно саниране, инсталации и реставрация. ${
    yearsActive !== null ? `${yearsActive} години строителство в Смолян и областта.` : 'Строителна фирма от Смолян.'
  }`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- ════════════════════════════════════════════════════════════
       1 · HERO — dark editorial slab.
       Twelve-column split: title block left, live service index right.
       Compact py — no oceans of negative space.
       ════════════════════════════════════════════════════════════ -->
  <section class="us-hero relative isolate overflow-hidden bg-ink-950 text-white">
    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-brand"></span>

    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-d opacity-[0.16]"></div>

    <div class="container-page relative pt-28 md:pt-32 lg:pt-36 pb-12 md:pb-16">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-start">
        <!-- LEFT — editorial title block -->
        <Reveal class="lg:col-span-7">
          <p class="eyebrow flex items-center gap-3 flex-wrap text-brand">
            <span class="inline-block h-px w-10 bg-brand"></span>
            Услуги{company.founded !== null && ` · ${company.founded} → ${currentYear}`}
          </p>
          <h1
            class="mt-5 md:mt-7 font-display tracking-tight leading-[0.95] text-white max-w-[20ch]"
            style="font-size: clamp(2.5rem, 1.25rem + 5vw, 6rem); letter-spacing: -0.025em;"
          >
            Строителни
            <span class="block text-brand">
              услуги.
            </span>
          </h1>
          <p class="mt-7 md:mt-9 max-w-[52ch] text-base md:text-lg text-white/70 leading-[1.65]">
            Строим от изкопа до Акт&nbsp;16: жилищни и обществени сгради, улици и подпорни стени, саниране, инсталации и довършителни работи.
          </p>

          <!-- Tight inline stats — no separate band section -->
          <dl
            class="mt-9 md:mt-11 grid gap-x-6 gap-y-4 max-w-xl border-t border-white/12 pt-6"
            style={`grid-template-columns: repeat(${heroStats.length}, minmax(0, 1fr));`}
          >
            {heroStats.map((st) => (
              <div>
                <dt class="sr-only">{st.label}</dt>
                <dd class="us-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.8rem, 1rem + 1.8vw, 2.75rem);">
                  <span data-counter={st.value} data-pad={st.pad || undefined}>0</span>{st.plus && <span class="text-brand">+</span>}
                </dd>
                <p class="mt-3 text-xs uppercase tracking-eyebrow text-white/60">{st.label}</p>
              </div>
            ))}
          </dl>
        </Reveal>

        <!-- RIGHT — live spec-sheet index, jump-links to each card -->
        <Reveal class="hidden md:block lg:col-span-5 lg:pt-10" delay={120}>
          <div class="us-index relative">
            <div class="flex items-baseline justify-between border-b border-white/15 pb-3">
              <p class="text-xs uppercase tracking-eyebrow text-white/60">
                Указател
              </p>
              <p class="font-display text-white/55 text-sm tabular-nums">
                06 / 06
              </p>
            </div>
            <ol class="us-index__list">
              {services.map((s) => (
                <li>
                  <a href={`#${s.slug}`} class="us-index__row group">
                    <span class="us-index__code font-display tabular-nums">
                      {s.code}
                    </span>
                    <span class="us-index__tag" aria-hidden="true">{s.tag}</span>
                    <span class="us-index__title">{s.title}</span>
                    <span class="us-index__leaders" aria-hidden="true"></span>
                    <span class="us-index__count font-display tabular-nums">
                      {s.refCount}
                    </span>
                    <span class="us-index__arrow" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       2 · SERVICE CARDS — 6 dense editorial blocks in a 3×2 grid.
       Each card is its own specification page: code, title, segments
       and scope all visible without hover. Density is intentional.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-cream-50 py-16 md:py-20 lg:py-24" aria-labelledby="services-grid-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet"></div>

    <div class="container-page relative">
      <Reveal class="max-w-3xl mb-10 md:mb-14">
        <p class="eyebrow">Шест направления</p>
        <h2
          id="services-grid-heading"
          class="mt-3 font-display tracking-tight text-ink-950"
          style="font-size: clamp(1.6rem, 1rem + 1.6vw, 2.45rem); line-height: 1.1;"
        >
          Какво <span class="text-brand">строим</span>.
        </h2>
      </Reveal>

      <ol class="us-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-900/10">
        {cards.map((s, i) => (
          <Reveal as="li" delay={i * 80} class="relative hover:z-[2]">
           <div class="us-card group h-full">
            <article id={s.slug} class="us-card__inner">
              <a href={s.photo.href} class="us-card__photo" aria-label={`Обект: ${s.photo.title}`}>
                <img
                  src={s.photo.src}
                  {...imageSize(s.photo.src)}
                  alt={s.photo.title}
                  loading="lazy"
                  decoding="async"
                />
                <span class="us-card__photo-cap">{s.photo.title}</span>
              </a>
              <header class="us-card__head">
                <span class="us-card__code" aria-hidden="true">{s.code} · {s.tag}</span>
                <span class="us-card__count font-display tabular-nums">
                  №{String(i + 1).padStart(2, '0')}
                </span>
              </header>

              <h3
                class="us-card__title font-display tracking-tight text-ink-950"
                style="font-size: clamp(1.3rem, 0.95rem + 0.85vw, 1.7rem); line-height: 1.08;"
              >
                {s.title}
              </h3>

              <span aria-hidden="true" class="us-card__hr"></span>

              <p class="us-card__summary text-[14.5px] md:text-[15px] text-ink-600 leading-[1.6]">
                {s.summary}
              </p>

              <details class="us-card__spec" open>
              <summary class="us-card__spec-toggle">
                <span>Обекти и обхват</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <section class="us-card__block">
                <p class="us-card__label">Обекти</p>
                <ul class="us-card__bul">
                  {s.segments.map((seg) => (
                    <li>{seg}</li>
                  ))}
                </ul>
              </section>

              <section class="us-card__block">
                <p class="us-card__label">Обхват</p>
                <ul class="us-card__check">
                  {s.scope.map((sc) => (
                    <li>
                      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                        <path d="M2 5.5l2.2 2.2L9 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span>{sc}</span>
                    </li>
                  ))}
                </ul>
              </section>
              </details>

              <footer class="us-card__foot">
                <a href={`/proekti?cat=${encodeURIComponent(s.refCat)}`} class="us-card__more">
                  <span>{objectsLabel(s.refCount)}</span>
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </footer>
            </article>
           </div>
          </Reveal>
        ))}
      </ol>
      <script is:inline>
        // Phones: object types and scope fold under one tap so six
        // full-width cards stay short. Runs during parse (no layout jump);
        // without JS every card stays open.
        // From 640px up the toggle is hidden, so a phone turned sideways
        // reopens every card instead of leaving the lists shut.
        (function () {
          var mq = window.matchMedia('(max-width: 639px)');
          var set = function () {
            document.querySelectorAll('details.us-card__spec').forEach(function (d) { d.open = !mq.matches; });
          };
          if (mq.matches) set();
          mq.addEventListener('change', set);
        })();
      </script>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       3 · CAPABILITY MATRIX — what we keep in-house vs partner.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-cream-100 border-y border-ink-900/[0.08] py-14 md:py-20" aria-labelledby="matrix-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>

    <div class="container-page relative">
      <div class="grid lg:grid-cols-12 gap-x-12 gap-y-6 md:gap-y-8 items-end">
        <Reveal class="lg:col-span-7">
          <h2
            id="matrix-heading"
            class="font-display tracking-tight text-ink-950"
            style="font-size: clamp(1.6rem, 1rem + 1.5vw, 2.3rem); line-height: 1.1;"
          >
            Обхват на <span class="text-brand">обекта</span>.
          </h2>
        </Reveal>
        <Reveal class="lg:col-span-5 lg:pb-1" delay={60}>
          <p class="max-w-md text-[15px] text-ink-600 leading-[1.65]">
            Строителните работи и специализираните дейности, които координираме по всеки обект.
          </p>
        </Reveal>

        <Reveal class="lg:col-span-12" delay={120}>
          <div class="grid md:grid-cols-2 gap-px bg-ink-900/12">
            <div class="bg-cream-100 p-6 md:p-7">
              <div class="flex items-baseline justify-between mb-5">
                <p class="text-xs uppercase tracking-eyebrow text-brand">Строителни работи</p>
                <span class="font-display text-ink-900/35 tabular-nums text-sm">
                  {String(inHouse.length).padStart(2, '0')}
                </span>
              </div>
              <ul class="grid lg:grid-cols-2 gap-x-6 gap-y-2.5">
                {inHouse.map((x) => (
                  <li class="us-matrix__row flex items-baseline gap-3 text-[14.5px] text-ink-950">
                    <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 rounded-full bg-brand shrink-0"></span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-cream-100 p-6 md:p-7">
              <div class="flex items-baseline justify-between mb-5">
                <p class="text-xs uppercase tracking-eyebrow text-ink-900/70">Проектиране и контрол</p>
                <span class="font-display text-ink-900/35 tabular-nums text-sm">
                  {String(partners.length).padStart(2, '0')}
                </span>
              </div>
              <ul class="grid lg:grid-cols-2 gap-x-6 gap-y-2.5">
                {partners.map((x) => (
                  <li class="us-matrix__row us-matrix__row--alt flex items-baseline gap-3 text-[14.5px] text-ink-600">
                    <span aria-hidden="true" class="mt-[5px] inline-block h-px w-3 bg-ink-900/40 shrink-0"></span>
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       4 · METHOD — compressed 4-step strip on dark.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-ink-950 text-white py-16 md:py-24" aria-labelledby="method-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-c opacity-[0.18]"></div>

    <div class="container-page relative">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-end mb-10 md:mb-14">
        <Reveal class="lg:col-span-7">
          <p class="eyebrow text-brand flex items-center gap-3">
            <span class="inline-block h-px w-10 bg-brand"></span>
            Метод
          </p>
          <h2
            id="method-heading"
            class="mt-4 font-display tracking-tight text-white max-w-[20ch]"
            style="font-size: clamp(1.85rem, 1rem + 2.2vw, 3rem); line-height: 1.05;"
          >
            Как <span class="text-brand">работим</span>.
          </h2>
        </Reveal>
        <Reveal class="lg:col-span-5 lg:pb-2" delay={120}>
          <p class="text-[15px] md:text-base text-white/70 leading-[1.65] max-w-[44ch]">
            Четири стъпки от първия оглед до Акт 16 и предаване на обекта. Всеки етап завършва с протокол, а накрая получавате пълната изпълнителна документация.
          </p>
        </Reveal>
      </div>

      <ol class="us-method grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/10">
        {method.map((m, i) => (
          <Reveal as="li" delay={i * 80}>
