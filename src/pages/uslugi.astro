  }

  /* ─── Hero & CTA backdrop drifts ────────────────────────── */
  .us-hero__backdrop {
    animation: us-backdrop-drift 28s ease-in-out infinite alternate;
    will-change: transform;
  }
  .us-cta__backdrop {
    animation: us-backdrop-drift-rev 32s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes us-backdrop-drift {
    0%   { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-2rem, -0.6rem, 0); }
  }
  @keyframes us-backdrop-drift-rev {
    0%   { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(1.8rem, 0.6rem, 0); }
  }

  /* ─── Hero index — per-row stagger entry ────────────────── */
  .us-index__list li {
    opacity: 0;
    transform: translateX(8px);
    animation: us-index-in 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .us-index__list li:nth-child(1) { animation-delay: 320ms; }
  .us-index__list li:nth-child(2) { animation-delay: 400ms; }
  .us-index__list li:nth-child(3) { animation-delay: 480ms; }
  .us-index__list li:nth-child(4) { animation-delay: 560ms; }
  .us-index__list li:nth-child(5) { animation-delay: 640ms; }
  .us-index__list li:nth-child(6) { animation-delay: 720ms; }
  @keyframes us-index-in {
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* ─── Reduced motion — strip transforms, keep opacity ───── */
  @media (prefers-reduced-motion: reduce) {
    .us-card,
    .us-card__hr,
    .us-index__row,
    .us-card__more,
    .us-index__arrow,
    .us-card__count,
    .us-card__code,
    .us-card__title,
    .us-matrix__row,
    .us-standards__cell,
    .us-standards__cell > span:first-child,
    .us-method__cell,
    .us-method__n,
    .us-method__step,
    .us-phone__cell,
    .us-stat > span[data-counter] {
      transition: none !important;
      animation: none !important;
    }
    .us-card:hover,
    .us-method__cell:hover,
    .us-standards__cell:hover .us-standards__cell > span:first-child {
      transform: none !important;
    }
    .us-card__hr { width: 2.5rem !important; }
    .us-card:hover .us-card__bul li::before { transform: none !important; }
    .us-hero__backdrop,
    .us-cta__backdrop {
      animation: none !important;
    }
    .us-index__list li {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  // ── Hero stats count-up — animates 0 → target on first intersection ──
  // Pattern mirrors /proekti.astro so the page feels coherent. The element
  // text is replaced each frame; if data-pad="2" is set, the value is
  // zero-padded to 2 digits (used by the "06" disciplines cell).
  const setupCounters = () => {
    const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
    if (!counters.length) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      counters.forEach((el) => {
        const t = parseInt(el.dataset.counter ?? '0', 10);
        const pad = parseInt(el.dataset.pad ?? '0', 10);
        el.textContent = pad ? String(t).padStart(pad, '0') : String(t);
      });
      return;
    }
    const ease = (t: number) => 1 - Math.pow(1 - t, 3); // ease-out cubic
    const animate = (el: HTMLElement, target: number, pad: number) => {
      const duration = 2400;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const v = Math.round(target * ease(progress));
        el.textContent = pad ? String(v).padStart(pad, '0') : String(v);
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.counter ?? '0', 10);
            const pad = parseInt(el.dataset.pad ?? '0', 10);
            animate(el, target, pad);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    counters.forEach((el) => io.observe(el));
  };

  setupCounters();
  document.addEventListener('astro:page-load', setupCounters);
</script>
