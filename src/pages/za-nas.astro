---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import CtaBand from '../components/CtaBand.astro';
import { imageSize } from '../data/assets';
import { company, yearsActive as getYearsActive, cprsGroupsLabel } from '../data/company';

// ────────────────────────────────────────────────────────────────
// За нас — editorial dossier of the firm.
// Dense like uslugi.astro: no oceans of whitespace, alternating
// cream/ink bands. Every section, the award included, aligns to
// container-page.
// ────────────────────────────────────────────────────────────────

const currentYear = new Date().getFullYear();
const yearsActive = getYearsActive();
const cprsLabel = cprsGroupsLabel();

// Firm-wide totals (company.ts), not the count of projects shown on the site.
const heroStats = [
  { label: 'Завършени обекта', short: 'Обекта', value: company.completedProjects },
  { label: 'Години опит', short: 'Години', value: company.yearsExperience },
];

// ── Award (Сграда на годината) — Chukara project feature.
const awardSlots = [
  { file: '/award/chukara/detail-1', width: 1600, height: 1068, alt: 'Вино и СПА хотел Чукара — фасада', caption: 'Естествен камък и дървени ламели' },
  { file: '/award/chukara/detail-2', width: 1600, height: 1068, alt: 'Вино и СПА хотел Чукара — общ изглед', caption: 'Планински хотелски ансамбъл' },
  { file: '/award/chukara/detail-3', width: 1600, height: 1200, alt: 'Вино и СПА хотел Чукара — интериор и екстериор', caption: 'Хотел, СПА и винена програма' },
];

// ── Certificates — sourced verbatim from /sert.html of legacy site ────
// Scans mirrored from the legacy host into public/sert/
// (scripts/fetch-legacy-assets.py). The ISO previews 1–3.webp are the
// first page of the valid PDFs 1–3.pdf (to 02.2027), not the old JPGs.
const isoStandards = [
  {
    code: 'ISO 9001:2015',
    title: 'Управление на качеството',
    img: '/sert/1.webp',
    pdf: '/sert/1.pdf',
  },
  {
    code: 'ISO 14001:2015',
    title: 'Околна среда',
    img: '/sert/2.webp',
    pdf: '/sert/2.pdf',
  },
  {
    code: 'ISO 45001:2018',
    title: 'Здраве и безопасност при работа',
    img: '/sert/3.webp',
    pdf: '/sert/3.pdf',
  },
];

// `body` is copied word for word from the scope line of each certificate
// (4–7.webp); nothing is added that the document does not say.
const cprsCards = [
  {
    roman: 'I',
    title: 'Първа група',
    body: 'Строежи от високото строителство, прилежащата му инфраструктура, електронни съобщителни мрежи и съоръжения.',
    img: '/sert/4.webp',
  },
  {
    roman: 'II',
    title: 'Втора група',
    body: 'Строежи от транспортната инфраструктура.',
    img: '/sert/5.webp',
  },
  {
    roman: 'III',
    title: 'Трета група',
    body: 'Строежи от енергийната инфраструктура.',
    img: '/sert/6.webp',
  },
  {
    roman: 'IV',
    title: 'Четвърта група',
    body: 'Строежи от благоустройствената инфраструктура, хидротехническото строителство и опазването на околната среда.',
    img: '/sert/7.webp',
  },
];

const declaration = {
  title: 'Декларация за целите и ангажиментите',
  body: 'Политиката на ръководството по качество, околна среда, здраве и безопасност при работа.',
  pdf: '/sert/doc07412420240403151358.pdf',
  img: '/sert/8.webp',
};

const pageTitle = `За нас — ${company.name}, строителна фирма от ${company.city}${
  company.founded !== null ? ` от ${company.founded} г.` : ''
}`;
const pageDescription = `${
  yearsActive !== null ? `${yearsActive} години строителство в Смолян и България.` : 'Строителство в Смолян и Родопите.'
} Изпълнител на обекта, отличен в конкурса „Сграда на годината“ 2022. Сертифицирани по ISO 9001, 14001 и 45001. Вписани в ЦПРС.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- ════════════════════════════════════════════════════════════
       1 · HERO — photo of the awarded Chukara hotel behind the whole
       hero (desktop) or behind the title band (phone). Title and
       numbers on the left, the firm's profile on the right over the
       photo. Phone order: photo + title → profile → numbers.
       ════════════════════════════════════════════════════════════ -->
  <section class="zn-hero relative isolate overflow-hidden bg-ink-950 text-white">
    <span aria-hidden="true" class="absolute inset-x-0 top-0 z-[1] h-[3px] bg-brand"></span>
    <!-- Shows only on the phone, below the photo band. -->
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-dark bp-sheet-c"></div>

    <div class="container-page zn-hero__grid">
      <!-- Title. On the phone this block holds the photo band; from lg up it
           is static, so the photo fills the whole section. -->
      <div class="zn-hero__intro">
        <div aria-hidden="true" class="zn-hero__media">
          <img
            src="/award/chukara/hero.jpg"
            width="1800"
            height="1048"
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="zn-hero__photo"
          />
          <span class="zn-hero__shade"></span>
        </div>
        <Reveal>
          <p class="eyebrow flex items-center gap-3 flex-wrap">
            <span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span>
            За нас{company.founded !== null && ` · ${company.founded} → ${currentYear}`}
          </p>
          <h1
            class="mt-5 md:mt-7 font-display tracking-tight leading-[0.95] text-white max-w-[22ch]"
            style="font-size: clamp(2.5rem, 1.25rem + 5vw, 6rem); letter-spacing: -0.025em;"
          >
            {yearsActive !== null ? `${yearsActive} години` : 'Строителна фирма'}
            <span class="block text-brand">
              {yearsActive !== null ? 'строителство в Смолян.' : 'от Смолян.'}
            </span>
          </h1>
          <p class="mt-6 md:mt-8 max-w-[54ch] text-base md:text-lg text-white/80 leading-[1.65]">
            {company.name} строи жилища, обществени сгради и инфраструктура в област Смолян и в други краища на България.{company.founded !== null && ` Работим от ${company.founded} г.`}
          </p>
        </Reveal>
      </div>

      <!-- Profile — over the photo on desktop, on the dark band on the phone -->
      <div class="zn-hero__aside">
        <Reveal delay={120}>
          <aside class="zn-dossier">
            <div class="border-b border-white/15 pb-3">
              <p class="text-xs uppercase tracking-eyebrow text-white/60">
                Профил
              </p>
            </div>

            <dl class="zn-dossier__list">
              <div class="zn-dossier__row">
                <dt>Седалище</dt>
                <dd>гр. {company.city} {company.postalCode} · {company.district}</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Адрес</dt>
                <dd>{company.street}</dd>
              </div>
              {company.founded !== null && (
                <div class="zn-dossier__row">
                  <dt>Учредяване</dt>
                  <dd>{company.founded} г.</dd>
                </div>
              )}
              <div class="zn-dossier__row">
                <dt>Регистър</dt>
                <dd>{cprsLabel ? `ЦПРС · ${cprsLabel}` : 'ЦПРС'}</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Стандарти</dt>
                <dd>ISO 9001 · 14001 · 45001</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Награда</dt>
                <dd>Сграда на годината</dd>
              </div>
            </dl>

            <a href="#nagrada" class="zn-dossier__cta">
              Вижте наградения обект
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </aside>
        </Reveal>
      </div>

      <!-- Numbers — firm-wide totals from company.ts -->
      <div class="zn-hero__stats">
        <Reveal delay={60}>
          <dl class="zn-stats">
            {heroStats.map((st) => (
              <div>
                <dt class="sr-only">{st.label}</dt>
                <dd class="zn-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(2rem, 1.2rem + 2vw, 3rem);">
                  <span data-counter={st.value}>{st.value}</span><span class="text-brand">+</span>
                </dd>
                <dd aria-hidden="true" class="mt-3 text-xs uppercase tracking-eyebrow text-white/70">{st.short}</dd>
              </div>
            ))}
          </dl>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       3 · AWARD — light editorial proof of recognition.
       ════════════════════════════════════════════════════════════ -->
  <section
    id="nagrada"
    class="zn-award relative isolate overflow-hidden bg-ink-950 text-white"
    aria-labelledby="award-heading"
  >
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-dark bp-sheet-b"></div>
    <img
      src="/award/chukara/hero.jpg"
      width="1800"
      height="1048"
      alt=""
      loading="lazy"
      decoding="async"
      aria-hidden="true"
      class="zn-award__wash"
    />

    <div class="container-page relative pt-16 md:pt-20 pb-16 md:pb-20">
      <div>
        <Reveal>
          <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Отличие</p>
        </Reveal>

        <div class="mt-8 md:mt-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
          <Reveal class="lg:col-span-5">
            <h2
              id="award-heading"
              class="font-display tracking-tight text-white"
              style="font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4.75rem); line-height: 0.95; letter-spacing: -0.025em;"
            >
              Сграда
              <span class="block text-brand">на годината.</span>
            </h2>
            <p class="mt-6 md:mt-8 max-w-[48ch] text-[15.5px] md:text-[16.5px] text-white/72 leading-[1.7]">
              {company.name} е изпълнител на „Вино и СПА хотел Чукара“. Обектът е отличен в Националния конкурс „Сграда на годината“ 2022.
            </p>
            <div class="zn-award__seal" aria-label="Сграда на годината 2022">
              <span>2022</span>
              <strong>Отличен обект</strong>
              <em>Ваканционни и СПА хотели</em>
            </div>
          </Reveal>

          <Reveal class="lg:col-span-7" delay={120}>
            <figure class="zn-award__hero">
              <img
                src="/award/chukara/hero.jpg"
                width="1800"
                height="1048"
                alt="Вино и СПА хотел Чукара, с. Кисийците, общ. Трявна"
                loading="lazy"
                decoding="async"
                class="zn-award__poster"
              />
              <figcaption class="zn-award__hero-caption">
                <span>Вино и СПА хотел Чукара</span>
              </figcaption>
            </figure>
          </Reveal>
        </div>

        <div class="mt-8 md:mt-10 grid grid-cols-2 lg:grid-cols-12 gap-px bg-white/12">
          <Reveal class="lg:col-span-3">
            <div class="zn-award__cell h-full">
            <p class="zn-award__label">Нашата роля</p>
            <p class="zn-award__value">{company.name}</p>
            </div>
          </Reveal>
          <Reveal class="lg:col-span-3" delay={60}>
            <div class="zn-award__cell h-full">
            <p class="zn-award__label">Отличие</p>
            <p class="zn-award__value">Сграда на годината</p>
            </div>
          </Reveal>
          <Reveal class="lg:col-span-3" delay={120}>
            <div class="zn-award__cell h-full">
            <p class="zn-award__label">Категория</p>
            <p class="zn-award__value">Ваканционни и СПА хотели</p>
            </div>
          </Reveal>
          <Reveal class="lg:col-span-3" delay={180}>
            <div class="zn-award__cell h-full">
            <p class="zn-award__label">Обект</p>
            <p class="zn-award__value">Вино и СПА хотел Чукара</p>
            </div>
          </Reveal>
        </div>

        <div class="mt-10 md:mt-14 grid lg:grid-cols-12 gap-8 lg:gap-10">
          <Reveal class="lg:col-span-4">
            <div class="zn-award__metrics">
              <div>
                <span class="zn-award__metric">57</span>
                <span class="zn-award__metric-label">стаи и апартаменти</span>
              </div>
              <div>
                <span class="zn-award__metric">123</span>
                <span class="zn-award__metric-label">места за настаняване</span>
              </div>
              <div>
                <span class="zn-award__metric">40 дка</span>
                <span class="zn-award__metric-label">комплекс с винопроизводство и туризъм</span>
              </div>
            </div>
          </Reveal>

          <Reveal class="lg:col-span-8" delay={120}>
            <ol class="zn-award__strip">
              {awardSlots.map((s, i) => (
                <li class="zn-award__slot group">
                  <figure class="zn-award__figure">
                    <img
                      src={`${s.file}-800.webp`}
                      srcset={`${s.file}-800.webp 800w, ${s.file}-1600.webp 1600w`}
                      sizes="(min-width: 1024px) min(38vw, 560px), (min-width: 768px) 56vw, 92vw"
                      width={s.width}
                      height={s.height}
                      alt={s.alt}
                      loading="lazy"
                      decoding="async"
                      class="zn-award__img"
                    />
                    <figcaption class="zn-award__caption">
                      <span class="text-[10.5px] uppercase tracking-eyebrow text-brand">0{i + 1}</span>
                      <span class="mt-1 block text-[13px] md:text-[13.5px] text-white">{s.caption}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ol>
          </Reveal>
        </div>

        <div class="zn-award__footer">
          <a href="https://www.buildingoftheyear.bg/bg/uchastnici/spa-2022/vino-i-spa-hotel-chukara" target="_blank" rel="noopener noreferrer" class="zn-award__link">
            Вижте проекта в конкурса
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       5 · CERTIFICATES — ISO row + ЦПРС groups + декларация.
       Dense grid, brand-monogram cards. Each cert is a spec page.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-cream-50 py-16 lg:py-20" aria-labelledby="certs-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>

    <div class="container-page relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-end mb-10 md:mb-14">
        <Reveal class="lg:col-span-7">
          <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Документи</p>
          <h2
            id="certs-heading"
            class="mt-3 font-display tracking-tight text-ink-950 max-w-[22ch]"
            style="font-size: clamp(1.85rem, 1rem + 2vw, 2.85rem); line-height: 1.05;"
          >
            Сертификати и
            <span class="text-brand">регистри</span>.
          </h2>
        </Reveal>
        <Reveal class="lg:col-span-5 lg:pb-2" delay={120}>
          <p class="text-[14.5px] md:text-[15px] text-ink-600 leading-[1.65] max-w-[46ch]">
            Работим по ISO 9001:2015, ISO 14001:2015 и ISO 45001:2018 и сме вписани в Централния професионален регистър на строителя. Копията на сертификатите и удостоверенията са по-долу.
          </p>
        </Reveal>
      </div>

      <!-- ISO row — three feature cards -->
      <ol class="zn-iso grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-900/12">
        {isoStandards.map((s, i) => (
          <Reveal as="li" delay={i * 80} class="relative hover:z-[2]">
           <div class="zn-iso__cell group h-full">
            <article class="zn-iso__inner">
              <header class="zn-iso__head">
                <span class="zn-iso__num font-display tabular-nums text-brand">
                  ISO
                </span>
                <span class="zn-iso__step">№{String(i + 1).padStart(2, '0')}</span>
              </header>
              <h3
                class="zn-iso__title font-display tracking-tight text-ink-950"
                style="font-size: clamp(1.25rem, 0.95rem + 0.75vw, 1.55rem); line-height: 1.1;"
              >
                {s.code}
              </h3>
              <p class="zn-iso__label">{s.title}</p>
              <span aria-hidden="true" class="zn-iso__hr"></span>

              <!-- Document thumbnail — legacy scan, replaced when clients
                   upload new versions -->
              <a class="zn-iso__doc group/doc" href={s.pdf} target="_blank" rel="noopener noreferrer">
                <span class="zn-iso__thumb">
                  <img src={s.img} {...imageSize(s.img)} alt={`Сертификат ${s.code}`} loading="lazy" decoding="async" />
                </span>
                <span class="zn-iso__doc-meta">
                  <span class="zn-iso__doc-label">Вижте сертификата</span>
                  <span class="zn-iso__doc-ext">PDF</span>
                </span>
                <svg class="zn-iso__doc-arrow" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
           </div>
          </Reveal>
        ))}
      </ol>

      <!-- ЦПРС groups row + declaration -->
      <div class="mt-10 md:mt-14">
        <Reveal class="mb-8 md:mb-10">
          <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-ink-900/15 pb-4">
            <h3
              class="font-display tracking-tight text-ink-950"
              style="font-size: clamp(1.15rem, 0.85rem + 0.85vw, 1.5rem); line-height: 1.15;"
            >
              ЦПРС · вписвания
            </h3>
            <p class="text-xs uppercase tracking-eyebrow text-ink-600">
              Централен професионален регистър на строителя
            </p>
          </div>
        </Reveal>

        <ol class="zn-cprs grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-px bg-ink-900/12">
          {cprsCards.map((g, i) => (
            <Reveal as="li" delay={i * 60}>
             <div class="zn-cprs__cell group h-full">
              <article class="zn-cprs__inner">
                <span class="zn-cprs__roman font-display text-brand">
                  {g.roman}
                </span>
                <h4 class="zn-cprs__title">{g.title}</h4>
                <p class="zn-cprs__body">{g.body}</p>
                <a class="zn-cprs__doc" href={g.img} target="_blank" rel="noopener noreferrer" aria-label={`Удостоверение ${g.title}`}>
                  <span class="zn-cprs__thumb">
                    <img src={g.img} {...imageSize(g.img)} alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="zn-cprs__doc-label">Удостоверение</span>
                  <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </article>
             </div>
            </Reveal>
          ))}

          <!-- Declaration as a 5th, distinct cell -->
          <Reveal as="li" delay={cprsCards.length * 60}>
           <div class="zn-cprs__cell zn-cprs__cell--alt group h-full">
            <article class="zn-cprs__inner">
              <span class="zn-cprs__roman font-display text-brand">
                §
              </span>
              <h4 class="zn-cprs__title">{declaration.title}</h4>
              <p class="zn-cprs__body">{declaration.body}</p>
              <a class="zn-cprs__doc" href={declaration.pdf} target="_blank" rel="noopener noreferrer" aria-label="Декларация PDF">
                <span class="zn-cprs__thumb">
                  <img src={declaration.img} {...imageSize(declaration.img)} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="zn-cprs__doc-label">Декларация · PDF</span>
                <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
           </div>
          </Reveal>
        </ol>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  /* ─── Anchor offset so hero "Виж наградата" jump lands below sticky header */
  #nagrada { scroll-margin-top: 6rem; }

  /* ════════ HERO ════════════════════════════════════════════════ */
  /* Phone: one column — photo band with the title, then the profile and
     the numbers on the dark section background. */
  .zn-hero { --zn-top: 7.5rem; }
  .zn-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'aside' 'stats';
    padding-top: var(--zn-top);
    padding-bottom: 3.5rem;
  }
  /* Tall photo band (≈ 5:4 of the screen width), title at its foot. */
  .zn-hero__intro {
    grid-area: intro;
    position: relative;
    display: flex;
