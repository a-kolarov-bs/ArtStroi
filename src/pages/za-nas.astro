---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { projects } from '../data/projects';

// ────────────────────────────────────────────────────────────────
// За нас — editorial dossier of the firm.
// Dense like uslugi.astro: no oceans of whitespace, alternating
// cream/ink bands, with ONE full-bleed section ("Сграда на годината")
// that breaks out of container-page on purpose.
// ────────────────────────────────────────────────────────────────

const FOUNDED = 1992;
const currentYear = new Date().getFullYear();
const yearsActive = currentYear - FOUNDED;
const totalProjects = projects.length;

// ── Award (Сграда на годината) — Chukara project feature.
const awardSlots = [
  { file: '/award/chukara/detail-1.jpg', alt: 'Вино и СПА хотел Чукара — фасада', caption: 'Естествен камък и дървени ламели' },
  { file: '/award/chukara/detail-2.jpg', alt: 'Вино и СПА хотел Чукара — общ изглед', caption: 'Планински хотелски ансамбъл' },
  { file: '/award/chukara/detail-3.jpg', alt: 'Вино и СПА хотел Чукара — интериор и екстериор', caption: 'Хотел, СПА и винена програма' },
];

// ── Certificates — sourced verbatim from /sert.html of legacy site ────
// Image URLs are absolute to the legacy host for now. When/if the client
// uploads scans we'll mirror them to /public/certs/.
const isoStandards = [
  {
    code: 'ISO 9001:2015',
    title: 'Управление на качеството',
    body: 'Сертифицирана система за управление на качеството — приложима за пълния обхват на строително-монтажните работи.',
    img: 'https://www.artstroismolian.com/sert/1.jpg',
    pdf: 'https://www.artstroismolian.com/sert/1.pdf',
  },
  {
    code: 'ISO 14001:2015',
    title: 'Околна среда',
    body: 'Управление по отношение на околната среда — намалено въздействие на строителния процес върху терена и общността.',
    img: 'https://www.artstroismolian.com/sert/2.jpg',
    pdf: 'https://www.artstroismolian.com/sert/2.pdf',
  },
  {
    code: 'ISO 45001:2018',
    title: 'Здраве и безопасност',
    body: 'Система за управление на здравето и безопасността при работа — оценен риск на всяко работно място на обекта.',
    img: 'https://www.artstroismolian.com/sert/3.jpg',
    pdf: 'https://www.artstroismolian.com/sert/3.pdf',
  },
];

const cprsGroups = [
  {
    roman: 'I',
    title: 'Първа група',
    body: 'Строежи от високото строителство и прилежащата му инфраструктура.',
    img: 'https://www.artstroismolian.com/sert/4.jpg',
  },
  {
    roman: 'II',
    title: 'Втора група',
    body: 'Строежи от транспортната инфраструктура — пътища, тротоари, площади.',
    img: 'https://www.artstroismolian.com/sert/5.jpg',
  },
  {
    roman: 'III',
    title: 'Трета група',
    body: 'Строежи от енергийната инфраструктура — електро, ВиК, външни мрежи.',
    img: 'https://www.artstroismolian.com/sert/6.jpg',
  },
  {
    roman: 'IV',
    title: 'Четвърта група',
    body: 'Строежи от благоустройствената инфраструктура — паркове, ВиК съоръжения.',
    img: 'https://www.artstroismolian.com/sert/7.jpg',
  },
];

const declaration = {
  title: 'Декларация за целите и ангажиментите',
  body: 'Политика на ръководството по качество, околна среда, здраве и безопасност при работа. Документът е публичен и неразделна част от интегрираната ни система.',
  pdf: 'https://www.artstroismolian.com/sert/doc07412420240403151358.pdf',
  img: 'https://www.artstroismolian.com/sert/8.jpg',
};

const pageTitle = 'За нас · АРТСТРОЙ ООД — строителна компания от Смолян от 1992';
const pageDescription =
  'Над 34 години строителство в Смолян и България. Носители на „Сграда на годината". Сертифицирани по ISO 9001/14001/45001. Вписани в ЦПРС.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- ════════════════════════════════════════════════════════════
       1 · HERO — dark editorial slab, compact and dense.
       Same vocabulary as /uslugi hero so the firm reads as one voice.
       ════════════════════════════════════════════════════════════ -->
  <section class="zn-hero relative isolate overflow-hidden bg-ink-950 text-white">
    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-brand"></span>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-c opacity-[0.16]"></div>

    <span
      aria-hidden="true"
      class="zn-hero__backdrop absolute -right-8 -bottom-14 select-none pointer-events-none font-display italic text-white/[0.045] leading-[0.78]"
      style="font-size: clamp(11rem, 22vw, 26rem); font-variation-settings:'opsz' 144,'SOFT' 100;"
    >
      1992
    </span>

    <div class="container-page relative pt-32 md:pt-36 lg:pt-40 pb-14 md:pb-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-end">
        <!-- LEFT — title -->
        <Reveal class="lg:col-span-7">
          <p class="eyebrow flex items-center gap-3 flex-wrap text-brand">
            <span class="inline-block h-px w-10 bg-brand"></span>
            За нас · 1992 → {currentYear}
          </p>
          <h1
            class="mt-5 md:mt-7 font-display tracking-tight leading-[0.95] text-white max-w-[22ch]"
            style="font-size: clamp(2.5rem, 1.25rem + 5vw, 6rem); letter-spacing: -0.025em;"
          >
            Тридесет и четири години
            <span class="italic block text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
              под един подпис.
            </span>
          </h1>
          <p class="mt-7 md:mt-9 max-w-[54ch] text-base md:text-lg text-white/70 leading-[1.65]">
            „АРТСТРОЙ" ООД работи в Смолян и Родопската област от 1992 г. Строим жилища, обществени сгради и инфраструктура — със собствени бригади, собствено оборудване и ясен контрол на изпълнението.
          </p>

          <!-- Tight inline stats — no separate band -->
          <dl class="zn-stats mt-9 md:mt-11 gap-x-6 gap-y-4 max-w-2xl border-t border-white/12 pt-6">
            <div>
              <dt class="sr-only">Години работа</dt>
              <dd class="zn-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.6rem, 1rem + 1.8vw, 2.5rem); font-variation-settings:'opsz' 144;">
                <span data-counter={yearsActive}>0</span><span class="text-brand">+</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">Години</p>
            </div>
            <div>
              <dt class="sr-only">Реализирани обекти</dt>
              <dd class="zn-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.6rem, 1rem + 1.8vw, 2.5rem); font-variation-settings:'opsz' 144;">
                <span data-counter={totalProjects}>0</span><span class="text-brand">+</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">Обекта</p>
            </div>
            <div>
              <dt class="sr-only">ЦПРС групи</dt>
              <dd class="zn-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.6rem, 1rem + 1.8vw, 2.5rem); font-variation-settings:'opsz' 144;">
                <span data-counter="4" data-pad="2">0</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">ЦПРС групи</p>
            </div>
            <div>
              <dt class="sr-only">ISO стандарта</dt>
              <dd class="zn-stat font-display text-white leading-[0.85] tabular-nums" style="font-size: clamp(1.6rem, 1rem + 1.8vw, 2.5rem); font-variation-settings:'opsz' 144;">
                <span data-counter="3" data-pad="2">0</span>
              </dd>
              <p class="mt-3 text-[10.5px] uppercase tracking-eyebrow text-white/55">ISO стандарта</p>
            </div>
          </dl>
        </Reveal>

        <!-- RIGHT — dossier card -->
        <Reveal class="lg:col-span-5" delay={120}>
          <aside class="zn-dossier">
            <div class="flex items-baseline justify-between border-b border-white/15 pb-3">
              <p class="text-[10.5px] uppercase tracking-eyebrow text-white/55">
                Профил · Стр.&nbsp;А
              </p>
              <p class="font-display italic text-white/55 text-sm tabular-nums" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                01 / 07
              </p>
            </div>

            <dl class="zn-dossier__list">
              <div class="zn-dossier__row">
                <dt>Седалище</dt>
                <dd>гр. Смолян 4700 · кв. Устово</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Адрес</dt>
                <dd>ул. „Хаджи Иван Бечев" №6</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Учредяване</dt>
                <dd>март 1992 г.</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Регистър</dt>
                <dd>ЦПРС · I · II · III · IV група</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Стандарти</dt>
                <dd>ISO 9001 · 14001 · 45001</dd>
              </div>
              <div class="zn-dossier__row">
                <dt>Награда</dt>
                <dd class="text-brand">Сграда на годината</dd>
              </div>
            </dl>

            <a href="#nagrada" class="zn-dossier__cta">
              Виж наградения обект
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </aside>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       3 · AWARD — light editorial proof of recognition.
       ════════════════════════════════════════════════════════════ -->
  <section
    id="nagrada"
    class="zn-award relative isolate overflow-hidden bg-ink-950 text-white"
    aria-labelledby="award-heading"
  >
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b opacity-[0.10]"></div>
    <img
      src="/award/chukara/hero.jpg"
      alt=""
      loading="lazy"
      decoding="async"
      aria-hidden="true"
      class="zn-award__wash"
    />

    <div class="relative px-5 md:px-10 pt-16 md:pt-24 pb-16 md:pb-22">
      <div class="mx-auto max-w-[92rem]">
        <Reveal>
          <div class="zn-award__kicker">
            <span class="inline-block h-px w-10 bg-brand"></span>
            <p class="eyebrow text-brand">Наше отличие · Национално признание</p>
          </div>
        </Reveal>

        <div class="mt-8 md:mt-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
          <Reveal class="lg:col-span-5">
            <p class="zn-award__category">Сграда на годината · 2022</p>
            <h2
              id="award-heading"
              class="mt-4 font-display tracking-tight text-white"
              style="font-size: clamp(3.4rem, 1.6rem + 6vw, 7.8rem); line-height: 0.9; letter-spacing: -0.03em;"
            >
              Сграда
              <span class="italic block text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">на годината.</span>
            </h2>
            <p class="mt-6 md:mt-8 max-w-[48ch] text-[15.5px] md:text-[16.5px] text-white/72 leading-[1.7]">
              „АРТСТРОЙ“ ООД е изпълнител на отличения проект „Вино и СПА хотел Чукара“ в Националния конкурс „Сграда на годината“ 2022. Това е признание за реално изпълнение, детайл и строителна дисциплина.
            </p>
            <div class="zn-award__seal" aria-label="Сграда на годината 2022">
              <span>2022</span>
              <strong>Отличен обект</strong>
              <em>Ваканционни и СПА хотели</em>
            </div>
          </Reveal>

          <Reveal class="lg:col-span-7" delay={120}>
            <figure class="zn-award__hero">
              <video
                class="zn-award__video"
                poster="/award/chukara/hero.jpg"
                src="/award/chukara/drone.mp4"
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="Въздушен обход на Вино и СПА хотел Чукара"
              ></video>
              <img
                src="/award/chukara/hero.jpg"
                alt="Вино и СПА хотел Чукара, гр. Трявна"
                loading="lazy"
                decoding="async"
                class="zn-award__poster"
              />
              <figcaption class="zn-award__hero-caption">
                <span>Вино и СПА хотел Чукара</span>
                <span>Тук ще бъде поставен drone клипът</span>
              </figcaption>
            </figure>
          </Reveal>
        </div>

        <div class="mt-8 md:mt-10 grid lg:grid-cols-12 gap-px bg-white/12">
          <Reveal class="zn-award__cell lg:col-span-3">
            <p class="zn-award__label">Нашата роля</p>
            <p class="zn-award__value">Артстрой ООД</p>
          </Reveal>
          <Reveal class="zn-award__cell lg:col-span-3" delay={60}>
            <p class="zn-award__label">Отличие</p>
            <p class="zn-award__value">Сграда на годината</p>
          </Reveal>
          <Reveal class="zn-award__cell lg:col-span-3" delay={120}>
            <p class="zn-award__label">Категория</p>
            <p class="zn-award__value">Ваканционни и СПА хотели</p>
          </Reveal>
          <Reveal class="zn-award__cell lg:col-span-3" delay={180}>
            <p class="zn-award__label">Обект</p>
            <p class="zn-award__value">Вино и СПА хотел Чукара</p>
          </Reveal>
        </div>

        <div class="mt-10 md:mt-14 grid lg:grid-cols-12 gap-8 lg:gap-10">
          <Reveal class="lg:col-span-4">
            <div class="zn-award__metrics">
              <div>
                <span class="zn-award__metric">57</span>
                <span class="zn-award__metric-label">стаи и апартаменти</span>
              </div>
              <div>
                <span class="zn-award__metric">123</span>
                <span class="zn-award__metric-label">места за настаняване</span>
              </div>
              <div>
                <span class="zn-award__metric">40 дка</span>
                <span class="zn-award__metric-label">комплекс с винопроизводство и туризъм</span>
              </div>
            </div>
          </Reveal>

          <Reveal class="lg:col-span-8" delay={120}>
            <ol class="zn-award__strip">
              {awardSlots.map((s, i) => (
                <li class="zn-award__slot group">
                  <figure class="zn-award__figure">
                    <img src={s.file} alt={s.alt} loading="lazy" decoding="async" class="zn-award__img" />
                    <figcaption class="zn-award__caption">
                      <span class="text-[10.5px] uppercase tracking-eyebrow text-brand">0{i + 1}</span>
                      <span class="mt-1 block text-[13px] md:text-[13.5px] text-white">{s.caption}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ol>
          </Reveal>
        </div>

        <div class="zn-award__footer">
          <p>
            Отличието е в категория „Ваканционни и СПА хотели“ на Национален конкурс „Сграда на годината“ 2022.
          </p>
          <a href="https://www.buildingoftheyear.bg/bg/uchastnici/spa-2022/vino-i-spa-hotel-chukara" target="_blank" rel="noopener noreferrer" class="zn-award__link">
            Виж проекта в конкурса
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       5 · CERTIFICATES — ISO row + ЦПРС groups + декларация.
       Dense grid, brand-monogram cards. Each cert is a spec page.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative isolate overflow-hidden bg-cream-50 pt-16 md:pt-24 pb-4 md:pb-6" aria-labelledby="certs-heading">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>

    <div class="container-page relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-end mb-10 md:mb-14">
        <Reveal class="lg:col-span-7">
          <p class="eyebrow">Сертификати · Регистри</p>
          <h2
            id="certs-heading"
            class="mt-3 font-display tracking-tight text-ink-950 max-w-[22ch]"
            style="font-size: clamp(1.85rem, 1rem + 2vw, 2.85rem); line-height: 1.05;"
          >
            Документи под
            <span class="italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">подпис</span>.
          </h2>
        </Reveal>
        <Reveal class="lg:col-span-5 lg:pb-2" delay={120}>
          <p class="text-[14.5px] md:text-[15px] text-ink-600 leading-[1.65] max-w-[46ch]">
            Системата ни за управление на качеството, околната среда, здравето и безопасността при работа е изградена в съответствие с международните стандарти ISO и е валидирана от независим орган. Всички сертификати са актуални и налични за инспекция.
          </p>
        </Reveal>
      </div>

      <!-- ISO row — three feature cards -->
      <ol class="zn-iso grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-900/12">
        {isoStandards.map((s, i) => (
          <Reveal as="li" delay={i * 80} class="zn-iso__cell group">
            <article class="zn-iso__inner">
              <header class="zn-iso__head">
                <span class="zn-iso__num font-display italic tabular-nums text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                  ISO
                </span>
                <span class="zn-iso__step">№{String(i + 1).padStart(2, '0')}</span>
              </header>
              <h3
                class="zn-iso__title font-display tracking-tight text-ink-950"
                style="font-size: clamp(1.25rem, 0.95rem + 0.75vw, 1.55rem); line-height: 1.1;"
              >
                {s.code}
              </h3>
              <p class="zn-iso__label">{s.title}</p>
              <span aria-hidden="true" class="zn-iso__hr"></span>
              <p class="zn-iso__body">{s.body}</p>

              <!-- Document thumbnail — legacy scan, replaced when clients
                   upload new versions -->
              <a class="zn-iso__doc group/doc" href={s.pdf} target="_blank" rel="noopener noreferrer">
                <span class="zn-iso__thumb">
                  <img src={s.img} alt={`Сертификат ${s.code}`} loading="lazy" decoding="async" />
                </span>
                <span class="zn-iso__doc-meta">
                  <span class="zn-iso__doc-label">Виж сертификата</span>
                  <span class="zn-iso__doc-ext">PDF</span>
                </span>
                <svg class="zn-iso__doc-arrow" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          </Reveal>
        ))}
      </ol>

      <!-- ЦПРС groups row + declaration -->
      <div class="mt-10 md:mt-14">
        <Reveal class="mb-8 md:mb-10">
          <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-ink-900/15 pb-4">
            <h3
              class="font-display tracking-tight text-ink-950"
              style="font-size: clamp(1.15rem, 0.85rem + 0.85vw, 1.5rem); line-height: 1.15;"
            >
              ЦПРС · вписвания
            </h3>
            <p class="text-[11.5px] uppercase tracking-eyebrow text-ink-600">
              Централен професионален регистър на строителя
            </p>
          </div>
        </Reveal>

        <ol class="zn-cprs grid grid-cols-2 lg:grid-cols-5 gap-px bg-ink-900/12">
          {cprsGroups.map((g, i) => (
            <Reveal as="li" delay={i * 60} class="zn-cprs__cell group">
              <article class="zn-cprs__inner">
                <span class="zn-cprs__roman font-display italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                  {g.roman}
                </span>
                <h4 class="zn-cprs__title">{g.title}</h4>
                <p class="zn-cprs__body">{g.body}</p>
                <a class="zn-cprs__doc" href={g.img} target="_blank" rel="noopener noreferrer" aria-label={`Удостоверение ${g.title}`}>
                  <span class="zn-cprs__thumb">
                    <img src={g.img} alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="zn-cprs__doc-label">Удостоверение</span>
                  <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </article>
            </Reveal>
          ))}

          <!-- Declaration as a 5th, distinct cell -->
          <Reveal as="li" delay={cprsGroups.length * 60} class="zn-cprs__cell zn-cprs__cell--alt group">
