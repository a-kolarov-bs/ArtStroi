<script>
  // ── Stats count-up — pattern shared with /uslugi & /proekti ──
  const setupCounters = () => {
    const counters = document.querySelectorAll<HTMLElement>('.zn-stat [data-counter]');
    if (!counters.length) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      counters.forEach((el) => {
        const t = parseInt(el.dataset.counter ?? '0', 10);
        const pad = parseInt(el.dataset.pad ?? '0', 10);
        el.textContent = pad ? String(t).padStart(pad, '0') : String(t);
      });
      return;
    }
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const animate = (el: HTMLElement, target: number, pad: number) => {
      const duration = 2400;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const v = Math.round(target * ease(progress));
        el.textContent = pad ? String(v).padStart(pad, '0') : String(v);
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.counter ?? '0', 10);
            const pad = parseInt(el.dataset.pad ?? '0', 10);
            animate(el, target, pad);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    counters.forEach((el) => io.observe(el));
  };

  setupCounters();
  document.addEventListener('astro:page-load', setupCounters);
</script>
