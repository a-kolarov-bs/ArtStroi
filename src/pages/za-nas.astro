              <span class="zn-cprs__roman font-display italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">
                §
              </span>
              <h4 class="zn-cprs__title">{declaration.title}</h4>
              <p class="zn-cprs__body">{declaration.body}</p>
              <a class="zn-cprs__doc" href={declaration.pdf} target="_blank" rel="noopener noreferrer" aria-label="Декларация PDF">
                <span class="zn-cprs__thumb">
                  <img src={declaration.img} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="zn-cprs__doc-label">Декларация · PDF</span>
                <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          </Reveal>
        </ol>
      </div>
    </div>
  </section>

