---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { company, fullAddress, mapQuery as officeMapQuery, phone, telHref } from '../data/company';

const mapQuery = encodeURIComponent(officeMapQuery);
const manager = phone('Управител');
const otherPhones = company.phones.filter((p) => p.role !== manager.role);
---

<BaseLayout
  title={`Контакти — ${company.name}, ${company.city}`}
  description={`Контакти на ${company.name}: телефони, имейл и офис в ${fullAddress}.`}
  solidHeader
>
  <section class="contact-page relative isolate overflow-hidden bg-cream-50 text-ink-950">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-c"></div>
    <span aria-hidden="true" class="contact-page__mark">4700</span>

    <div class="container-page relative pt-32 md:pt-36 lg:pt-40 pb-16 md:pb-24">
      <Reveal>
        <div class="contact-hero">
          <div>
            <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Контакти · Смолян</p>
            <h1>Пишете ни</h1>
          </div>
          <p class="contact-hero__text">
            Кажете ни какъв е обектът, къде се намира и какво трябва да се направи.
            Най-бързо е по телефона. Чертежи и снимки пратете по имейл.
          </p>
        </div>
      </Reveal>

      <div class="contact-layout mt-11 md:mt-14">
        <Reveal class="min-w-0 min-[1180px]:col-start-2 min-[1180px]:row-start-1">
          <section class="contact-call" aria-labelledby="contact-call-heading">
            <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Телефони</p>
            <h2 id="contact-call-heading">Обадете се</h2>

            <div class="contact-call__body">
              <a class="contact-call__lead" href={telHref(manager.number)}>
                <span class="contact-call__role">{manager.role}</span>
                <span class="contact-call__number">{manager.number}</span>
                <span class="contact-call__hours">{company.hoursDays} {company.hoursTime}</span>
                <svg class="contact-call__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5.2 3.5h3.1l1.6 4.1-2.1 1.3a11.4 11.4 0 0 0 7.3 7.3l1.3-2.1 4.1 1.6v3.1a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </a>

              <ul class="contact-call__list">
                {otherPhones.map((p) => (
                  <li>
                    <span>{p.role}</span>
                    <a href={telHref(p.number)}>{p.number}</a>
                  </li>
                ))}
                <li>
                  <span>Имейл</span>
                  <a href={`mailto:${company.email}`}>{company.email}</a>
                </li>
              </ul>
            </div>
          </section>
        </Reveal>

        <Reveal class="min-w-0 min-[1180px]:col-start-1 min-[1180px]:row-start-1 min-[1180px]:row-span-2">
          <section class="contact-form-panel" aria-labelledby="contact-form-heading">
            <div class="contact-form-panel__head">
              <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Съобщение</p>
              <h2 id="contact-form-heading">Пишете ни.</h2>
              <p>
                Формата подготвя писмо до нас във вашата поща. Чертежи и снимки добавете
                като прикачени файлове. Полетата със <span class="text-brand">*</span> са задължителни.
              </p>
            </div>

            <form class="contact-form" data-contact-form data-mailto={company.email} novalidate>
              <div class="contact-field">
                <label for="first-name">Име</label>
                <input id="first-name" name="firstName" type="text" autocomplete="given-name" placeholder="Иван" />
              </div>

              <div class="contact-field">
                <label for="last-name">Фамилия</label>
                <input id="last-name" name="lastName" type="text" autocomplete="family-name" placeholder="Петров" />
              </div>

              <div class="contact-field">
                <label for="phone">Телефон</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+359 …" />
              </div>

              <div class="contact-field">
                <label for="email">Имейл</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  aria-describedby="email-error"
                  placeholder="ime@primer.bg"
                />
                <span class="contact-error" id="email-error" data-error-for="email"></span>
              </div>

              <div class="contact-field contact-field--wide">
                <label for="message">Текст <span class="contact-field__req" aria-hidden="true">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  rows="7"
                  aria-describedby="message-error"
                  placeholder="Вашият въпрос или съобщение"
                  required
                  minlength="10"
                ></textarea>
                <span class="contact-error" id="message-error" data-error-for="message"></span>
              </div>

              <div class="contact-form__footer" data-surface="dark">
                <button type="submit" class="btn-brand shrink-0">
                  Изпратете съобщение
                  <span aria-hidden="true">↗</span>
                </button>
                <div class="contact-form__hint">
                  <p data-contact-status aria-live="polite">Ще се отвори вашата поща с готово писмо.</p>
                  <p class="contact-form__copy">
                    Ако пощата не се отвори, пишете ни на
                    <span class="contact-form__mail">{company.email}</span>.
                  </p>
                  <button type="button" class="contact-copy" data-copy-email={company.email}>
                    <span data-copy-label aria-live="polite">Копирайте адреса</span>
                  </button>
                </div>
              </div>
            </form>
          </section>
        </Reveal>

        <Reveal delay={120} class="min-w-0 min-[1180px]:col-start-2 min-[1180px]:row-start-2">
          <section class="contact-office" aria-labelledby="contact-office-heading">
            <p class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Офис</p>
            <h2 id="contact-office-heading">{company.district}, {company.city}</h2>

            <address>
              {company.street}<br />
              {company.district}<br />
              гр. {company.city} {company.postalCode}
            </address>

            <a
              class="contact-map-link"
              href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Отворете в Google Maps
              <span aria-hidden="true">↗</span>
            </a>
          </section>
        </Reveal>

        <Reveal class="min-w-0 min-[1180px]:col-span-2 min-[1180px]:row-start-3">
          <div class="contact-map">
            <iframe
              title={`Карта: ${company.name}, офис ${company.city}`}
              src={`https://maps.google.com/maps?q=${mapQuery}&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <span aria-hidden="true" class="contact-map__wash"></span>
          </div>
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    min-height: 100svh;
  }

  .contact-page__mark {
    position: absolute;
    top: 5.8rem;
    right: -0.08em;
    z-index: -1;
    color: rgba(18, 22, 28, 0.04);
    font-family: var(--font-display);
    font-size: clamp(9rem, 24vw, 24rem);
    line-height: 0.8;
    pointer-events: none;
  }

  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 0.48fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
  }

  .contact-hero h1 {
    margin-top: 1rem;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 1.9rem + 4vw, 5.9rem);
    line-height: 0.94;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .contact-hero__text {
    margin-bottom: 0.9rem;
    max-width: 34rem;
    border-left: 2px solid #ba2d20;
    padding-left: 1.35rem;
    color: rgba(18, 22, 28, 0.68);
    font-size: clamp(1rem, 0.92rem + 0.28vw, 1.14rem);
    line-height: 1.72;
  }

  /* Phones first in the DOM (and on narrow screens); from 1180px the form
     takes the left column and the phones sit top right, above the fold. */
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1180px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(21rem, 0.56fr);
      grid-template-rows: auto 1fr auto;
      column-gap: clamp(1.25rem, 3.8vw, 4.5rem);
    }
  }

  .contact-call,
  .contact-form-panel,
  .contact-office {
    border-top: 1px solid rgba(18, 22, 28, 0.16);
    padding-top: 1.4rem;
  }

  .contact-call h2,
  .contact-office h2 {
    margin-top: 0.7rem;
    color: #15191f;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 1.3vw, 2.3rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  /* ── Phones ─────────────────────────────────────────────────────── */
  .contact-call__body {
    display: grid;
    gap: 1rem;
    margin-top: 1.15rem;
  }

  @media (min-width: 720px) and (max-width: 1179px) {
    .contact-call__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }

  .contact-call__lead {
    position: relative;
    display: grid;
    gap: 0.4rem;
    border-radius: 0.75rem;
    background: #15191f;
    padding: 1.1rem 4.25rem 1.15rem 1.25rem;
    color: #fff;
    box-shadow: 0 18px 40px -24px rgba(18, 22, 28, 0.55);
    transition:
      background-color 400ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-call__lead:hover {
    background: #ba2d20;
    transform: translateY(-2px);
  }

  .contact-call__role {
    color: rgba(255, 251, 244, 0.7);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-call__number {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.25rem + 1vw, 2.05rem);
    line-height: 1.1;
    -webkit-text-stroke: 0.025em currentColor;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .contact-call__hours {
    color: rgba(255, 251, 244, 0.6);
    font-size: 0.82rem;
  }

  .contact-call__icon {
    position: absolute;
    top: 50%;
    right: 1.1rem;
    box-sizing: content-box;
    padding: 0.6rem;
    border-radius: 999px;
    background: #ba2d20;
    transform: translateY(-50%);
    transition: background-color 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-call__lead:hover .contact-call__icon {
    background: #8f1f15;
  }

  .contact-call__list li {
    display: flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(18, 22, 28, 0.12);
  }

  .contact-call__list li:first-child {
    border-top: 1px solid rgba(18, 22, 28, 0.12);
  }

  @media (min-width: 720px) and (max-width: 1179px) {
    .contact-call__list li:first-child {
      border-top: 0;
    }
  }

  .contact-call__list span {
    color: rgba(18, 22, 28, 0.6);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-call__list a {
    color: #15191f;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: rgba(186, 45, 32, 0.45);
    text-underline-offset: 5px;
    transition: color 220ms ease, text-decoration-color 220ms ease;
  }

  .contact-call__list a:hover {
    color: #ba2d20;
    text-decoration-color: #ba2d20;
  }

  /* ── Form ───────────────────────────────────────────────────────── */
  .contact-form-panel__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.52fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 0.7rem;
    align-items: end;
  }

  .contact-form-panel__head > * {
    min-width: 0;
  }

  .contact-form-panel__head .eyebrow {
    grid-column: 1 / -1;
  }

  .contact-form-panel__head h2 {
    max-width: 12ch;
    color: #15191f;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 2.5vw, 4rem);
    line-height: 0.95;
  }

  .contact-form-panel__head p:not(.eyebrow) {
    color: rgba(18, 22, 28, 0.66);
    font-size: 0.96rem;
    line-height: 1.64;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.5rem;
    max-width: 100%;
    min-width: 0;
    background: rgba(18, 22, 28, 0.14);
    border: 1px solid rgba(18, 22, 28, 0.14);
  }

  .contact-field {
    display: grid;
    align-content: start;
    min-height: 6.6rem;
    background: rgba(255, 251, 244, 0.76);
    padding: 1rem 1.05rem 0.9rem;
    transition: background-color 260ms ease;
  }

  .contact-field--wide {
    grid-column: 1 / -1;
    min-height: 14rem;
  }

  .contact-field label {
    color: #ba2d20;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .contact-field__req {
    margin-left: 0.15rem;
    letter-spacing: 0;
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    min-width: 0;
    border: 0;
    border-bottom: 1px solid rgba(26, 31, 38, 0.25);
    border-radius: 0;
    outline: 0;
    background: transparent;
    color: #15191f;
    font: inherit;
    line-height: 1.45;
    padding: 0 0 0.35rem;
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: rgba(18, 22, 28, 0.34);
    opacity: 1;
  }

  .contact-field input {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.8rem);
  }

  .contact-field textarea {
    min-height: 9.5rem;
    margin-top: 0.9rem;
    resize: vertical;
    font-size: 1rem;
  }

  /* Focus: 2px red line under the input and a lighter cell. */
  .contact-field input:focus,
  .contact-field textarea:focus {
    border-bottom-color: #ba2d20;
    box-shadow: 0 1px 0 #ba2d20;
  }

  .contact-field:focus-within {
    background: #fffdf9;
  }

  /* The input itself has no outline; the whole field carries the ring. */
  .contact-field:has(:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .contact-field:has([aria-invalid="true"]) {
    background: rgba(186, 45, 32, 0.08);
  }

  .contact-error {
    min-height: 1.1rem;
    margin-top: 0.35rem;
    color: #9c241b;
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .contact-form__footer {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem 1.5rem;
    background: #15191f;
    padding: 1.1rem 1rem 1.15rem 1.15rem;
    color: rgba(255, 251, 244, 0.72);
  }

  .contact-form__footer > button {
    grid-column: 2;
    grid-row: 1;
  }

  .contact-form__hint {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .contact-form__hint p:first-child {
    color: #fff;
  }

  .contact-form__mail {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .contact-copy {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    margin-top: 0.15rem;
    border: 1px solid rgba(255, 251, 244, 0.3);
    border-radius: 999px;
    padding: 0 0.95rem;
    color: #fff;
    font-size: 0.82rem;
    transition: background-color 220ms ease, border-color 220ms ease;
  }

  .contact-copy:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 251, 244, 0.6);
  }

  .contact-copy[data-copied='true'] {
    border-color: #ba2d20;
    background: rgba(186, 45, 32, 0.25);
  }

  /* ── Office and map ─────────────────────────────────────────────── */
  .contact-office address {
    margin-top: 0.9rem;
    color: rgba(18, 22, 28, 0.74);
    font-style: normal;
    font-size: 0.97rem;
    line-height: 1.58;
  }

  .contact-map-link {
    margin-top: 0.9rem;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: #15191f;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 220ms ease, gap 220ms ease;
  }

  .contact-map-link:hover {
    color: #ba2d20;
    gap: 0.75rem;
  }

  .contact-map {
    position: relative;
    height: clamp(16rem, 26vw, 22rem);
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 18px 44px -22px rgba(18, 22, 28, 0.28);
    outline: 1px solid rgba(18, 22, 28, 0.10);
    outline-offset: -1px;
    background: rgba(18, 22, 28, 0.08);
  }

  .contact-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(1.05) contrast(1.02);
    transition: filter 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-map:hover iframe {
    filter: saturate(1.15) contrast(1.04);
  }

  .contact-map__wash {
    position: absolute;
    inset: 0 0 auto;
    height: 4rem;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(18, 22, 28, 0.22), rgba(18, 22, 28, 0.06), transparent);
  }

  @media (max-width: 900px) {
    .contact-hero,
    .contact-form-panel__head {
      grid-template-columns: 1fr;
    }

    .contact-hero__text {
      margin-bottom: 0;
    }
  }

  @media (max-width: 767px) {
    .contact-page .container-page {
      padding-left: 1.125rem;
      padding-right: 1.125rem;
    }

    .contact-page__mark {
      top: 7rem;
      right: 0;
      font-size: 8.5rem;
    }

    .contact-hero h1 {
      max-width: none;
      font-size: clamp(2.05rem, 9.5vw, 3.1rem);
      white-space: normal;
    }

    .contact-hero__text {
      padding-left: 1rem;
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .contact-layout {
      row-gap: 2rem;
    }

    .contact-form {
      grid-template-columns: 1fr;
    }

    .contact-field,
    .contact-field--wide {
      min-height: auto;
    }

    .contact-form__footer {
      grid-template-columns: 1fr;
    }

    .contact-form__footer > button {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }

    .contact-form__hint {
      grid-row: 2;
    }

    .contact-map {
      height: 17rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-call__lead,
    .contact-call__lead:hover {
      transform: none;
      transition: none;
    }
  }
</style>


<script>
  const initContactForms = () => {
    const forms = document.querySelectorAll('[data-contact-form]');

    forms.forEach((form) => {
      if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') return;
      form.dataset.ready = 'true';

      const status = form.querySelector('[data-contact-status]');
      const emailInput = form.elements.namedItem('email');
      const messageInput = form.elements.namedItem('message');
      const firstNameInput = form.elements.namedItem('firstName');
      const lastNameInput = form.elements.namedItem('lastName');
      const phoneInput = form.elements.namedItem('phone');

      const getValue = (field: Element | RadioNodeList | null) => field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement
        ? field.value.trim()
        : '';

      const setError = (fieldName: string, message: string) => {
        const field = form.elements.namedItem(fieldName);
        const error = form.querySelector(`[data-error-for="${fieldName}"]`);

        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
          field.setAttribute('aria-invalid', message ? 'true' : 'false');
        }

        if (error) {
          error.textContent = message;
        }
      };

      const clearError = (event: Event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) {
          setError(target.name, '');
        }
      };

      form.addEventListener('input', clearError);

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const email = getValue(emailInput);
        const message = getValue(messageInput);
        // Optional: the letter leaves from the visitor's own mailbox, so the
        // address is only checked when someone types one.
        const emailIsValid = email === '' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        let hasError = false;

        setError('email', '');
        setError('message', '');

        if (!emailIsValid) {
          setError('email', 'Въведете валиден имейл адрес.');
          hasError = true;
        }

        if (message.length < 10) {
          setError('message', 'Добавете поне няколко думи за обекта или въпроса.');
          hasError = true;
        }

        if (hasError) {
          if (status) status.textContent = 'Поправете полетата в червено и опитайте пак.';
          return;
        }

        const firstName = getValue(firstNameInput);
        const lastName = getValue(lastNameInput);
        const phone = getValue(phoneInput);
        const subjectName = [firstName, lastName].filter(Boolean).join(' ') || 'сайт';
        const subject = `Съобщение от ${subjectName}`;
        const body = [
          `Име: ${[firstName, lastName].filter(Boolean).join(' ') || '-'}`,
          `Телефон: ${phone || '-'}`,
          `Имейл: ${email || '-'}`,
          '',
          'Текст:',
          message,
        ].join('\n');

        if (status) status.textContent = 'Отваряме вашата поща с готовото писмо.';
        window.location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    });
  };

  // „Копирайте адреса“: for visitors whose browser has no mail app set up.
  const initCopyEmail = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      if (button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';

      const label = button.querySelector('[data-copy-label]');
      const initial = label?.textContent ?? '';
      let timer = 0;

      button.addEventListener('click', async () => {
        const value = button.dataset.copyEmail ?? '';
        let copied = false;
        try {
          await navigator.clipboard.writeText(value);
          copied = true;
        } catch {
          // No clipboard access: select the address so it can be copied by hand.
          const mail = button.parentElement?.querySelector('.contact-form__mail');
          if (mail) window.getSelection()?.selectAllChildren(mail);
        }

        button.dataset.copied = copied ? 'true' : 'false';
        if (label) label.textContent = copied ? 'Адресът е копиран' : 'Адресът е маркиран';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.dataset.copied = 'false';
          if (label) label.textContent = initial;
        }, 2600);
      });
    });
  };

  const init = () => {
    initContactForms();
    initCopyEmail();
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
