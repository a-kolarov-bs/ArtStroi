---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';

const officeAddress = 'Промишлена зона Бяла река, ул. „Хаджи Иван Бечев“ 6, Смолян, България';
const mapQuery = encodeURIComponent(officeAddress);
---

<BaseLayout
  title="Контакти — АРТСТРОЙ ООД"
  description="Контакти на АРТСТРОЙ ООД, Смолян. Офис на ул. „Хаджи Иван Бечев“ 6, Промишлена зона Бяла река."
  solidHeader
>
  <section class="contact-page relative isolate overflow-hidden bg-cream-50 text-ink-950">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-c opacity-[0.24]"></div>
    <span aria-hidden="true" class="contact-page__mark">4700</span>

    <div class="container-page relative pt-32 md:pt-36 lg:pt-40 pb-16 md:pb-24">
      <Reveal>
        <div class="contact-hero">
          <div>
            <p class="eyebrow">Контакти · Смолян</p>
            <h1>Пишете ни</h1>
          </div>
          <p class="contact-hero__text">
            Без формалности. Кажете ни какъв е обектът, къде се намира и какво искате да
            се случи. Ще върнем отговор с най-смислената следваща стъпка.
          </p>
        </div>
      </Reveal>

      <div class="contact-layout mt-11 md:mt-14">
        <Reveal>
          <section class="contact-form-panel" aria-labelledby="contact-form-heading">
            <div class="contact-form-panel__head">
              <p class="eyebrow">Запитване</p>
              <h2 id="contact-form-heading">Разкажете ни накратко.</h2>
              <p>
                Формата подготвя имейл към нас. Ако имате чертежи или снимки, добавете ги
                като прикачени файлове след отваряне на имейла.
              </p>
            </div>

            <form class="contact-form" data-contact-form novalidate>
              <div class="contact-field">
                <label for="first-name">Име</label>
                <input id="first-name" name="firstName" type="text" autocomplete="given-name" />
              </div>

              <div class="contact-field">
                <label for="last-name">Фамилия</label>
                <input id="last-name" name="lastName" type="text" autocomplete="family-name" />
              </div>

              <div class="contact-field">
                <label for="phone">Тел. номер</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
              </div>

              <div class="contact-field">
                <label for="email">Имейл</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  aria-describedby="email-error"
                  required
                />
                <span class="contact-error" id="email-error" data-error-for="email"></span>
              </div>

              <div class="contact-field contact-field--wide">
                <label for="message">Текст</label>
                <textarea
                  id="message"
                  name="message"
                  rows="7"
                  aria-describedby="message-error"
                  required
                  minlength="10"
                ></textarea>
                <span class="contact-error" id="message-error" data-error-for="message"></span>
              </div>

              <div class="contact-form__footer">
                <p data-contact-status aria-live="polite">
                  Проверяваме имейла и текста преди изпращане.
                </p>
                <button type="submit">
                  Изпрати имейл
                  <span aria-hidden="true">↗</span>
                </button>
              </div>
            </form>
          </section>
        </Reveal>

        <Reveal delay={120}>
          <aside class="contact-side" aria-label="Данни за контакт">
            <div class="contact-office">
              <div class="contact-office__head">
                <p class="eyebrow">Офис</p>
                <h2>Бяла река, Смолян</h2>
              </div>

              <address>
                ул. „Хаджи Иван Бечев“ 6<br />
                Промишлена зона Бяла река<br />
                Смолян, България
              </address>

              <div class="contact-map" aria-label="Карта с локацията на офиса">
                <iframe
                  title="АРТСТРОЙ ООД — офис Смолян"
                  src={`https://maps.google.com/maps?q=${mapQuery}&output=embed`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>

                <span aria-hidden="true" class="contact-map__wash"></span>

                <div class="contact-map__addr" aria-hidden="true">
                  <span class="contact-map__bar"></span>
                  <div>
                    <p>Адрес</p>
                    <strong>ул. „Хаджи Иван Бечев“ 6, Смолян</strong>
                  </div>
                </div>
              </div>

              <a
                class="contact-map-link"
                href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Отвори в Google Maps
                <span aria-hidden="true">↗</span>
              </a>
            </div>

          </aside>
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    min-height: 100svh;
  }

  .contact-page__mark {
    position: absolute;
    top: 5.8rem;
    right: -0.08em;
    z-index: -1;
    color: rgba(18, 22, 28, 0.04);
    font-family: var(--font-display);
    font-size: clamp(9rem, 24vw, 24rem);
    font-style: italic;
    line-height: 0.8;
    pointer-events: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }

  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 0.48fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
  }

  .contact-hero h1 {
    margin-top: 1rem;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 1.9rem + 4vw, 5.9rem);
    font-weight: 560;
    line-height: 0.94;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .contact-hero__text {
    margin-bottom: 0.9rem;
    max-width: 34rem;
    border-left: 2px solid #ba2d20;
    padding-left: 1.35rem;
    color: rgba(18, 22, 28, 0.68);
    font-size: clamp(1rem, 0.92rem + 0.28vw, 1.14rem);
    line-height: 1.72;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(21rem, 0.56fr);
    gap: clamp(1.25rem, 3.8vw, 4.5rem);
    align-items: start;
  }

  .contact-layout > * {
    min-width: 0;
  }

  .contact-form-panel,
  .contact-side {
    border-top: 1px solid rgba(18, 22, 28, 0.16);
  }

  .contact-form-panel {
    padding-top: 1.4rem;
  }

  .contact-form-panel__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.52fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 0.7rem;
    align-items: end;
  }

  .contact-form-panel__head > * {
    min-width: 0;
  }

  .contact-form-panel__head .eyebrow {
    grid-column: 1 / -1;
  }

  .contact-form-panel__head h2 {
    max-width: 12ch;
    color: #15191f;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 2.5vw, 4rem);
    line-height: 0.95;
  }

  .contact-form-panel__head p {
    color: rgba(18, 22, 28, 0.62);
    font-size: 0.96rem;
    line-height: 1.64;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.5rem;
    max-width: 100%;
    min-width: 0;
    background: rgba(18, 22, 28, 0.14);
    border: 1px solid rgba(18, 22, 28, 0.14);
  }

  .contact-field {
    display: grid;
    align-content: start;
    min-height: 6.6rem;
    background: rgba(255, 251, 244, 0.76);
    padding: 1rem 1.05rem 0.9rem;
  }

  .contact-field--wide {
    grid-column: 1 / -1;
    min-height: 14rem;
  }

  .contact-field label {
    color: #ba2d20;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #15191f;
    font: inherit;
    line-height: 1.45;
  }

  .contact-field input {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.8rem);
  }

  .contact-field textarea {
    min-height: 9.5rem;
    margin-top: 0.9rem;
    resize: vertical;
    font-size: 1rem;
  }

  .contact-field input:focus,
  .contact-field textarea:focus {
    box-shadow: inset 0 -2px 0 #ba2d20;
  }

  .contact-field:has([aria-invalid="true"]) {
    background: rgba(186, 45, 32, 0.08);
  }

  .contact-error {
    min-height: 1.1rem;
    margin-top: 0.35rem;
    color: #9c241b;
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .contact-form__footer {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #15191f;
    padding: 1rem;
    color: rgba(255, 251, 244, 0.7);
  }

  .contact-form__footer p {
    max-width: 28rem;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .contact-form__footer button {
    display: inline-flex;
    min-height: 3.1rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border: 1px solid rgba(255, 251, 244, 0.18);
    border-radius: 999px;
    background: #ba2d20;
    padding: 0 1.2rem;
    color: #fffaf2;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 220ms ease, transform 220ms ease;
  }

  .contact-form__footer button:hover,
  .contact-form__footer button:focus-visible {
    background: #d43a2c;
    transform: translateY(-1px);
  }

  .contact-side {
    display: grid;
    gap: 1.1rem;
    padding-top: 1.4rem;
  }

  .contact-office__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .contact-office h2 {
    color: #15191f;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.05vw, 2rem);
    line-height: 1;
  }

  .contact-office address {
    margin-top: 1rem;
    color: rgba(18, 22, 28, 0.74);
    font-style: normal;
    font-size: 0.97rem;
    line-height: 1.58;
  }

  .contact-map {
    margin-top: 1.15rem;
    position: relative;
    min-height: 20rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 18px 44px -22px rgba(18, 22, 28, 0.28);
    outline: 1px solid rgba(18, 22, 28, 0.10);
    outline-offset: -1px;
    background: rgba(18, 22, 28, 0.08);
  }

  .contact-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(1.05) contrast(1.02);
    transition: filter 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-map:hover iframe {
    filter: saturate(1.15) contrast(1.04);
  }

  .contact-map__wash {
    position: absolute;
    inset: 0 0 auto;
    height: 4rem;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(18, 22, 28, 0.22), rgba(18, 22, 28, 0.06), transparent);
  }

  .contact-map__addr {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    max-width: calc(100% - 1.5rem);
    align-items: flex-start;
    gap: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.94);
    padding: 0.55rem 0.85rem 0.65rem 0.7rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 8px 22px -10px rgba(18, 22, 28, 0.32);
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    pointer-events: none;
  }

  .contact-map__bar {
    display: inline-block;
    width: 0.125rem;
    height: 0.875rem;
    margin-top: 0.125rem;
    flex: 0 0 auto;
    background: #ba2d20;
  }

  .contact-map__addr p {
    color: #ba2d20;
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .contact-map__addr strong {
    display: block;
    margin-top: 0.15rem;
    overflow: hidden;
    color: #15191f;
    font-size: 0.75rem;
    font-weight: 520;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-map-link {
    margin-top: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #15191f;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 220ms ease, gap 220ms ease;
  }

  .contact-map-link:hover {
    color: #ba2d20;
    gap: 0.75rem;
  }

  @media (max-width: 1180px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .contact-side {
      grid-template-columns: minmax(0, 0.9fr) minmax(19rem, 0.85fr);
      align-items: start;
    }

  }

  @media (max-width: 900px) {
    .contact-hero,
    .contact-form-panel__head,
    .contact-side {
      grid-template-columns: 1fr;
    }

    .contact-hero__text {
      margin-bottom: 0;
    }
  }

  @media (max-width: 767px) {
    .contact-page .container-page {
      padding-left: 1.125rem;
      padding-right: 1.125rem;
    }

    .contact-page__mark {
      top: 7rem;
      right: 0;
      font-size: 8.5rem;
    }

    .contact-hero h1 {
      max-width: none;
      font-size: clamp(2.05rem, 9.5vw, 3.1rem);
      white-space: normal;
    }

    .contact-hero__text {
      padding-left: 1rem;
      font-size: 0.98rem;
      line-height: 1.6;
    }

    .contact-form-panel__head,
    .contact-form-panel__head p,
    .contact-side,
    .contact-office,
    .contact-map {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    .contact-form {
      grid-template-columns: 1fr;
    }

    .contact-field,
    .contact-field--wide {
      min-height: auto;
    }

    .contact-form__footer {
      display: grid;
    }

    .contact-form__footer button {
      width: 100%;
    }

    .contact-office__head {
      display: grid;
    }

    .contact-map {
      min-height: 17rem;
      aspect-ratio: 16 / 11;
      max-height: 19rem;
    }

    .contact-map__addr {
      left: 0.55rem;
      right: 0.55rem;
      max-width: calc(100% - 1.1rem);
    }

    .contact-map__addr > div {
      min-width: 0;
    }

    .contact-map__addr strong {
      white-space: normal;
    }

  }
</style>

<script>
  const initContactForms = () => {
    const forms = document.querySelectorAll('[data-contact-form]');

    forms.forEach((form) => {
      if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') return;
      form.dataset.ready = 'true';

      const status = form.querySelector('[data-contact-status]');
      const emailInput = form.elements.namedItem('email');
      const messageInput = form.elements.namedItem('message');
      const firstNameInput = form.elements.namedItem('firstName');
      const lastNameInput = form.elements.namedItem('lastName');
      const phoneInput = form.elements.namedItem('phone');

      const getValue = (field: Element | RadioNodeList | null) => field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement
        ? field.value.trim()
        : '';

      const setError = (fieldName: string, message: string) => {
        const field = form.elements.namedItem(fieldName);
        const error = form.querySelector(`[data-error-for="${fieldName}"]`);

        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
          field.setAttribute('aria-invalid', message ? 'true' : 'false');
        }

        if (error) {
          error.textContent = message;
        }
      };

      const clearError = (event: Event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) {
          setError(target.name, '');
        }
      };

      form.addEventListener('input', clearError);

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const email = getValue(emailInput);
        const message = getValue(messageInput);
        const emailIsValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        let hasError = false;

        setError('email', '');
        setError('message', '');

        if (!emailIsValid) {
          setError('email', 'Въведете валиден имейл адрес.');
          hasError = true;
        }

        if (message.length < 10) {
          setError('message', 'Добавете поне няколко думи за обекта или въпроса.');
          hasError = true;
        }

        if (hasError) {
          if (status) status.textContent = 'Поправете полетата в червено и опитайте пак.';
          return;
        }

        const firstName = getValue(firstNameInput);
        const lastName = getValue(lastNameInput);
        const phone = getValue(phoneInput);
        const subjectName = [firstName, lastName].filter(Boolean).join(' ') || 'сайт';
        const subject = `Запитване от ${subjectName}`;
        const body = [
          `Име: ${[firstName, lastName].filter(Boolean).join(' ') || '-'}`,
          `Телефон: ${phone || '-'}`,
          `Имейл: ${email}`,
          '',
          'Текст:',
          message,
        ].join('\n');

        if (status) status.textContent = 'Отваряме имейл клиент с попълненото запитване.';
        window.location.href = `mailto:artstroismolian@abv.bg?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    });
  };

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
