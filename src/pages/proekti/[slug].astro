---
/**
 * Project detail page — premium, relaxed product page.
 *
 * Composition (top→bottom):
 *   1. Running head: project number, category, place, back link
 *   2. Hero: cover left, title + meta + near-square map right (desktop).
 *   3. Gallery: edge to edge on desktop, a grid up to 5 frames and a
 *      horizontal slider above that; lightbox with arrow keys
 *
 * Phones and tablets (owner's variant A, 26.11): tall cover with the
 * title on it → details → running head → gallery in 2 square columns →
 * square map (loaded near the view) → the rest.
 *   4. Long description (only when it is longer than the hero snippet)
 *   5. Contact band: manager's phone
 *   6. More projects (ProjectCard, as on /proekti)
 *
 * SEO: CreativeWork + BreadcrumbList JSON-LD, canonical, OG image,
 * descriptive alts, lazy gallery, eager hero.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import ProjectProtocol from '../../components/ProjectProtocol.astro';
import { projects, getProtocol } from '../../data/projects';
import { company, phone, telHref } from '../../data/company';
import { organizationId } from '../../data/schema';
import { projectMetaDescription } from '../../data/meta';
import ProjectCard from '../../components/ProjectCard.astro';
import { imageSize, responsiveImage } from '../../data/assets';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const idx = projects.findIndex((p) => p.id === project.id);

// Pick the next NEXT_COUNT projects in archive order (wrapping). Used in the
// editorial close-out grid so visitors leave with three concrete onward
// destinations — a curiosity hook, not just a "next" button.
const NEXT_COUNT = 4;
const nextProjects = Array.from({ length: NEXT_COUNT }, (_, i) =>
  projects[(idx + 1 + i) % projects.length]
);

const category = project.category;
const cover = project.coverImageUrl ?? '/hero/hero-poster.jpg';
const locationShort = (project.location ?? '').split(',')[0]?.trim() || 'България';

// The cover is the hero photo on every width, so it never repeats in the
// gallery below it.
const gallery: string[] = project.galleryImageUrls.filter((src) => src !== project.coverImageUrl);
const framesLabel = (n: number) => (n === 1 ? '1 кадър' : `${n} кадъра`);
// A description up to ~3 short sentences stays whole in the hero; only a
// longer one gets its own section (and a shortened copy in the hero).
const hasLongStory = (project.description?.length ?? 0) > 320;
// Up to 5 frames fit one screen-wide grid on desktop; more go into the
// horizontal slider. Below lg both are 2 columns of square frames.
const galleryStatic = gallery.length < 6;
// Drawn width of a gallery tile (see .gallery-grid / .gallery-wall below).
// The lead tile is half the screen on desktop (all of it when alone), and
// takes the full row below lg when the count is odd.
const tileSizes = (i: number) =>
  galleryStatic
    ? i === 0
      ? gallery.length === 1 ? '100vw' : '(min-width: 1024px) 50vw, 100vw'
      : '50vw'
    : i === 0
      ? '(min-width: 1024px) 720px, 100vw'
      : '(min-width: 1024px) 360px, 50vw';

const mapEmbedSrc = project.mapEmbedUrl ??
  (project.location
    ? `https://maps.google.com/maps?q=${encodeURIComponent(project.location)}&hl=bg&z=14&output=embed`
    : null);

// Coordinate parsing — legacy Maps embeds encode lat/lng in pb param
function parseCoords(embedUrl: string | null) {
  if (!embedUrl) return null;
  const m = embedUrl.match(/!2d(-?\d+\.\d+)!3d(-?\d+\.\d+)/);
  if (!m) return null;
  return { lng: parseFloat(m[1]), lat: parseFloat(m[2]) };
}
const coords = parseCoords(project.mapEmbedUrl);

const projectNumber = String(idx + 1).padStart(3, '0');
const totalProjects = String(projects.length).padStart(3, '0');
const protocol = getProtocol(project);

// Year extracted from Акт 16 record (format "XII.2020" → "2020"); used
// in the editorial running-head metadata strip.
const protocolYear =
  protocol?.records.find((r) => /^акт/i.test(r.label))?.value.match(/(\d{4})/)?.[1] ?? null;

// The place is added only when the title does not name it already.
const placeInTitle = project.title.toLowerCase().includes(
  locationShort.replace(/^(гр|с|к\.к|кв)\.\s*/i, '').toLowerCase()
);
const pageTitle = `${project.title}${
  locationShort && locationShort !== 'България' && !placeInTitle ? `, ${locationShort}` : ''
} — ${company.name}`;
const mainPhone = phone('Управител');

// Meta description: what the title does not say (rules in data/meta.ts).
const pageDescription = projectMetaDescription(project, pageTitle);

// ─── SEO ────────────────────────────────────────────────────────
const siteOrigin = (Astro.site ?? new URL('https://artstroismolian.com')).toString().replace(/\/$/, '');
const canonical = `${siteOrigin}/proekti/${project.slug}/`;

const schemaCreativeWork = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': canonical,
  name: project.title,
  description: project.description ?? undefined,
  image: project.coverImageUrl ? `${siteOrigin}${project.coverImageUrl}` : undefined,
  url: canonical,
  inLanguage: 'bg',
  // Full company data lives in the GeneralContractor block from BaseLayout.
  creator: { '@type': 'GeneralContractor', '@id': organizationId(siteOrigin), name: company.name },
  contentLocation: project.location
    ? {
        '@type': 'Place',
        name: project.location,
        ...(coords && {
          geo: {
            '@type': 'GeoCoordinates',
            latitude: coords.lat,
            longitude: coords.lng,
          },
        }),
      }
    : undefined,
  ...(project.client && {
    sponsor: { '@type': 'Organization', name: project.client },
  }),
  ...(project.scope && { keywords: project.scope }),
  genre: category,
  // Expose ПРОТОКОЛ metrics + records as PropertyValue entries so
  // crawlers and LLMs can extract structured facts (РЗП, срок, etc.).
  ...(protocol && {
    additionalProperty: [
      ...protocol.metrics.map((m) => ({
        '@type': 'PropertyValue',
        name: m.sublabel ? `${m.label} (${m.sublabel})` : m.label,
        value: m.value.replace(/\s/g, ''),
      })),
      ...protocol.records.map((r) => ({
        '@type': 'PropertyValue',
        name: r.label,
        value: r.value,
      })),
    ],
  }),
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Начало', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Проекти', item: `${siteOrigin}/proekti/` },
    { '@type': 'ListItem', position: 3, name: project.title, item: canonical },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={cover} solidHeader={true}>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaCreativeWork)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />

  <article class="bg-cream-50 pt-20 flex flex-col">

    <!-- ════════════════════════════════════════════════════════════
         1 · Running head — magazine-style metadata strip + back link.
              Reads like the running header of an architecture
              publication: archive position · category · location · year.
         ════════════════════════════════════════════════════════════ -->
    <!-- Phones and tablets: under the details, so the cover sits right
         under the header (owner's variant A). -->
    <nav aria-label="Проекти" class="proj-runhead max-lg:order-2 max-lg:border-t border-b border-ink-900/10 bg-cream-50">
      <div class="container-page py-3.5 md:py-4 flex items-center justify-between gap-4 flex-wrap">
        <ol class="runhead-meta flex items-center flex-wrap gap-x-2.5 md:gap-x-3 gap-y-1">
          <li class="runhead-item runhead-archive">
            Проект № <span class="tabular-nums">{projectNumber}</span> <span class="opacity-50">/</span> <span class="tabular-nums">{totalProjects}</span>
          </li>
          <li class="runhead-sep" aria-hidden="true">·</li>
          <li class="runhead-item">{category}</li>
          {locationShort && locationShort !== 'България' && (
            <>
              <li class="runhead-sep" aria-hidden="true">·</li>
              <li class="runhead-item">{locationShort}</li>
            </>
          )}
          {protocolYear && (
            <>
              <li class="runhead-sep" aria-hidden="true">·</li>
              <li class="runhead-item tabular-nums">{protocolYear}</li>
            </>
          )}
        </ol>
        <a
          href="/proekti"
          class="crumb-back inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-medium text-ink-900 hover:text-brand transition-colors duration-300"
        >
          <span aria-hidden="true" class="text-brand transition-transform duration-300">←</span>
          Всички проекти
        </a>
      </div>
    </nav>

    <!-- ════════════════════════════════════════════════════════════
         2 · HERO — image-led split. Cover on the left (7 cols),
              title + key meta + a near-square map on the right (5 cols),
              as tall as the cover.
              Phones and tablets (owner's variant A): a tall full-width
              cover right under the header with the category and the
              title on it, then the details. The right column turns into
              `display: contents`, so its head lands on the cover's grid
              cell and its body in the next row (one h1 for both).
         ════════════════════════════════════════════════════════════ -->
    <section class="relative isolate overflow-hidden pt-0 lg:pt-10 pb-8 lg:pb-12 max-lg:order-1">
      <div aria-hidden="true" class="proj-sheet absolute inset-0 -z-10 bp-sheet"></div>
      <div class="container-page">
        <div class="proj-hero grid grid-cols-12 gap-x-6 md:gap-x-10 lg:items-stretch">

          <!-- Cover image: full-bleed below lg, a framed plate on lg -->
          <div class="proj-hero__cover col-span-12 -mx-6 md:-mx-10 lg:mx-0 lg:col-span-7 flex">
            <figure class="hero-figure relative overflow-hidden bg-ink-900 w-full lg:rounded-xl lg:ring-1 lg:ring-ink-900/10 lg:shadow-[0_18px_44px_-22px_rgba(18,22,28,0.28)]">
              <img
                {...responsiveImage(cover, '(min-width: 1280px) 700px, (min-width: 1024px) 58vw, 100vw')}
                alt={`${project.title}${project.location ? ` — ${project.location}` : ''}`}
                fetchpriority="high"
                decoding="async"
                class="hero-image absolute inset-0 block w-full h-full object-cover"
                style={`view-transition-name: project-${project.slug};`}
              />
              <!-- Below lg the title sits on the photo: a dark wash from the bottom -->
              <span aria-hidden="true" class="hero-wash lg:hidden pointer-events-none absolute inset-0"></span>
            </figure>
          </div>

          <!-- Title + meta column -->
          <div class="proj-hero__side col-span-12 lg:col-span-5 lg:pt-2 lg:flex lg:flex-col">
            <div class="proj-hero__head">
              <Reveal>
                <p class="eyebrow flex items-center gap-3">
                  <span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span>
                  {category}
                </p>
              </Reveal>

              <Reveal>
                <h1
                  class="hero-title mt-3 lg:mt-5 font-display text-white lg:text-ink-950 max-w-[20ch]"
                  style="font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.85rem); line-height: 1.02; letter-spacing: -0.02em;"
                >
                  {project.title}
                </h1>
              </Reveal>
            </div>

            <div class="proj-hero__body">
            {project.description && (
              <Reveal>
                <p
                  class="mt-6 text-ink-900/85 text-[15px] leading-[1.65] max-w-[42ch]"
                >
                  {hasLongStory
                    ? project.description.slice(0, 217).trimEnd() + '…'
                    : project.description}
                </p>
              </Reveal>
            )}

            <!-- Compact key-meta list -->
            {(project.client || project.scope) && (
            <Reveal>
              <dl class="mt-7 grid grid-cols-1 gap-y-3.5">
                {project.client && (
                  <div class="meta-row">
                    <dt>Възложител</dt>
                    <dd>
                      <div class="flex items-center gap-3 flex-wrap">
                        <span class="client-name">{project.client}</span>
                        {project.partnerLogoUrl && (
                          project.partnerUrl ? (
                            <a
                              href={project.partnerUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="client-logo-link shrink-0"
                              aria-label={`Сайт на ${project.client}`}
                            >
                              <img
                                src={project.partnerLogoUrl}
                                {...imageSize(project.partnerLogoUrl)}
                                alt={`${project.client} — лого`}
                                loading="lazy"
                                decoding="async"
                                class="client-logo"
                              />
                            </a>
                          ) : (
                            <img
                              src={project.partnerLogoUrl}
                              {...imageSize(project.partnerLogoUrl)}
                              alt={`${project.client} — лого`}
                              loading="lazy"
                              decoding="async"
                              class="client-logo shrink-0"
                            />
                          )
                        )}
                      </div>
                    </dd>
                  </div>
                )}
                {project.scope && (
                  <div class="meta-row">
                    <dt>Обхват</dt>
                    <dd>{project.scope}</dd>
                  </div>
                )}
              </dl>
            </Reveal>
            )}
            </div>

            {mapEmbedSrc && (
              <!-- Desktop only (phones get their own map after the gallery).
                   Near square; it takes what the column has left, so the
                   column ends with the cover. The iframe gets its `src`
                   from the page script once it is drawn and near the view. -->
              <Reveal class="max-lg:hidden mt-7 grow flex flex-col">
                <div class="mini-map mini-map--side grow relative overflow-hidden rounded-xl ring-1 ring-ink-900/10 bg-ink-100 shadow-[0_18px_44px_-22px_rgba(18,22,28,0.28)]">

                  <iframe
                    data-map-src={mapEmbedSrc}
                    class="absolute inset-0 block w-full h-full"
                    style="border: 0;"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Малка карта на ${project.title}`}
                  ></iframe>

                  <!-- Soft top wash so the floating pill always reads -->
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-ink-950/22 via-ink-950/6 to-transparent"
                  ></span>

                  <!-- Bottom address pill -->
                  {project.location && (
                    <div class="pointer-events-none absolute left-3 right-3 bottom-3">
                      <div class="mini-map-addr inline-flex items-start gap-2.5 max-w-full">
                        <span aria-hidden="true" class="mt-0.5 inline-block h-3.5 w-0.5 bg-brand shrink-0"></span>
                        <div class="min-w-0">
                          <p class="eyebrow">Адрес</p>
                          <p
                            class="mt-1 text-ink-950 text-sm !leading-[1.35] truncate"
                          >
                            {project.location}
                          </p>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </Reveal>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         3 · ПРОТОКОЛ — dark editorial proof band. Big metrics +
              document refs. Renders only when project has protocol
              data filled in (currently fake placeholder for id=1).
         ════════════════════════════════════════════════════════════ -->
    {protocol && (
      <div class="max-lg:order-5">
        <ProjectProtocol protocol={protocol} number={projectNumber} total={totalProjects} />
      </div>
    )}

    <!-- ════════════════════════════════════════════════════════════
         4 · GALLERY — dense wall, hairline gaps, lightbox.
              Phones and tablets: 2 columns of square frames inside the
              page gutter. Desktop: edge to edge of the screen (owner,
              26.11): a grid up to 5 frames, a horizontal slider above.
         ════════════════════════════════════════════════════════════ -->
    {gallery.length > 0 && (
      <section class="relative isolate overflow-hidden bg-cream-50 pt-2 lg:pt-4 pb-8 md:pb-10 lg:pb-12 max-lg:order-3" aria-labelledby="gallery-label">
        <div aria-hidden="true" class="proj-sheet absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>
        <div class="container-page mb-4 md:mb-5">
          <div class="flex items-baseline justify-between gap-4">
            <p id="gallery-label" class="eyebrow flex items-center gap-3"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Галерия</p>
            <p class="text-xs uppercase tracking-[0.18em] font-medium text-ink-600 tabular-nums">
              {framesLabel(gallery.length)}
            </p>
          </div>
        </div>

        <div class="px-6 md:px-10 lg:px-0">
          <div class="gallery-slider relative">
            <div
              class={galleryStatic ? 'gallery-grid' : 'gallery-wall'}
              data-gallery
              data-count={gallery.length}
              data-odd={gallery.length % 2 === 1 ? '' : undefined}
              role="region"
              aria-label={galleryStatic ? 'Галерия' : 'Хоризонтална галерия'}
            >
              {gallery.map((src, i) => (
                <button
                  type="button"
                  class="g-tile group"
                  data-index={i}
                  aria-label={`Кадър ${i + 1}, на цял екран`}
                >
                  <img
                    {...responsiveImage(src, tileSizes(i))}
                    data-full={src}
                    alt={`${project.title}, кадър ${i + 1}`}
                    loading={i < 6 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="block h-full w-full object-cover transition-transform duration-[1200ms] ease-out-expo group-hover:scale-[1.04]"
                  />
                  <span
                    aria-hidden="true"
                    class="g-wash absolute inset-0 bg-gradient-to-t from-ink-950/45 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-400"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="g-num absolute left-2.5 bottom-2.5 md:left-3 md:bottom-3 text-xs uppercase tracking-[0.2em] font-medium text-white tabular-nums opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                    style="text-shadow: 0 1px 3px rgba(0,0,0,0.55);"
                  >
                    {String(i + 1).padStart(2, '0')} <span class="opacity-50">/</span> {String(gallery.length).padStart(2, '0')}
                  </span>
                  <span
                    aria-hidden="true"
                    class="g-zoom absolute right-2.5 top-2.5 md:right-3 md:top-3 grid place-items-center w-8 h-8 rounded-full bg-white/0 group-hover:bg-white/12 ring-0 group-hover:ring-1 ring-white/30 backdrop-blur-sm transition-all duration-400"
                  >
                    <svg width="10" height="10" viewBox="0 0 14 14" fill="none" class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                      <path d="M2 2h4M2 2v4M12 2H8M12 2v4M2 12h4M2 12v-4M12 12H8M12 12v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                  </span>
                </button>
              ))}
            </div>

            {!galleryStatic && (<>
            <!-- Edge fades — soften where tiles get clipped at the scroll edges -->
            <span aria-hidden="true" class="gallery-fade gallery-fade-l pointer-events-none absolute left-0 top-0 bottom-0 w-10 md:w-16 lg:w-20"></span>
            <span aria-hidden="true" class="gallery-fade gallery-fade-r pointer-events-none absolute right-0 top-0 bottom-0 w-10 md:w-16 lg:w-20"></span>

            <!-- Floating arrow controls -->
            <button
              type="button"
              class="gallery-arrow gallery-arrow-prev"
              data-gallery-prev
              aria-label="Предишни кадри"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button
              type="button"
              class="gallery-arrow gallery-arrow-next"
              data-gallery-next
              aria-label="Следващи кадри"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            </>)}
          </div>
        </div>

        {!galleryStatic && (
        <div class="container-page max-lg:hidden">
          <!-- Live scrubber — tracks horizontal scroll position -->
          <div class="mt-5 md:mt-6 flex items-center gap-4 text-xs uppercase tracking-[0.18em] font-medium text-ink-600">
            <span class="tabular-nums text-ink-950" data-gallery-current>01</span>
            <span class="flex-1 h-px bg-ink-900/10 relative overflow-hidden">
              <span class="absolute left-0 top-0 bottom-0 bg-brand/85 origin-left" data-gallery-progress style="width: 0%;"></span>
            </span>
            <span class="tabular-nums text-ink-950">{String(gallery.length).padStart(2, '0')}</span>
          </div>
        </div>
        )}

        <!-- Lightbox -->
        <dialog id="gw-lightbox" class="gw-lightbox" aria-label="Преглед на галерия">
          <div class="gw-stage">
            <img id="gw-image" alt="" />
          </div>
          <div class="gw-topbar pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between p-5 md:p-6">
            <span id="gw-label" class="text-white/85 text-xs uppercase tracking-[0.2em] font-medium pointer-events-auto">
              Кадър 01
            </span>
            <button type="button" class="gw-btn gw-close pointer-events-auto" data-gw-close aria-label="Затворете">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </button>
          </div>
          <button type="button" class="gw-btn gw-prev" data-gw-prev aria-label="Предишен кадър">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="gw-btn gw-next" data-gw-next aria-label="Следващ кадър">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="gw-counter" aria-hidden="true">
            <span id="gw-current" class="tabular-nums">1</span>
            <span class="opacity-40 mx-2">/</span>
            <span id="gw-total" class="tabular-nums">{gallery.length}</span>
          </div>
        </dialog>
      </section>
    )}

    <!-- ════════════════════════════════════════════════════════════
         4b · MAP on phones and tablets — a square map with the address
              after the photos. It loads only when it comes near the
              view (page script), so a visitor who never scrolls this
              far does not download it.
         ════════════════════════════════════════════════════════════ -->
    {mapEmbedSrc && (
      <section class="lg:hidden relative isolate overflow-hidden bg-cream-50 pt-2 pb-10 md:pb-12 max-lg:order-4" aria-labelledby="map-label">
        <div aria-hidden="true" class="proj-sheet absolute inset-0 -z-10 bp-sheet bp-sheet-c"></div>
        <div class="container-page">
          <p id="map-label" class="eyebrow flex items-center gap-3 mb-4 md:mb-5"><span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span> Местоположение</p>
          <div class="mini-map mini-map--square relative overflow-hidden rounded-xl ring-1 ring-ink-900/10 bg-ink-100 shadow-[0_18px_44px_-22px_rgba(18,22,28,0.28)]">
            <iframe
