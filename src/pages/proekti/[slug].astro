<script define:vars={{ gallery }}>
  // ── Lightbox ───────────────────────────────────────────
  const dialog = document.getElementById('gw-lightbox');
  const imageEl = document.getElementById('gw-image');
  const currentEl = document.getElementById('gw-current');
  const labelEl = document.getElementById('gw-label');

  if (dialog && imageEl && currentEl && gallery.length > 0) {
    if (gallery.length === 1) dialog.setAttribute('data-single', '');

    let currentIndex = 0;

    const show = (idx) => {
      currentIndex = ((idx % gallery.length) + gallery.length) % gallery.length;
      imageEl.style.animation = 'none';
      imageEl.offsetHeight;
      imageEl.style.animation = '';
      imageEl.src = gallery[currentIndex];
      currentEl.textContent = String(currentIndex + 1);
      if (labelEl) labelEl.textContent = `Кадър ${String(currentIndex + 1).padStart(2, '0')}`;
    };

    const open = (idx) => {
      show(idx);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };
    const close = () => dialog.close();

    document.querySelectorAll('[data-gallery] .g-tile').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.getAttribute('data-index'))));
    });

    dialog.querySelector('[data-gw-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-gw-prev]')?.addEventListener('click', () => show(currentIndex - 1));
    dialog.querySelector('[data-gw-next]')?.addEventListener('click', () => show(currentIndex + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(currentIndex - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(currentIndex + 1); }
    });
  }

  // ── Horizontal slider — arrows, scrubber, edge-fade toggles ──
  const wall = document.querySelector('[data-gallery]');
  const slider = wall?.closest('.gallery-slider');
  const prevBtn = slider?.querySelector('[data-gallery-prev]');
  const nextBtn = slider?.querySelector('[data-gallery-next]');
  const progressEl = document.querySelector('[data-gallery-progress]');
  const currentTileEl = document.querySelector('[data-gallery-current]');

  if (wall && slider) {
    const tiles = Array.from(wall.querySelectorAll('.g-tile'));
    const total = tiles.length;

    const tileStep = () => {
      // Scroll by ~one viewport-width worth, biased to multiples of the
      // first tile's width so snaps line up nicely.
      const first = tiles[0];
      if (!first) return wall.clientWidth * 0.85;
      const w = first.getBoundingClientRect().width;
      const cols = Math.max(1, Math.floor(wall.clientWidth / w));
      return w * cols;
    };

    const updateState = () => {
      const max = wall.scrollWidth - wall.clientWidth;
      const x = wall.scrollLeft;
      const ratio = max > 0 ? x / max : 0;
      const atStart = x <= 2;
      const atEnd = x >= max - 2;
      slider.dataset.atStart = String(atStart);
      slider.dataset.atEnd = String(atEnd);
      if (prevBtn) prevBtn.classList.toggle('is-disabled', atStart);
      if (nextBtn) nextBtn.classList.toggle('is-disabled', atEnd);
      if (progressEl) progressEl.style.width = `${Math.max(6, ratio * 100)}%`;

      // Current tile = first one whose left edge is within the viewport
      const wallRect = wall.getBoundingClientRect();
      let idx = 0;
      for (let i = 0; i < tiles.length; i++) {
        const r = tiles[i].getBoundingClientRect();
        if (r.left - wallRect.left >= -8) { idx = i; break; }
      }
      if (currentTileEl) currentTileEl.textContent = String(idx + 1).padStart(2, '0');
    };

    prevBtn?.addEventListener('click', () => {
      wall.scrollBy({ left: -tileStep(), behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      wall.scrollBy({ left: tileStep(), behavior: 'smooth' });
    });

    let raf = 0;
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; updateState(); });
    };
    wall.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateState);
    updateState();

    // Keyboard support — left/right arrows scroll the slider when focused
    wall.tabIndex = 0;
    wall.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); wall.scrollBy({ left: -tileStep(), behavior: 'smooth' }); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); wall.scrollBy({ left: tileStep(), behavior: 'smooth' }); }
    });
  }
</script>
