  }

  /* ─────────────────────────────────────────────────────────────
     LIGHTBOX — native <dialog>, blurred backdrop.
     ───────────────────────────────────────────────────────────── */
  .gw-lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: white;
  }
  .gw-lightbox::backdrop {
    background: rgba(10, 12, 16, 0.97);
