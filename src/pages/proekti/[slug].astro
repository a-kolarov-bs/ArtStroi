    <!-- ════════════════════════════════════════════════════════════
         5 · CTA — the manager's phone right after the photos and text.
         ════════════════════════════════════════════════════════════ -->
    <section class="relative isolate overflow-hidden bg-ink-950 text-white max-lg:order-7" aria-labelledby="proj-cta-title">
      <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-dark bp-sheet-d"></div>
      <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-brand"></span>
      <div class="container-page py-10 md:py-12 lg:py-14">
        <div class="grid gap-7 lg:grid-cols-12 lg:items-center lg:gap-10">
          <div class="lg:col-span-5">
            <h2
              id="proj-cta-title"
              class="font-display text-white tracking-tight leading-[1.05]"
              style="font-size: clamp(1.85rem, 1.2rem + 2vw, 2.9rem); letter-spacing: -0.02em;"
            >
              Въпрос за обекта?
            </h2>
            <p class="mt-3 text-base md:text-lg text-white/70 leading-[1.6] max-w-[40ch]">
              Обадете се на управителя в работно време.
            </p>
          </div>
          <div class="lg:col-span-7 flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10 lg:justify-end">
            <a href={telHref(mainPhone.number)} class="proj-cta-tel group">
              <span class="eyebrow block">Управител</span>
              <span
                class="mt-2 block font-display tabular-nums text-white transition-colors duration-300 group-hover:text-brand"
                style="font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.35rem); line-height: 1; letter-spacing: -0.01em;"
              >
                {mainPhone.number}
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         6 · MORE PROJECTS — the same card as the projects page.
         ════════════════════════════════════════════════════════════ -->
    <section class="relative isolate overflow-hidden bg-cream-50 py-10 md:py-12 lg:py-16 max-lg:order-8" aria-labelledby="proj-more-title">
      <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>
      <div class="container-page">
        <div class="flex items-end justify-between gap-4 flex-wrap mb-6 md:mb-8">
          <div>
            <p class="eyebrow flex items-center gap-3">
              <span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span>
              Реализирани обекти
            </p>
            <h2
              id="proj-more-title"
              class="mt-3 font-display text-ink-950 !leading-[1.05]"
              style="font-size: clamp(1.4rem, 1rem + 1.3vw, 2rem); letter-spacing: -0.018em;"
            >
              Още проекти
            </h2>
          </div>
          <a
            href="/proekti"
            class="archive-all inline-flex items-center gap-2 text-ink-900 hover:text-brand transition-colors duration-300 text-xs uppercase tracking-[0.18em] font-semibold"
          >
            Вижте всички {projects.length}
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
          {nextProjects.map((p, i) => (
            <ProjectCard
              project={p}
              index={i}
              aspect="aspect-[4/5]"
              hoverImages={p.galleryImageUrls}
              sizes="(min-width: 1280px) 470px, (min-width: 1024px) 37vw, 80vw"
            />
          ))}
        </div>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  /* ── Hero — phones/tablets: a tall cover with the title on it ── */
  .hero-figure {
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 768px) {
    .hero-figure { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 1023.98px) {
    /* The side column dissolves into the grid: the head shares the
       cover's cell (bottom), the body takes the next row. */
    .proj-hero__side { display: contents; }
    .proj-hero__cover { grid-row: 1; grid-column: 1 / -1; }
    .proj-hero__head {
      grid-row: 1;
      grid-column: 1 / -1;
      align-self: end;
      position: relative;
      z-index: 1;
      padding-block: 4rem 1.75rem;
    }
    .proj-hero__head h1 { text-shadow: 0 2px 18px rgba(18, 22, 28, 0.45); }
    .proj-hero__body { grid-column: 1 / -1; padding-top: 0.25rem; }
  }
  .hero-wash {
    background: linear-gradient(to top, rgba(18, 22, 28, 0.92) 0%, rgba(18, 22, 28, 0.78) 30%, rgba(18, 22, 28, 0.35) 48%, rgba(18, 22, 28, 0) 66%);
  }
  /* Desktop: the cover sets the height (--cover-ratio); the map takes what
     the side column has left. Only a long text with the map's 4:3 floor
     makes the column, and so the cover, taller. */
  @media (min-width: 1024px) {
    .hero-figure { aspect-ratio: var(--cover-ratio, 27 / 26); }
  }
  .hero-image {
    animation: hero-settle 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes hero-settle {
    from { transform: scale(1.04); opacity: 0.5; }
    to   { transform: scale(1); opacity: 1; }
  }

  /* ── Meta rows — tight definition list ── */
  .meta-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid rgba(18, 22, 28, 0.08);
    align-items: baseline;
  }
  .meta-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .meta-row dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: #BA2D20;
  }
  .meta-row dd {
    color: #12161C;
    font-size: 14px;
    line-height: 1.45;
  }

  /* ── Client name + logo ── */
  .client-name {
    display: inline-block;
    font-size: 14px;
    line-height: 1.4;
    color: #12161C;
    font-weight: 500;
  }
  /* Logo sits beside the name. We keep height fixed and let width breathe,
     so portrait/landscape/square logos all render cleanly without being
     squashed into a forced square box. */
  .client-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    object-position: left center;
    opacity: 0.92;
    filter: saturate(0.95);
    transition: opacity 250ms cubic-bezier(0.16, 1, 0.3, 1),
                filter 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .client-logo-link {
    display: inline-block;
    line-height: 0;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .client-logo-link:hover .client-logo {
    opacity: 1;
    filter: saturate(1);
  }
  .client-logo-link:hover { transform: translateY(-1px); }

  /* ── Mini inline map (right column) — fills available vertical space
        so its bottom aligns with the cover image's bottom on desktop;
        never flatter than 4:3 (owner: "more square and taller"). A long
        text plus this floor makes the column, and so the cover, taller. */
  .mini-map--side {
    aspect-ratio: 4 / 3;
  }
  .mini-map--square {
    aspect-ratio: 1 / 1;
  }
  .mini-map iframe {
    filter: saturate(1.05) contrast(1.02);
    transition: filter 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mini-map:hover iframe {
    filter: saturate(1.15) contrast(1.04);
  }

  /* Address card sitting at the bottom of the map */
  .mini-map-addr {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    padding: 0.55rem 0.85rem 0.65rem 0.7rem;
    border-radius: 4px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 8px 22px -10px rgba(18, 22, 28, 0.32);
  }

  /* Subtle pulse on the corner pin — draws the eye without distracting */
  .mini-map-pin svg {
    animation: pin-bob 2.4s cubic-bezier(0.45, 0, 0.15, 1) infinite;
  }
  @keyframes pin-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mini-map-pin svg { animation: none; }
  }

  /* ── Crumb hover ── */
  .crumb-back:hover span[aria-hidden="true"] {
    transform: translateX(-3px);
  }

  /* ── Running head — magazine-style page header ── */
  .runhead-item {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 500;
    color: #12161C;
    line-height: 1.1;
  }
  .runhead-archive {
    color: #BA2D20;
    font-weight: 600;
  }
  .runhead-sep {
    color: #BA2D20;
    font-size: 0.75rem;
    opacity: 0.55;
    user-select: none;
  }

  /* ─────────────────────────────────────────────────────────────
     GALLERY — phones and tablets: 2 columns of square frames (owner's
     variant A); an odd count gives the lead frame the whole first row,
     so no cell is left empty. Grid and slider look the same here.
     ───────────────────────────────────────────────────────────── */
  .g-tile {
    position: relative;
    display: block;
    overflow: hidden;
    background: #1A1F26;
    cursor: zoom-in;
    border-radius: 6px;
  }
  /* Inside the frame: a full-bleed tile at the screen edge would clip an
     outer ring. Outlines paint above the photo. */
  .g-tile:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -3px;
    z-index: 1;
  }
  @media (max-width: 1023.98px) {
    .gallery-grid,
    .gallery-wall {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px;
    }
    .gallery-grid .g-tile,
    .gallery-wall .g-tile { aspect-ratio: 1 / 1; }
    [data-odd] > .g-tile:first-child {
      grid-column: span 2;
      aspect-ratio: 2 / 1;
    }
    .gallery-arrow,
    .gallery-fade { display: none; }
  }

  /* ─────────────────────────────────────────────────────────────
     GALLERY SLIDER (desktop, 6+ frames) — horizontal-scroll grid of
     3 rows, edge to edge of the screen. Tiles flow column by column,
     so the slider extends to the right as the gallery grows.
     ───────────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .gallery-wall {
      display: grid;
      grid-auto-flow: column;
      --row-h: 210px;
      grid-template-rows: repeat(3, var(--row-h));
      grid-auto-columns: clamp(280px, 26vw, 360px);
      gap: 3px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
    }
    .gallery-wall::-webkit-scrollbar { display: none; }
    .gallery-wall .g-tile { scroll-snap-align: start; border-radius: 0; }
    /* The lead plate spans all rows and 2 columns */
    .gallery-wall .g-tile:first-child {
      grid-row: 1 / -1;
      grid-column: span 2;
    }
  }

  /* Edge fades — subtle scroll hint without washing out the project frames */
  .gallery-fade {
    z-index: 2;
  }
  .gallery-fade-l {
    background: linear-gradient(to right, rgba(250, 243, 234, 0.58) 0%, rgba(250, 243, 234, 0.18) 42%, rgba(250, 243, 234, 0) 100%);
  }
  .gallery-fade-r {
    background: linear-gradient(to left, rgba(250, 243, 234, 0.58) 0%, rgba(250, 243, 234, 0.18) 42%, rgba(250, 243, 234, 0) 100%);
  }
  /* Hide the corresponding edge fade once the slider can no longer scroll
     in that direction — visually confirms you've reached the start/end. */
  .gallery-slider[data-at-start='true'] .gallery-fade-l { opacity: 0; }
  .gallery-slider[data-at-end='true'] .gallery-fade-r { opacity: 0; }
  .gallery-fade { transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1); }

  /* Floating arrow controls — Apple glass-dark pills, brand-red on hover */
  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    color: #12161C;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 12px 28px -10px rgba(18, 22, 28, 0.30);
    transition:
      background 220ms cubic-bezier(0.16, 1, 0.3, 1),
      color 220ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery-arrow:hover {
    background: #BA2D20;
    border-color: #BA2D20;
    color: white;
    transform: translateY(-50%) scale(1.05);
  }
  .gallery-arrow-prev { left: 18px; }
  .gallery-arrow-next { right: 18px; }
  @media (min-width: 768px) {
    .gallery-arrow-prev { left: 28px; }
    .gallery-arrow-next { right: 28px; }
  }
  @media (min-width: 1280px) {
    .gallery-arrow-prev { left: 40px; }
    .gallery-arrow-next { right: 40px; }
  }
  .gallery-arrow[disabled],
  .gallery-arrow.is-disabled {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) scale(0.92);
  }
  @media (max-width: 640px) {
    .gallery-arrow {
      width: 40px;
      height: 40px;
    }
    .gallery-arrow-prev { left: 6px; }
    .gallery-arrow-next { right: 6px; }
  }

  /* ─────────────────────────────────────────────────────────────
     GALLERY GRID (desktop, up to 5 frames) — one grid edge to edge
     of the screen with hairline gaps (owner, 26.11). The lead frame
     takes a 2×2 block; the others share the rest, so no cell is left
     empty.
     ───────────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(200px, 17vw, 340px);
      gap: 3px;
    }
    .gallery-grid .g-tile { border-radius: 0; }
    .gallery-grid .g-tile:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .gallery-grid[data-count='2'] .g-tile:last-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .gallery-grid[data-count='3'] .g-tile:not(:first-child),
    .gallery-grid[data-count='4'] .g-tile:last-child {
      grid-column: span 2;
    }
    .gallery-grid[data-count='1'] .g-tile {
      grid-column: span 4;
    }
  }

  /* Below lg the text runs the full width, so the drawing would cross it:
     keep it only at the right edge, away from the words. The strength is
     the site-wide one (no opacity here, round 2 task 14). */
  @media (max-width: 1023.98px) {
    .proj-sheet {
      -webkit-mask-image: linear-gradient(to right, transparent 62%, black 100%);
      mask-image: linear-gradient(to right, transparent 62%, black 100%);
    }
  }

  /* CTA band phone */
  .proj-cta-tel { display: inline-block; }

  /* ── Story prose ── */
  .story-prose {
    text-wrap: pretty;
    font-feature-settings: 'kern', 'liga';
  }

  /* "Виж всичките" link — arrow flicks up-right on hover */
  .archive-all:hover span[aria-hidden="true"] {
