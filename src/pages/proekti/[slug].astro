                transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .gw-btn:hover {
    background: #BA2D20;
    border-color: #BA2D20;
  }
  .gw-close { position: static; }
  .gw-prev {
    left: clamp(0.75rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .gw-next {
    right: clamp(0.75rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .gw-prev:hover { transform: translateY(-50%) scale(1.06); }
  .gw-next:hover { transform: translateY(-50%) scale(1.06); }
  .gw-counter {
    position: absolute;
    bottom: clamp(1rem, 3vh, 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-variant-numeric: tabular-nums;
  }
  .gw-lightbox[data-single] .gw-prev,
  .gw-lightbox[data-single] .gw-next,
  .gw-lightbox[data-single] .gw-counter { display: none; }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    #gw-image,
    .gw-lightbox[open] { animation: none !important; transform: none !important; opacity: 1 !important; }
    .map-card iframe { transition: none !important; filter: none !important; }
    .g-tile img { transition: none !important; }
    .mini-map-pin svg { animation: none !important; }
    .crumb-back:hover span,
    .map-cta:hover span { transform: none !important; }
  }
</style>

<script>
  // Gallery, lightbox and the desktop mini map of a project page.
  // ClientRouter runs this module once per visit. The page is wired on every
  // `astro:page-load` (also when the same project is opened again, by a link
  // or by "back") and released on `astro:before-swap`.
  let pageScope: AbortController | null = null;
  const release = () => {
    pageScope?.abort();
    pageScope = null;
  };

  // ── Maps: one beside the cover (desktop), one after the gallery (phones
  //    and tablets); the other is display:none. A map gets its `src` only
  //    when it is drawn and near the view, so neither is downloaded early.
  function initMaps(signal: AbortSignal) {
    const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-map-src]');
    if (!frames.length) return;
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const frame = entry.target as HTMLIFrameElement;
        if (!frame.getAttribute('src')) frame.src = frame.dataset.mapSrc ?? '';
        io.unobserve(frame);
      }
    }, { rootMargin: '300px 0px' });
    frames.forEach((frame) => io.observe(frame));
    signal.addEventListener('abort', () => io.disconnect());
  }

  // ── Lightbox ───────────────────────────────────────────
  function initLightbox(signal: AbortSignal) {
    const dialog = document.getElementById('gw-lightbox') as HTMLDialogElement | null;
    const imageEl = document.getElementById('gw-image') as HTMLImageElement | null;
    const currentEl = document.getElementById('gw-current');
    const labelEl = document.getElementById('gw-label');
    const totalEl = document.getElementById('gw-total');
    const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery] .g-tile'));
    if (!dialog || !imageEl || !currentEl || tiles.length === 0) return;
    const frames = tiles.map((t) => t.querySelector('img')?.dataset.full ?? '');
    dialog.toggleAttribute('data-single', frames.length === 1);
    if (totalEl) totalEl.textContent = String(frames.length);

    let currentIndex = 0;
    const show = (idx: number) => {
      currentIndex = ((idx % frames.length) + frames.length) % frames.length;
      imageEl.style.animation = 'none';
      void imageEl.offsetHeight; // restart the fade-in
      imageEl.style.animation = '';
      imageEl.src = frames[currentIndex];
      imageEl.alt = tiles[currentIndex].querySelector('img')?.alt ?? '';
      currentEl.textContent = String(currentIndex + 1);
      if (labelEl) labelEl.textContent = `Кадър ${String(currentIndex + 1).padStart(2, '0')}`;
    };
    const open = (btn: HTMLButtonElement) => {
      show(Math.max(0, tiles.indexOf(btn)));
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };
    const close = () => dialog.close();

    tiles.forEach((btn) => btn.addEventListener('click', () => open(btn), { signal }));
    dialog.querySelector('[data-gw-close]')?.addEventListener('click', close, { signal });
    dialog.querySelector('[data-gw-prev]')?.addEventListener('click', () => show(currentIndex - 1), { signal });
    dialog.querySelector('[data-gw-next]')?.addEventListener('click', () => show(currentIndex + 1), { signal });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    }, { signal });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    }, { signal });
    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(currentIndex - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(currentIndex + 1); }
    }, { signal });
    signal.addEventListener('abort', () => {
      if (dialog.open) dialog.close();
      document.body.style.overflow = '';
    });
  }

  // ── Horizontal slider (6+ frames): arrows, scrubber, edge fades ──
  function initSlider(signal: AbortSignal) {
    const wall = document.querySelector<HTMLElement>('.gallery-wall[data-gallery]');
    const slider = wall?.closest<HTMLElement>('.gallery-slider');
    if (!wall || !slider) return;
    const prevBtn = slider.querySelector<HTMLElement>('[data-gallery-prev]');
    const nextBtn = slider.querySelector<HTMLElement>('[data-gallery-next]');
    const progressEl = document.querySelector<HTMLElement>('[data-gallery-progress]');
    const currentTileEl = document.querySelector<HTMLElement>('[data-gallery-current]');
    const tiles = Array.from(wall.querySelectorAll<HTMLElement>('.g-tile'));

    // Scroll by whole columns, about one view at a time.
    const tileStep = () => {
      const first = tiles[0];
      if (!first) return wall.clientWidth * 0.85;
      const w = first.getBoundingClientRect().width;
      const cols = Math.max(1, Math.floor(wall.clientWidth / w));
      return w * cols;
    };

    const updateState = () => {
      const max = wall.scrollWidth - wall.clientWidth;
      const x = wall.scrollLeft;
      const ratio = max > 0 ? x / max : 0;
      const atStart = x <= 2;
      const atEnd = x >= max - 2;
      slider.dataset.atStart = String(atStart);
      slider.dataset.atEnd = String(atEnd);
      prevBtn?.classList.toggle('is-disabled', atStart);
      nextBtn?.classList.toggle('is-disabled', atEnd);
      if (progressEl) progressEl.style.width = `${Math.max(6, ratio * 100)}%`;
      // Current tile = first one whose left edge is inside the view
      const wallRect = wall.getBoundingClientRect();
      let idx = 0;
      for (let i = 0; i < tiles.length; i++) {
        if (tiles[i].getBoundingClientRect().left - wallRect.left >= -8) { idx = i; break; }
      }
      if (currentTileEl) currentTileEl.textContent = String(idx + 1).padStart(2, '0');
    };

    prevBtn?.addEventListener('click', () => wall.scrollBy({ left: -tileStep(), behavior: 'smooth' }), { signal });
    nextBtn?.addEventListener('click', () => wall.scrollBy({ left: tileStep(), behavior: 'smooth' }), { signal });

    let raf = 0;
    wall.addEventListener('scroll', () => {
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; updateState(); });
    }, { passive: true, signal });
    window.addEventListener('resize', updateState, { signal });
    signal.addEventListener('abort', () => cancelAnimationFrame(raf));
    updateState();

    // Left/right arrows scroll the slider when it has focus
    wall.tabIndex = 0;
    wall.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); wall.scrollBy({ left: -tileStep(), behavior: 'smooth' }); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); wall.scrollBy({ left: tileStep(), behavior: 'smooth' }); }
    }, { signal });
  }

  function initProjectPage() {
    release();
    if (!document.querySelector('[data-gallery], iframe[data-map-src]')) return;
    const scope = new AbortController();
    pageScope = scope;
    initMaps(scope.signal);
    initLightbox(scope.signal);
    initSlider(scope.signal);
  }

  document.addEventListener('astro:page-load', initProjectPage);
  document.addEventListener('astro:before-swap', release);
</script>
