    padding: clamp(3.5rem, 8vh, 5.5rem) clamp(1.5rem, 8vw, 6rem);
  }
  #gw-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
