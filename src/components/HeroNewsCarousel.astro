---
interface Slide {
  code: string;
  label: string;
  title: string;
  body: string;
  image: string;
  href: string;
  accent: string;
}

const slides: Slide[] = [
  {
    code: 'ISO 9001',
    label: 'Качество',
    title: 'Управление на качеството',
    body: 'Сертифицирана система за строително-монтажни работи.',
    image: 'https://www.artstroismolian.com/sert/1.jpg',
    href: '/za-nas#certs-heading',
    accent: '№01',
  },
  {
    code: 'ISO 14001',
    label: 'Среда',
    title: 'Околна среда',
    body: 'Контрол върху въздействието на строителния процес.',
    image: 'https://www.artstroismolian.com/sert/2.jpg',
    href: '/za-nas#certs-heading',
    accent: '№02',
  },
  {
    code: 'ISO 45001',
    label: 'Безопасност',
    title: 'Здраве и безопасност',
    body: 'Система за оценка и управление на риска на обект.',
    image: 'https://www.artstroismolian.com/sert/3.jpg',
    href: '/za-nas#certs-heading',
    accent: '№03',
  },
  {
    code: 'ЦПРС',
    label: 'Регистър',
    title: 'Вписване в строителния регистър',
    body: 'Първа, втора, трета и четвърта група строежи.',
    image: 'https://www.artstroismolian.com/sert/4.jpg',
    href: '/za-nas#certs-heading',
    accent: 'I-IV',
  },
  {
    code: 'HSE',
    label: 'Политика',
    title: 'Декларация за ангажименти',
    body: 'Качество, околна среда, здраве и безопасност при работа.',
    image: 'https://www.artstroismolian.com/sert/8.jpg',
    href: '/za-nas#certs-heading',
    accent: 'DOC',
  },
];

const sealPoints = Array.from({ length: 72 }, (_, i) => {
  const angle = (Math.PI * 2 * i) / 72 - Math.PI / 2;
  const radius = i % 2 === 0 ? 48 : 43.5;
  const x = 50 + Math.cos(angle) * radius;
  const y = 50 + Math.sin(angle) * radius;
  return `${x.toFixed(2)},${y.toFixed(2)}`;
}).join(' ');
---

<div class="hero-news-card relative w-full max-w-[215px] sm:max-w-[290px] lg:max-w-[300px] xl:max-w-[320px] mx-auto" data-hero-news>
  <svg aria-hidden="true" class="absolute h-0 w-0 overflow-hidden">
    <filter id="cert-stamp-roughen">
      <feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.7" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <button
    type="button"
    data-hero-news-prev
    aria-label="Предишен слайд"
    class="hidden lg:grid absolute left-[-40px] top-[44%] -translate-y-1/2 z-40 h-10 w-10 place-items-center text-white/80 hover:text-white transition-colors"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="relative h-[235px] sm:h-[320px] lg:h-[340px]">
    {slides.map((s, i) => (
      <a
        href={s.href}
        data-hero-news-slide
        data-index={i}
        class="hero-news-slide group absolute inset-0 rounded-2xl bg-white text-ink-950 shadow-2xl overflow-hidden transition-all duration-[1300ms] ease-[cubic-bezier(0.34,1.45,0.64,1)] will-change-transform"
      >
        <div class="cert-card">
          <div class="cert-card__top">
            <span class="cert-card__label">{s.label}</span>
            <span class="cert-card__accent">{s.accent}</span>
          </div>
          <div class="cert-card__stage">
            <span class="cert-card__code">{s.code}</span>
            <span class="cert-card__seal" aria-hidden="true">
              <svg class="cert-card__seal-svg" viewBox="0 0 100 100" focusable="false">
                <defs>
                  <path id={`cert-stamp-top-${i}`} d="M 25 42 A 28 28 0 0 1 75 42" />
                  <path id={`cert-stamp-bottom-${i}`} d="M 24 60 A 29 29 0 0 0 76 60" />
                </defs>
                <polygon class="cert-card__seal-teeth" points={sealPoints} />
                <circle class="cert-card__seal-ring cert-card__seal-ring--outer" cx="50" cy="50" r="40" />
                <circle class="cert-card__seal-ring cert-card__seal-ring--inner" cx="50" cy="50" r="32" />
                <circle class="cert-card__seal-noise" cx="50" cy="50" r="39" />
                <text class="cert-card__seal-arc cert-card__seal-arc--top">
                  <textPath href={`#cert-stamp-top-${i}`} startOffset="50%" text-anchor="middle">АРТСТРОЙ ООД</textPath>
                </text>
                <text class="cert-card__seal-center" x="50" y="53" text-anchor="middle">АРТСТРОЙ</text>
                <path class="cert-card__seal-mark" d="M29 48h10l4-9h17l4 9h8M38 48l25 0M43 58h16" />
                <text class="cert-card__seal-arc cert-card__seal-arc--bottom">
                  <textPath href={`#cert-stamp-bottom-${i}`} startOffset="50%" text-anchor="middle">СЕРТИФИКАТ</textPath>
                </text>
              </svg>
            </span>
            <span class="cert-card__thumb">
              <img
                src={s.image}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
        <div class="absolute bottom-0 inset-x-0 flex items-center justify-end px-3.5 pb-3.5">
          <span
            aria-hidden="true"
            class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand/15 text-brand group-hover:bg-brand group-hover:text-white transition-colors duration-300"
          >
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
              <path d="M3.5 10.5L10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>

  <button
    type="button"
    data-hero-news-next
    aria-label="Следващ слайд"
    class="hidden lg:grid absolute right-[-40px] top-[44%] -translate-y-1/2 z-40 h-10 w-10 place-items-center text-white/80 hover:text-white transition-colors"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<style>
  .hero-news-slide {
    opacity: 0;
    transform: translateX(11%) scale(0.88);
    z-index: 10;
  }
  .cert-card {
    position: relative;
    min-height: 100%;
    padding: 1rem 1rem 4.25rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(248, 243, 234, 0.94)),
      radial-gradient(circle at 18% 16%, rgba(186, 45, 32, 0.12), transparent 32%);
  }
  .cert-card::before {
    content: '';
    position: absolute;
    inset: 0.7rem;
    border: 1px solid rgba(18, 22, 28, 0.08);
    pointer-events: none;
  }
  .cert-card::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.26;
    background-image:
      linear-gradient(rgba(18, 22, 28, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(18, 22, 28, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    mask-image: linear-gradient(180deg, black 0%, transparent 78%);
  }
  .cert-card__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .cert-card__label,
  .cert-card__accent {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1;
    text-transform: uppercase;
  }
  .cert-card__label {
    color: #ba2d20;
  }
  .cert-card__accent {
    color: rgba(18, 22, 28, 0.42);
    font-family: ui-monospace, "SFMono-Regular", monospace;
  }
  .cert-card__stage {
    position: relative;
    z-index: 2;
    min-height: 9.25rem;
    margin-top: 0.85rem;
  }
  .cert-card__code {
    position: absolute;
    left: 0;
    top: 0.25rem;
    z-index: 2;
    max-width: 10rem;
    color: #14171b;
    font-family: var(--font-display);
    font-size: clamp(2.55rem, 2.1rem + 1.2vw, 3.35rem);
    font-weight: 560;
    line-height: 0.86;
    letter-spacing: 0;
  }
  .cert-card__seal {
    position: absolute;
    left: 0.1rem;
    bottom: 0.25rem;
    z-index: 3;
    width: 3.55rem;
    height: 3.55rem;
    display: block;
    color: rgba(186, 45, 32, 0.80);
    transform: rotate(-10deg);
    opacity: 0.86;
  }
  .cert-card__seal-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    filter: url('#cert-stamp-roughen');
  }
  .cert-card__seal-teeth {
    fill: currentColor;
    fill-opacity: 0.24;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-opacity: 0.62;
  }
  .cert-card__seal-ring {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }
  .cert-card__seal-ring--outer {
    stroke-width: 4.7;
    stroke-opacity: 0.74;
  }
  .cert-card__seal-ring--inner {
    stroke-width: 2.15;
    stroke-opacity: 0.58;
  }
  .cert-card__seal-noise {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 0.9 5.4 2.2 7.8;
    stroke-opacity: 0.42;
  }
  .cert-card__seal-arc {
    fill: currentColor;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 7.2px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .cert-card__seal-arc--bottom {
    font-size: 6.8px;
    letter-spacing: 0.11em;
  }
  .cert-card__seal-center {
    fill: currentColor;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.025em;
  }
  .cert-card__seal-mark {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-opacity: 0.72;
  }
  .cert-card__thumb {
    position: absolute;
    right: -0.2rem;
    top: 0.15rem;
    z-index: 1;
    display: block;
    width: 7.25rem;
    aspect-ratio: 1 / 1.34;
    overflow: hidden;
    border: 1px solid rgba(18, 22, 28, 0.11);
    background: #fff;
    box-shadow: 0 1.2rem 2rem -1.2rem rgba(18, 22, 28, 0.45);
    transform: rotate(2.5deg);
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-news-slide:hover .cert-card__thumb {
    transform: rotate(0deg) translateY(-0.18rem) scale(1.03);
  }
  .cert-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: saturate(0.9) contrast(1.03);
  }
  .cert-card h3 {
    position: relative;
    z-index: 2;
    margin-top: 0.75rem;
    max-width: 15rem;
    color: #14171b;
    font-family: var(--font-display);
    font-size: 1.28rem;
    line-height: 1.02;
    letter-spacing: 0;
  }
  .cert-card p {
    position: relative;
    z-index: 2;
    margin-top: 0.55rem;
    max-width: 14.5rem;
    color: rgba(18, 22, 28, 0.62);
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .hero-news-slide[data-pos='active'] {
    opacity: 1;
    transform: translateX(0) scale(1);
    z-index: 30;
  }
  .hero-news-slide[data-pos='prev'] {
    opacity: 0.7;
    transform: translateX(-7%) scale(0.94);
    z-index: 20;
  }
  .hero-news-slide[data-pos='next'] {
    opacity: 0.7;
    transform: translateX(7%) scale(0.94);
    z-index: 20;
  }
  .hero-news-slide[data-pos='hidden-prev'] {
    opacity: 0;
    transform: translateX(-11%) scale(0.88);
    z-index: 10;
  }

  @media (max-width: 639px) {
    .cert-card {
      padding: 0.75rem 0.75rem 3.35rem;
    }
    .cert-card::before {
      inset: 0.55rem;
    }
    .cert-card__label,
    .cert-card__accent {
      font-size: 0.56rem;
    }
    .cert-card__stage {
      min-height: 6.75rem;
      margin-top: 0.65rem;
    }
    .cert-card__code {
      font-size: 1.95rem;
    }
    .cert-card__seal {
      width: 3.2rem;
      height: 3.2rem;
      bottom: -0.05rem;
    }
    .cert-card__thumb {
      width: 5.15rem;
      right: -0.05rem;
    }
    .cert-card h3 {
      margin-top: 0.45rem;
      max-width: 11rem;
      font-size: 0.96rem;
    }
    .cert-card p {
      margin-top: 0.38rem;
      max-width: 11rem;
      font-size: 0.67rem;
      line-height: 1.34;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 8500;

  function initHeroNewsCarousel() {
    const roots = document.querySelectorAll<HTMLElement>('[data-hero-news]');

    roots.forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-news-slide]'));
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-hero-news-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-news-next]');
      let active = 0;
      let paused = false;
      let timer: number | undefined;

      const positionOf = (i: number) => {
        const half = Math.floor(slides.length / 2);
        let diff = i - active;
        if (diff > half) diff -= slides.length;
        if (diff < -half) diff += slides.length;
        return diff;
      };

      const render = () => {
        slides.forEach((slide, i) => {
          const pos = positionOf(i);
          slide.tabIndex = pos === 0 ? 0 : -1;
          slide.setAttribute('aria-hidden', String(pos !== 0));
          if (pos === 0) slide.dataset.pos = 'active';
          else if (pos === -1) slide.dataset.pos = 'prev';
          else if (pos === 1) slide.dataset.pos = 'next';
          else if (pos < -1) slide.dataset.pos = 'hidden-prev';
          else slide.dataset.pos = 'hidden-next';

        });
      };

      const goTo = (i: number) => {
        active = ((i % slides.length) + slides.length) % slides.length;
        render();
      };

      const start = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        window.clearInterval(timer);
        timer = window.setInterval(() => {
          if (!paused) goTo(active + 1);
        }, AUTOPLAY_MS);
      };

      prevBtn?.addEventListener('click', () => goTo(active - 1));
      nextBtn?.addEventListener('click', () => goTo(active + 1));
      root.addEventListener('mouseenter', () => { paused = true; });
      root.addEventListener('mouseleave', () => { paused = false; });

      render();
      start();
    });
  }

  initHeroNewsCarousel();
  document.addEventListener('astro:page-load', initHeroNewsCarousel);
</script>
