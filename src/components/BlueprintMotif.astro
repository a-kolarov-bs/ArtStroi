---
// Architectural blueprint motifs — every variant uses real drafting conventions
// (double-line walls, door swings, hatching, dimension extension lines, north arrows,
// section markers). Brand-red accents applied via .bp-accent / .bp-accent-bright.
//
// Color via currentColor: the parent section sets the base stroke colour and
// opacity (e.g. text-white/[0.07]). Red accents stay at full brand colour.

interface Props {
  variant?:
    | 'elevation'        // simple front elevation (legacy)
    | 'multi-elevation'  // 6-storey façade with balconies + structural columns
    | 'plan'             // legacy basic plan
    | 'floor-plan'       // detailed residential plan with fixtures, doors, dims
    | 'apartment-plan'   // full multi-room apartment with furniture + extensive dim chains
    | 'site-plan'        // building footprint + parking + contour lines + north
    | 'structural'       // column/foundation section with rebar (red)
    | 'roof-framing'     // roof truss plan with ridge, hips, slope arrows
    | 'crane'
    | 'section'
    | 'detail';
  class?: string;
  ariaHidden?: boolean;
}

const { variant = 'elevation', class: className = '', ariaHidden = true } = Astro.props;
---

{variant === 'elevation' && (
  <svg viewBox="0 0 880 540" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} class:list={[className]}>
    <line x1="60" y1="50" x2="60" y2="38" />
    <line x1="820" y1="50" x2="820" y2="38" />
    <line x1="60" y1="44" x2="820" y2="44" stroke-dasharray="3 4" />
    <text x="440" y="32" text-anchor="middle" class="bp-text">28.50m</text>
    <path d="M 60 220 L 440 110 L 820 220" />
    <line x1="200" y1="180" x2="680" y2="180" stroke-dasharray="2 6" />
    <rect x="60" y="220" width="760" height="280" />
    <line x1="60" y1="290" x2="820" y2="290" />
    <line x1="60" y1="360" x2="820" y2="360" />
    <line x1="60" y1="430" x2="820" y2="430" />
    {Array.from({ length: 3 }).map((_, fi) => (
      Array.from({ length: 8 }).map((_, ci) => {
        const x = 90 + ci * 88;
        const y = 232 + fi * 70;
        return <rect x={x} y={y} width="58" height="44" />;
      })
    )).flat()}
    <rect x="90" y="442" width="120" height="58" />
    <rect x="222" y="442" width="120" height="58" />
    <rect x="372" y="442" width="74" height="58" />
    <rect x="458" y="442" width="120" height="58" />
    <rect x="590" y="442" width="120" height="58" />
    <line x1="40" y1="500" x2="840" y2="500" stroke-width="1.5" />
    <line x1="40" y1="510" x2="840" y2="510" stroke-dasharray="6 6" />
  </svg>
)}

{variant === 'multi-elevation' && (
  <svg viewBox="0 0 960 720" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="square" stroke-linejoin="miter" aria-hidden={ariaHidden} class:list={[className]}>
    {/* Top dimension extension lines */}
    <g stroke-width="0.6">
      <line x1="80" y1="80" x2="80" y2="50" />
      <line x1="900" y1="80" x2="900" y2="50" />
      <line x1="80" y1="60" x2="900" y2="60" stroke-dasharray="4 4" />
      <line x1="76" y1="50" x2="84" y2="50" />
      <line x1="896" y1="50" x2="904" y2="50" />
    </g>
    <text x="490" y="44" text-anchor="middle" class="bp-text">L = 32.80m</text>

    {/* Cornice + parapet */}
    <line x1="80" y1="80" x2="900" y2="80" stroke-width="1.6" />
    <line x1="80" y1="92" x2="900" y2="92" />

    {/* Outer walls */}
    <rect x="80" y="80" width="820" height="560" stroke-width="1.6" />

    {/* Floor slabs — 6 storeys */}
    {[170, 260, 350, 440, 530, 620].map((y) => (
      <line x1="80" y1={y} x2="900" y2={y} />
    ))}

    {/* Structural column verticals — drawn behind windows in BRAND RED to highlight load-bearing */}
    <g class="bp-accent">
      <line x1="220" y1="80" x2="220" y2="640" />
      <line x1="490" y1="80" x2="490" y2="640" />
      <line x1="760" y1="80" x2="760" y2="640" />
    </g>

    {/* Window grid — 6 floors × 9 bays, with one balcony per floor */}
    {Array.from({ length: 6 }).map((_, fi) => {
      const yT = 100 + fi * 90;
      const yB = yT + 56;
      return Array.from({ length: 9 }).map((_, ci) => {
        const x = 100 + ci * 92;
        return (
          <>
            <rect x={x} y={yT} width="68" height="56" />
            {/* sash mullion */}
            <line x1={x + 34} y1={yT} x2={x + 34} y2={yB} />
          </>
        );
      });
    }).flat()}

    {/* Recessed balconies — 1 per floor */}
    {Array.from({ length: 6 }).map((_, fi) => {
      const y = 100 + fi * 90;
      return (
        <>
          <rect x="372" y={y - 4} width="218" height="64" />
          <line x1="372" y1={y + 56} x2="590" y2={y + 56} stroke-dasharray="3 3" />
          <line x1="380" y1={y + 50} x2="582" y2={y + 50} stroke-width="0.6" />
        </>
      );
    })}

    {/* Ground floor — entrance + shopfronts */}
    <rect x="80" y="640" width="820" height="80" stroke-width="1.4" />
    <rect x="100" y="652" width="160" height="68" />
    <rect x="280" y="652" width="160" height="68" />
    <rect x="460" y="652" width="120" height="68" />
    <rect x="600" y="652" width="160" height="68" />
    <rect x="780" y="652" width="100" height="68" />
    {/* Entrance accent */}
    <g class="bp-accent-bright">
      <line x1="460" y1="640" x2="460" y2="720" />
      <line x1="580" y1="640" x2="580" y2="720" />
      <text x="520" y="635" text-anchor="middle" class="bp-text-accent">ENTRY</text>
    </g>

    {/* Foundation hatching */}
    <line x1="60" y1="720" x2="920" y2="720" stroke-width="1.6" />
    {Array.from({ length: 60 }).map((_, i) => (
      <line x1={60 + i * 14} y1="720" x2={50 + i * 14} y2="734" stroke-width="0.55" />
    ))}

    {/* Right side dimension stack — floor heights */}
    <g stroke-width="0.6">
      <line x1="922" y1="80" x2="940" y2="80" />
      <line x1="922" y1="170" x2="940" y2="170" />
      <line x1="922" y1="640" x2="940" y2="640" />
      <line x1="930" y1="80" x2="930" y2="170" stroke-dasharray="4 4" />
      <line x1="930" y1="170" x2="930" y2="640" stroke-dasharray="4 4" />
    </g>
    <text x="940" y="128" class="bp-text">3.20m</text>
    <text x="940" y="408" class="bp-text">17.00m</text>

    {/* Section marker — top left, brand red */}
    <g class="bp-accent-bright">
      <line x1="50" y1="80" x2="50" y2="640" stroke-dasharray="10 4 2 4" />
      <circle cx="50" cy="60" r="14" />
      <text x="50" y="65" text-anchor="middle" class="bp-text-accent">A1</text>
      <circle cx="50" cy="660" r="14" />
      <text x="50" y="665" text-anchor="middle" class="bp-text-accent">A1</text>
    </g>
  </svg>
)}

{variant === 'plan' && (
  <svg viewBox="0 0 720 480" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="square" stroke-linejoin="miter" aria-hidden={ariaHidden} class:list={[className]}>
    <rect x="60" y="60" width="600" height="360" stroke-width="1.6" />
    <line x1="60" y1="220" x2="380" y2="220" />
    <line x1="380" y1="60" x2="380" y2="420" />
    <line x1="380" y1="320" x2="660" y2="320" />
    <line x1="220" y1="220" x2="220" y2="420" />
    <path d="M 220 220 A 40 40 0 0 1 260 260" />
    <path d="M 380 320 A 40 40 0 0 1 420 360" />
    <path d="M 380 220 A 40 40 0 0 1 420 260" />
    <line x1="60" y1="40" x2="660" y2="40" stroke-dasharray="3 4" />
    <text x="360" y="28" text-anchor="middle" class="bp-text">15.00m</text>
    <g transform="translate(620, 80)">
      <circle r="22" />
      <path d="M 0 -16 L 6 8 L 0 4 L -6 8 Z" fill="currentColor" />
      <text y="-26" text-anchor="middle" class="bp-text">N</text>
    </g>
  </svg>
)}

{variant === 'floor-plan' && (
  <svg viewBox="0 0 880 600" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="square" stroke-linejoin="miter" aria-hidden={ariaHidden} class:list={[className]}>
    {/* Outer walls — double line for thickness */}
    <rect x="60" y="60" width="760" height="480" stroke-width="2" />
    <rect x="74" y="74" width="732" height="452" />

    {/* Interior partitions */}
    <line x1="380" y1="74" x2="380" y2="320" stroke-width="2" />
    <line x1="394" y1="88" x2="394" y2="306" />
    <line x1="380" y1="320" x2="806" y2="320" stroke-width="2" />
    <line x1="394" y1="334" x2="806" y2="334" />
    <line x1="220" y1="320" x2="220" y2="540" stroke-width="2" />
    <line x1="234" y1="334" x2="234" y2="540" />
    <line x1="600" y1="320" x2="600" y2="540" stroke-width="2" />

    {/* Door openings — break in wall + arc swing */}
    <line x1="180" y1="60" x2="240" y2="60" stroke-width="3" stroke="white" stroke-opacity="0" />
    <path d="M 220 380 A 60 60 0 0 1 280 440" stroke-dasharray="2 3" />
    <path d="M 380 240 A 50 50 0 0 0 430 290" stroke-dasharray="2 3" />
    <path d="M 600 380 A 50 50 0 0 1 650 430" stroke-dasharray="2 3" />

    {/* Window symbols — double thin line breaking outer wall */}
    {[
      [120, 60, 60], [260, 60, 80], [560, 60, 100], [700, 60, 80],
      [60, 160, 80], [60, 320, 80], [60, 460, 60],
    ].map(([x, y, w]) => {
      const isHorizontal = y === 60;
      return isHorizontal ? (
        <>
          <line x1={x} y1="64" x2={x + w} y2="64" stroke-width="0.6" />
          <line x1={x} y1="70" x2={x + w} y2="70" stroke-width="0.6" />
        </>
      ) : (
        <>
          <line x1="64" y1={y} x2="64" y2={y + w} stroke-width="0.6" />
          <line x1="70" y1={y} x2="70" y2={y + w} stroke-width="0.6" />
        </>
      );
    })}

    {/* Kitchen counters (top-left) */}
    <line x1="74" y1="74" x2="74" y2="220" stroke-dasharray="2 2" stroke-width="0.7" />
    <line x1="74" y1="220" x2="380" y2="220" stroke-dasharray="2 2" stroke-width="0.7" />
    <line x1="380" y1="74" x2="380" y2="220" stroke-dasharray="2 2" stroke-width="0.7" />
    <circle cx="160" cy="100" r="12" stroke-width="0.7" />
    <circle cx="220" cy="100" r="12" stroke-width="0.7" />
    <rect x="280" y="84" width="44" height="32" stroke-width="0.7" />

    {/* Bathroom fixtures (centre-right) */}
    <rect x="420" y="346" width="60" height="80" stroke-width="0.7" />
    <line x1="426" y1="354" x2="474" y2="420" stroke-width="0.4" stroke-dasharray="2 2" />
    <circle cx="510" cy="380" r="14" stroke-width="0.7" />
    <rect x="540" y="368" width="40" height="50" stroke-width="0.7" />
    <line x1="554" y1="380" x2="566" y2="380" stroke-width="0.4" />

    {/* Stairs (top-right) */}
    <rect x="660" y="84" width="146" height="220" />
    {Array.from({ length: 9 }).map((_, i) => (
      <line x1="660" y1={108 + i * 22} x2="806" y2={108 + i * 22} stroke-width="0.7" />
    ))}
    <path d="M 730 84 L 730 304" stroke-dasharray="3 3" stroke-width="0.6" />
    <path d="M 760 100 L 730 84 M 730 84 L 700 100" stroke-width="0.7" />

    {/* Centerline — brand red */}
    <g class="bp-accent">
      <line x1="440" y1="40" x2="440" y2="560" stroke-dasharray="10 4 2 4" />
    </g>

    {/* Structural columns — small filled squares in BRAND RED */}
    <g class="bp-fill-accent">
      <rect x="72" y="318" width="14" height="14" />
      <rect x="376" y="318" width="14" height="14" />
      <rect x="794" y="318" width="14" height="14" />
      <rect x="216" y="538" width="14" height="14" />
      <rect x="596" y="538" width="14" height="14" />
    </g>

    {/* Top dimension chain */}
    <g stroke-width="0.6">
      <line x1="60" y1="38" x2="60" y2="50" />
      <line x1="380" y1="38" x2="380" y2="50" />
      <line x1="820" y1="38" x2="820" y2="50" />
      <line x1="60" y1="44" x2="820" y2="44" stroke-dasharray="4 3" />
    </g>
    <text x="220" y="32" text-anchor="middle" class="bp-text">7.95m</text>
    <text x="600" y="32" text-anchor="middle" class="bp-text">9.05m</text>

    {/* Right dimension */}
    <g stroke-width="0.6">
      <line x1="836" y1="60" x2="848" y2="60" />
      <line x1="836" y1="540" x2="848" y2="540" />
      <line x1="842" y1="60" x2="842" y2="540" stroke-dasharray="4 3" />
    </g>
    <text x="864" y="304" text-anchor="middle" class="bp-text" transform="rotate(-90 864 304)">11.20m</text>

    {/* Room labels */}
    <text x="220" y="152" text-anchor="middle" class="bp-text">КУХНЯ · 16m²</text>
    <text x="220" y="280" text-anchor="middle" class="bp-text">ХОЛ · 28m²</text>
    <text x="120" y="430" text-anchor="middle" class="bp-text">СПАЛНЯ · 14m²</text>
    <text x="500" y="200" text-anchor="middle" class="bp-text">ТРАПЕЗАРИЯ</text>
    <text x="500" y="476" text-anchor="middle" class="bp-text">СПАЛНЯ · 16m²</text>
    <text x="700" y="476" text-anchor="middle" class="bp-text">КАБИНЕТ</text>
    <text x="500" y="466" class="bp-text-accent" text-anchor="middle"></text>

    {/* Floor scale label */}
    <g transform="translate(750, 580)">
      <text class="bp-text">1:50 · ETAGE 02</text>
    </g>

    {/* North arrow */}
    <g transform="translate(770, 110)">
      <circle r="22" />
      <path d="M 0 -14 L 5 6 L 0 3 L -5 6 Z" fill="currentColor" />
      <text y="-26" text-anchor="middle" class="bp-text">N</text>
    </g>
  </svg>
)}

{variant === 'apartment-plan' && (
  <svg viewBox="0 0 1600 1100" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="square" stroke-linejoin="miter" aria-hidden={ariaHidden} class:list={[className]}>
    {/* === OUTER STRUCTURAL WALLS — solid 16px-equivalent thickness === */}
    {/* Outer envelope */}
    <rect x="80" y="80" width="1440" height="940" stroke-width="2.4" />
    <rect x="96" y="96" width="1408" height="908" />

    {/* === INTERIOR PARTITIONS (double line for thickness) === */}
    {/* Antechamber (top-left) bottom edge */}
    <line x1="96" y1="280" x2="500" y2="280" stroke-width="2" />
    <line x1="96" y1="294" x2="500" y2="294" />
    {/* Bath 2 right wall */}
    <line x1="380" y1="96" x2="380" y2="280" stroke-width="2" />
    <line x1="394" y1="110" x2="394" y2="280" />
    {/* Corridor top edge / Bath 1 + Bedroom1 wall */}
    <line x1="500" y1="280" x2="1080" y2="280" stroke-width="2" />
    <line x1="500" y1="294" x2="1080" y2="294" />
    {/* Bedroom 1 left wall */}
    <line x1="1080" y1="96" x2="1080" y2="540" stroke-width="2" />
    <line x1="1066" y1="110" x2="1066" y2="540" />
    {/* Bath 1 left wall */}
    <line x1="800" y1="96" x2="800" y2="280" stroke-width="2" />
    <line x1="814" y1="110" x2="814" y2="280" />
    {/* Living/dining left wall */}
    <line x1="600" y1="540" x2="600" y2="1004" stroke-width="2" />
    <line x1="614" y1="540" x2="614" y2="1004" />
    {/* Living top wall */}
    <line x1="500" y1="540" x2="1504" y2="540" stroke-width="2" />
    <line x1="500" y1="554" x2="1504" y2="554" />
    {/* Bedroom 2 right wall */}
    <line x1="500" y1="540" x2="500" y2="1004" stroke-width="2" />
    <line x1="486" y1="554" x2="486" y2="1004" />
    {/* Corridor right wall */}
    <line x1="500" y1="294" x2="500" y2="540" stroke-width="2" />
    <line x1="486" y1="308" x2="486" y2="540" />
    {/* Antechamber/Bath 2 separator */}
    <line x1="220" y1="180" x2="380" y2="180" stroke-width="2" />
    <line x1="220" y1="194" x2="380" y2="194" />
    <line x1="220" y1="180" x2="220" y2="280" stroke-width="2" />
    <line x1="234" y1="180" x2="234" y2="280" />

    {/* === DOOR OPENINGS (gap in wall + arc swing) === */}
    {/* Front entry — top-left, brand red highlight */}
    <g class="bp-accent-bright">
      <line x1="180" y1="80" x2="270" y2="80" stroke-width="2.4" />
      <path d="M 180 96 A 90 90 0 0 1 270 186" stroke-dasharray="3 3" />
      <text x="225" y="68" text-anchor="middle" class="bp-text-accent">ENTRY</text>
    </g>
    {/* Antechamber → corridor */}
    <path d="M 380 200 A 60 60 0 0 1 440 260" stroke-dasharray="3 3" />
    {/* Corridor → bath 1 */}
    <path d="M 720 280 A 60 60 0 0 0 720 340" stroke-dasharray="3 3" />
    {/* Corridor → bedroom 1 */}
    <path d="M 1080 380 A 60 60 0 0 1 1140 440" stroke-dasharray="3 3" />
    {/* Corridor → living */}
    <path d="M 700 540 A 70 70 0 0 0 770 610" stroke-dasharray="3 3" />
    {/* Corridor → bedroom 2 */}
    <path d="M 360 540 A 60 60 0 0 1 420 600" stroke-dasharray="3 3" />

    {/* === WINDOWS (double thin line breaking outer wall) === */}
    {[
      // Top edge (Bath 1 + Bedroom 1)
      { x: 880, y: 80, w: 120, vertical: false },
      { x: 1180, y: 80, w: 220, vertical: false },
      // Right edge (Bedroom 1 + Living balcony)
      { x: 1504, y: 160, w: 140, vertical: true },
      { x: 1504, y: 720, w: 220, vertical: true },
      // Bottom edge (Living + Bedroom 2)
      { x: 800, y: 1004, w: 280, vertical: false },
      { x: 1200, y: 1004, w: 220, vertical: false },
      { x: 200, y: 1004, w: 220, vertical: false },
      // Left edge (Bedroom 2)
      { x: 80, y: 720, w: 200, vertical: true },
    ].map((w) => (
      w.vertical ? (
        <>
          <line x1={w.x === 80 ? 84 : 1500} y1={w.y} x2={w.x === 80 ? 84 : 1500} y2={w.y + w.w} stroke-width="0.6" />
          <line x1={w.x === 80 ? 92 : 1508} y1={w.y} x2={w.x === 80 ? 92 : 1508} y2={w.y + w.w} stroke-width="0.6" />
        </>
      ) : (
        <>
          <line x1={w.x} y1={w.y === 80 ? 84 : 1008} x2={w.x + w.w} y2={w.y === 80 ? 84 : 1008} stroke-width="0.6" />
          <line x1={w.x} y1={w.y === 80 ? 92 : 1016} x2={w.x + w.w} y2={w.y === 80 ? 92 : 1016} stroke-width="0.6" />
        </>
      )
    ))}

    {/* === FURNITURE === */}
    {/* Bedroom 1 — bed (queen, with two pillows) */}
    <rect x="1240" y="200" width="220" height="160" stroke-width="0.9" />
    <path d="M 1240 200 Q 1290 220, 1340 200" stroke-width="0.7" />
    <path d="M 1360 200 Q 1410 220, 1460 200" stroke-width="0.7" />
    {/* Wardrobe along corridor wall */}
    <rect x="1100" y="120" width="120" height="60" stroke-dasharray="3 3" stroke-width="0.7" />
    <line x1="1140" y1="120" x2="1140" y2="180" stroke-width="0.5" />
    <line x1="1180" y1="120" x2="1180" y2="180" stroke-width="0.5" />

    {/* Bath 1 — toilet + tub + basin */}
    <rect x="820" y="110" width="80" height="50" stroke-width="0.8" />
    <line x1="840" y1="135" x2="880" y2="135" stroke-width="0.6" />
    <ellipse cx="950" cy="160" rx="42" ry="22" stroke-width="0.8" />
    <rect x="900" y="190" width="160" height="80" stroke-width="0.9" />
    <ellipse cx="980" cy="230" rx="60" ry="30" stroke-width="0.6" stroke-dasharray="2 2" />

    {/* Bath 2 — toilet + basin */}
    <ellipse cx="160" cy="120" rx="32" ry="22" stroke-width="0.8" />
    <rect x="120" y="160" width="80" height="50" stroke-width="0.8" />
    <line x1="140" y1="185" x2="180" y2="185" stroke-width="0.6" />
    <rect x="240" y="110" width="120" height="60" stroke-width="0.6" stroke-dasharray="2 2" />

    {/* Antechamber — coat hooks + shoe storage */}
    <line x1="260" y1="200" x2="260" y2="260" stroke-width="0.6" />
    {Array.from({ length: 5 }).map((_, i) => (
      <circle cx="280" cy={210 + i * 12} r="2" fill="currentColor" stroke="none" />
    ))}
    <rect x="320" y="220" width="60" height="40" stroke-width="0.6" stroke-dasharray="2 2" />

    {/* Corridor — minimal */}

    {/* Bedroom 2 — bed (single) + desk */}
    <rect x="120" y="780" width="160" height="120" stroke-width="0.9" />
    <path d="M 120 780 Q 160 800, 200 780" stroke-width="0.7" />
