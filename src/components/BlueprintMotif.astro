    <line x1="80" y1="260" x2="640" y2="260" />
    {Array.from({ length: 8 }).map((_, i) => (
      <>
        <line x1={300 + i * 12} y1={140 - i * 7} x2={312 + i * 12} y2={140 - i * 7} />
        <line x1={312 + i * 12} y1={140 - i * 7} x2={312 + i * 12} y2={147 - i * 7} />
      </>
    ))}
    {Array.from({ length: 60 }).map((_, i) => (
      <line x1={i * 12} y1="320" x2={i * 12 + 8} y2="332" stroke-width="0.7" />
    ))}
    <g class="bp-accent-bright">
      {[110, 170, 230, 290].map((y, i) => (
        <>
          <circle cx="50" cy={y} r="11" />
          <text x="50" y={y + 4} text-anchor="middle" class="bp-text-accent">{i + 1}</text>
        </>
      ))}
    </g>
  </svg>
)}

{variant === 'detail' && (
  <svg viewBox="0 0 320 320" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} class:list={[className]}>
    <circle cx="160" cy="160" r="120" />
    <circle cx="160" cy="160" r="80" />
    <line x1="40" y1="160" x2="280" y2="160" stroke-dasharray="3 4" />
    <line x1="160" y1="40" x2="160" y2="280" stroke-dasharray="3 4" />
    <g class="bp-accent">
      <line x1="74" y1="74" x2="246" y2="246" stroke-dasharray="2 6" />
      <line x1="246" y1="74" x2="74" y2="246" stroke-dasharray="2 6" />
    </g>
    {Array.from({ length: 24 }).map((_, i) => {
      const a = (i * Math.PI) / 12;
      const x1 = 160 + Math.cos(a) * 120;
      const y1 = 160 + Math.sin(a) * 120;
      const x2 = 160 + Math.cos(a) * (i % 6 === 0 ? 100 : 110);
      const y2 = 160 + Math.sin(a) * (i % 6 === 0 ? 100 : 110);
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke-width="1.2" />;
    })}
    <text x="160" y="166" text-anchor="middle" class="bp-text">DETAIL · 1:50</text>
  </svg>
)}
