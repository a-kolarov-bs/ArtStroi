---
/**
 * Project mosaic — ПЛОЧИ II–N of the archival dossier.
 *
 * Editorial asymmetric grid that BREAKS the container to extend
 * viewport-edge to viewport-edge. Tiles carry tiny Roman plate
 * numbers (II, III, IV…) in their corners — they're documents in
 * the archive, not Pinterest pins.
 *
 * Lightbox: native <dialog> with keyboard nav (← →, ESC). No React.
 *
 * Layout breakpoints:
 *   - Mobile  (2 col) — first tile spans 2, hero plate
 *   - Tablet  (3 col) — adds occasional row-2 tall variants
 *   - Desktop (4 col) — full editorial mosaic with tall + wide variants
 */
interface Props {
  images: string[];
  title: string;
  /** Plate number of the first tile (defaults to 2 = "II", since Plate I is the cover) */
  startingPlate?: number;
}

const { images, title, startingPlate = 2 } = Astro.props;

function toRoman(n: number): string {
  if (n <= 0) return '';
  const map: [number, string][] = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
    [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'],
    [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let r = '';
  let v = n;
  for (const [val, sym] of map) {
    while (v >= val) { r += sym; v -= val; }
  }
  return r;
}

const lastPlate = toRoman(startingPlate + images.length - 1);
const firstPlate = toRoman(startingPlate);
---

<section class="mosaic-section relative bg-ink-950 py-20 md:py-28 overflow-hidden">

  <!-- ── Header band — sits within container ── -->
  <div class="container-page mb-12 md:mb-16">
    <div class="flex items-end justify-between gap-6 flex-wrap">
      <div class="flex items-center gap-5">
        <span class="font-display italic text-brand"
          style="font-variation-settings: 'opsz' 144; font-size: clamp(2.5rem, 1.5rem + 3vw, 4rem); line-height: 0.9;">
          §
        </span>
        <div>
          <p class="text-[0.6rem] uppercase tracking-[0.32em] font-medium text-brand">
            Плочи {firstPlate}–{lastPlate}
          </p>
          <h2
            class="mt-2 font-display text-white !leading-[1.05] max-w-[22ch]"
            style="font-variation-settings: 'opsz' 72; font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); letter-spacing: -0.02em;"
          >
            Кадри от обекта
          </h2>
        </div>
      </div>
      <div class="flex items-baseline gap-4 text-white/55 text-[0.6rem] uppercase tracking-[0.28em] font-medium">
        <span class="tabular-nums text-white/80">{String(images.length).padStart(2, '0')}</span>
        <span class="h-px w-8 bg-white/25"></span>
        <span>кадри</span>
      </div>
    </div>
  </div>

  <!-- ── Mosaic — BREAKS container, full viewport width ── -->
  <div class="mosaic-bleed">
    <div class="mosaic">
      {images.map((src, i) => {
        const plate = toRoman(startingPlate + i);
        return (
          <button
            type="button"
            class="mosaic-tile group relative block overflow-hidden bg-ink-900"
            data-lightbox-trigger
            data-index={i}
            aria-label={`Преглед на плоча ${plate} от ${lastPlate}`}
          >
            <img
              src={src}
              alt={`${title} — плоча ${plate}`}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out-expo group-hover:scale-[1.05]"
            />
            <!-- Soft wash on hover so the plate label always reads -->
            <div
              aria-hidden="true"
              class="absolute inset-0 bg-gradient-to-t from-ink-950/65 via-ink-950/10 to-ink-950/15 opacity-50 group-hover:opacity-100 transition-opacity duration-500"
            ></div>
            <!-- Plate number — sits bottom-left, archival -->
            <span
              class="plate-id absolute left-3 bottom-3 md:left-4 md:bottom-4 font-display italic text-white !leading-none select-none"
              aria-hidden="true"
              style="font-variation-settings: 'opsz' 24; font-size: clamp(0.8rem, 0.7rem + 0.5vw, 1rem);"
            >
              Плоча&nbsp;{plate}
            </span>
            <!-- Zoom badge — appears on hover, top-right -->
            <span
              aria-hidden="true"
              class="absolute right-3 top-3 md:right-4 md:top-4 grid place-items-center w-9 h-9 rounded-full bg-white/0 group-hover:bg-white/12 ring-0 group-hover:ring-1 ring-white/25 backdrop-blur-sm transition-all duration-500 -translate-y-1 group-hover:translate-y-0"
            >
              <svg width="11" height="11" viewBox="0 0 14 14" fill="none" class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <path d="M2 2h4M2 2v4M12 2H8M12 2v4M2 12h4M2 12v-4M12 12H8M12 12v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- ── Lightbox (native <dialog>) ── -->
  <dialog id="pm-lightbox" class="pm-lightbox" aria-label="Преглед на галерия">
    <div class="pm-lightbox-stage">
      <img id="pm-lightbox-image" alt="" />
    </div>

    <!-- Top bar: plate label (left) + close (right) -->
    <div class="pm-lightbox-topbar pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between p-5 md:p-7">
      <span id="pm-lightbox-plate"
        class="text-white/85 text-[0.65rem] uppercase tracking-[0.3em] font-medium pointer-events-auto"
      >Плоча {firstPlate}</span>
      <button
        type="button"
        class="pm-lightbox-btn pm-lightbox-close pointer-events-auto"
        data-lightbox-close
        aria-label="Затвори"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Side nav -->
    <button
      type="button"
      class="pm-lightbox-btn pm-lightbox-prev"
      data-lightbox-prev
      aria-label="Предишен кадър"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button
      type="button"
      class="pm-lightbox-btn pm-lightbox-next"
      data-lightbox-next
      aria-label="Следващ кадър"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="pm-lightbox-counter" aria-hidden="true">
      <span id="pm-lightbox-current" class="tabular-nums">1</span>
      <span class="opacity-40 mx-2">/</span>
      <span id="pm-lightbox-total" class="tabular-nums">{images.length}</span>
    </div>
  </dialog>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════
     Mosaic — BREAKS container.
     `100vw` + negative left margin pulls the wall out to the page
     edges, irrespective of container max-width. This is the dramatic
     mid-page moment — cream paper gives way to a wall of ink-950 and
     edge-to-edge documentary plates.
     ═══════════════════════════════════════════════════════════════ */
  .mosaic-bleed {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
    /* Tiny breathing strip at viewport edges so the wall doesn't look
       like it leaks out of frame */
    padding-inline: 4px;
  }
  @media (min-width: 768px) {
    .mosaic-bleed { padding-inline: 8px; }
  }
  @media (min-width: 1280px) {
    .mosaic-bleed { padding-inline: 16px; }
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(180px, auto);
    grid-auto-flow: dense;
    gap: 4px;
  }

  .mosaic-tile {
    grid-column: span 1;
    grid-row: span 1;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    /* Stagger: every 4th tile gets a slightly delayed reveal */
    animation: tile-in 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .mosaic-tile:nth-child(4n+2) { animation-delay: 100ms; }
  .mosaic-tile:nth-child(4n+3) { animation-delay: 180ms; }
  .mosaic-tile:nth-child(4n+4) { animation-delay: 260ms; }
  .mosaic-tile:focus-visible {
    outline: 2px solid #BA2D20;
    outline-offset: 3px;
    z-index: 1;
  }

  /* Mobile: first tile (Plate II) becomes wide hero */
  .mosaic-tile:nth-child(1) {
    grid-column: span 2;
    aspect-ratio: 16 / 10;
  }

  /* Tablet — 3 col, deliberate first-tile hero + one tall variant */
  @media (min-width: 768px) {
    .mosaic {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(220px, auto);
      gap: 6px;
    }
    .mosaic-tile { aspect-ratio: auto; }
    .mosaic-tile:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .mosaic-tile:nth-child(6n+4) { grid-row: span 2; }
  }

  /* Desktop — full editorial mosaic, 4 cols, varied spans */
  @media (min-width: 1024px) {
    .mosaic {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(230px, auto);
      gap: 8px;
    }
    .mosaic-tile:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .mosaic-tile:nth-child(7n+3) { grid-row: span 2; }
    .mosaic-tile:nth-child(7n+5) { grid-column: span 2; }
    .mosaic-tile:nth-child(7n+6) { grid-row: span 2; }
  }

  @media (min-width: 1600px) {
    .mosaic {
      grid-template-columns: repeat(5, 1fr);
      grid-auto-rows: minmax(260px, auto);
      gap: 10px;
    }
    /* Refresh spans for 5-col grid */
    .mosaic-tile:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .mosaic-tile:nth-child(7n+3) { grid-row: span 2; }
    .mosaic-tile:nth-child(7n+5) { grid-column: span 2; }
  }

  @keyframes tile-in {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Plate ID label — subtle text-shadow keeps it readable on bright photos */
  .plate-id {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    letter-spacing: 0.005em;
  }

  /* ═══════════════════════════════════════════════════════════════
     Lightbox — fullscreen native <dialog>, blurred backdrop.
     ═══════════════════════════════════════════════════════════════ */
  .pm-lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: white;
  }
  .pm-lightbox::backdrop {
    background: rgba(10, 12, 16, 0.97);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }
  .pm-lightbox[open] {
    animation: pm-fadein 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes pm-fadein {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .pm-lightbox-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(3.5rem, 8vh, 5.5rem) clamp(1.5rem, 8vw, 6rem);
  }

  #pm-lightbox-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    animation: pm-image-in 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes pm-image-in {
    from { opacity: 0; transform: scale(0.98); }
    to   { opacity: 1; transform: scale(1); }
  }

  .pm-lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: white;
    cursor: pointer;
    transition: background 280ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .pm-lightbox-btn:hover {
    background: #BA2D20;
    border-color: #BA2D20;
  }
  .pm-lightbox-close {
    position: static; /* lives in topbar flex */
  }
  .pm-lightbox-prev {
    left: clamp(0.75rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .pm-lightbox-next {
    right: clamp(0.75rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .pm-lightbox-prev:hover { transform: translateY(-50%) scale(1.06); }
  .pm-lightbox-next:hover { transform: translateY(-50%) scale(1.06); }
  .pm-lightbox-close:hover { transform: scale(1.06); }

  .pm-lightbox-counter {
    position: absolute;
    bottom: clamp(1rem, 3vh, 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-variant-numeric: tabular-nums;
  }

  .pm-lightbox[data-single] .pm-lightbox-prev,
  .pm-lightbox[data-single] .pm-lightbox-next,
  .pm-lightbox[data-single] .pm-lightbox-counter { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .mosaic-tile { animation: none !important; transform: none !important; }
    .mosaic-tile img { transition: none !important; }
    .pm-lightbox[open] { animation: none; }
    #pm-lightbox-image { animation: none; }
    .pm-lightbox-btn { transition: none; }
  }
</style>

<script define:vars={{ images, startingPlate }}>
  const dialog = document.getElementById('pm-lightbox');
  const imageEl = document.getElementById('pm-lightbox-image');
  const currentEl = document.getElementById('pm-lightbox-current');
  const plateEl = document.getElementById('pm-lightbox-plate');

  function toRoman(n) {
    if (n <= 0) return '';
    const map = [
      [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
      [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'],
      [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
    ];
    let r = '', v = n;
    for (const [val, sym] of map) {
      while (v >= val) { r += sym; v -= val; }
    }
    return r;
  }

  if (dialog && imageEl && currentEl && images.length > 0) {
    if (images.length === 1) dialog.setAttribute('data-single', '');

    let currentIndex = 0;

    const show = (idx) => {
      currentIndex = ((idx % images.length) + images.length) % images.length;
      imageEl.style.animation = 'none';
      imageEl.offsetHeight;
      imageEl.style.animation = '';
      imageEl.src = images[currentIndex];
      currentEl.textContent = String(currentIndex + 1);
      if (plateEl) plateEl.textContent = `Плоча ${toRoman(startingPlate + currentIndex)}`;
    };

    const open = (idx) => {
      show(idx);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };

    const close = () => dialog.close();

    document.querySelectorAll('[data-lightbox-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.getAttribute('data-index'))));
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(currentIndex - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(currentIndex + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(currentIndex - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(currentIndex + 1); }
    });
  }
</script>
