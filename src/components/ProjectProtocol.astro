---
/**
 * ПРОТОКОЛ — thin dark editorial proof band on /proekti/[slug].
 *
 * Sits between hero (description + meta + map) and gallery. Acts as
 * the page's "act II card": dark interruption between two cream-toned
 * editorial sections, signalling a shift from narrative to evidence.
 *
 * Visual reference: architect's technical specification sheet on
 * blueprint paper. Faint graph-paper grid background, large Fraunces
 * numerals, monospace document references, a single faded brand-red
 * "✓ ПРИЕТ" stamp anchor off-axis.
 *
 * Falls back to nothing when project has no protocol data.
 */
import type { ProjectProtocol } from '../data/projects';

interface Props {
  protocol: ProjectProtocol;
  number: string;
  total: string;
}

const { protocol, number, total } = Astro.props;
---

<section class="proj-protocol relative isolate overflow-hidden bg-ink-950 text-cream-50">
  <!-- Graph-paper grid wash -->
  <span aria-hidden="true" class="pp-grid pointer-events-none absolute inset-0 -z-0"></span>
  <!-- Inner glow at top + bottom to softens hard edges -->
  <span aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-black/40 to-transparent -z-0"></span>
  <span aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-black/40 to-transparent -z-0"></span>

  <!-- "✓ ПРИЕТ" stamp anchor — bottom-right corner, off-axis -->
  <span aria-hidden="true" class="pp-stamp pointer-events-none absolute right-4 md:right-8 bottom-3 md:bottom-4 z-0">
    <svg viewBox="0 0 140 140" width="100%" height="100%" fill="none">
      <circle cx="70" cy="70" r="64" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" />
      <circle cx="70" cy="70" r="54" stroke="currentColor" stroke-width="1" />
      <text x="70" y="60" text-anchor="middle" fill="currentColor" font-size="13" font-weight="800" letter-spacing="3">
        АРТСТРОЙ
      </text>
      <text x="70" y="78" text-anchor="middle" fill="currentColor" font-size="20" font-weight="900" letter-spacing="4">
        ПРИЕТ
      </text>
      <text x="70" y="94" text-anchor="middle" fill="currentColor" font-size="9" font-weight="600" letter-spacing="2.5">
        Nº {number}
      </text>
    </svg>
  </span>

  <div class="container-page relative z-10 py-6 md:py-8">

    <!-- Section heading for SEO + a11y; eyebrow below carries the visual weight -->
    <h2 class="sr-only">Технически параметри на проекта</h2>

    <!-- Eyebrow row — protocol header -->
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <p class="pp-eyebrow inline-flex items-center gap-2.5">
        <span aria-hidden="true" class="text-brand">◢</span>
        <span>ПРОТОКОЛ Nº {number} / {total}</span>
      </p>
      <p class="pp-eyebrow text-cream-50/55">АРТСТРОЙ ООД · от 1992</p>
    </div>

    <!-- Big metrics row -->
    <div class="mt-6 md:mt-8 grid grid-cols-3 gap-x-4 md:gap-x-8 gap-y-8" data-pp-metrics>
      {protocol.metrics.map((m, i) => (
        <div class="pp-metric" style={`--i: ${i};`}>
          <div class="pp-metric-value font-display tabular-nums" data-pp-target={m.value}>
            {m.value}
          </div>
          <div class="pp-metric-label">
            <span>{m.label}</span>
            {m.sublabel && <span class="pp-metric-sublabel">· {m.sublabel}</span>}
          </div>
        </div>
      ))}
    </div>

    <!-- Brand-red hairline divider -->
    <div class="mt-6 md:mt-8 relative h-px bg-cream-50/12">
      <span aria-hidden="true" class="absolute left-0 top-0 h-px w-24 md:w-40 bg-brand"></span>
    </div>

    <!-- Records — compact inline row -->
    <div class="mt-4 md:mt-5 flex flex-wrap gap-x-8 md:gap-x-14 gap-y-4">
      {protocol.records.map((r, i) => (
        <div class="pp-record" style={`--i: ${i};`}>
          <p class="pp-record-label">
            <span aria-hidden="true" class="pp-record-dot"></span>
            {r.label}
          </p>
          <p class="pp-record-value">{r.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Graph paper grid — extremely subtle, like blueprint reference paper ── */
  .pp-grid {
    background-image:
      linear-gradient(to right, rgba(247, 240, 226, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(247, 240, 226, 0.045) 1px, transparent 1px),
      linear-gradient(to right, rgba(247, 240, 226, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(247, 240, 226, 0.07) 1px, transparent 1px);
    background-size: 24px 24px, 24px 24px, 120px 120px, 120px 120px;
    background-position: 0 0;
    /* Soft radial fade so the grid feels like ambient texture, not a hard pattern */
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 30%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 30%, transparent 95%);
  }

  /* ── ПРИЕТ stamp — hidden below sm to avoid overlap with stacked records ── */
  .pp-stamp {
    width: clamp(72px, 8vw, 110px);
    height: clamp(72px, 8vw, 110px);
    color: rgba(186, 45, 32, 0.42);
    transform: rotate(-7deg);
    filter: blur(0.2px);
    animation: pp-stamp-in 1100ms cubic-bezier(0.16, 1, 0.3, 1) 700ms both;
    display: none;
  }
  @media (min-width: 640px) {
    .pp-stamp { display: block; }
  }
  @keyframes pp-stamp-in {
    from {
      opacity: 0;
      transform: rotate(8deg) scale(1.4);
    }
    to {
      opacity: 1;
      transform: rotate(-7deg) scale(1);
    }
  }

  /* ── Eyebrows — monospace, document-grade ── */
  .pp-eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    color: rgba(247, 240, 226, 0.85);
  }

  /* ── Metric — the three big numerical callouts ── */
  .pp-metric {
    position: relative;
  }
  .pp-metric-value {
    font-variation-settings: 'opsz' 144;
    font-size: clamp(2.2rem, 1.4rem + 2.6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #FAF3EA;
    font-weight: 400;
    font-feature-settings: 'tnum', 'lnum';
    text-wrap: nowrap;
  }
  .pp-metric-label {
    margin-top: 0.6rem;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 500;
    color: rgba(247, 240, 226, 0.62);
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .pp-metric-sublabel {
    color: rgba(247, 240, 226, 0.4);
  }

  /* ── Record — small monospaced document refs ── */
  .pp-record {
    position: relative;
    animation: pp-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i, 0) * 80ms + 450ms);
  }
  .pp-record-label {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-weight: 600;
    color: rgba(186, 45, 32, 0.95);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.5rem;
  }
  .pp-record-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: #BA2D20;
    border-radius: 999px;
  }
  .pp-record-value {
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
    font-variation-settings: 'opsz' 24;
    font-size: 0.98rem;
    line-height: 1.3;
    color: rgba(247, 240, 226, 0.95);
    letter-spacing: -0.005em;
    font-feature-settings: 'tnum', 'lnum';
  }

  @keyframes pp-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .pp-record, .pp-stamp {
      animation: none !important;
      transform: rotate(-7deg) !important; /* keeps stamp tilt without motion */
      opacity: 1 !important;
    }
    .pp-stamp { transform: rotate(-7deg) !important; }
  }
</style>

<script>
  // ── Number count-up — mirrors StatsCounter.tsx behaviour ──
  // easeOutExpo timing, 2800ms duration, 180ms stagger between metrics,
  // IntersectionObserver threshold 0.4, honours prefers-reduced-motion.
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

  // Format with thin-space thousands separator (Bulgarian typography).
  // toLocaleString('bg-BG') skips the separator for 4-digit numbers; we
  // want it on 2 400 for parity with the static value in the data.
  const formatNum = (n: number) =>
    n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');

  const sections = document.querySelectorAll<HTMLElement>('.proj-protocol');
  for (const section of sections) {
    const valueEls = section.querySelectorAll<HTMLElement>('[data-pp-target]');
    if (valueEls.length === 0) continue;

    // Parse targets; non-numeric values stay as-is.
    const items = Array.from(valueEls)
      .map((el) => {
        const raw = el.getAttribute('data-pp-target') ?? el.textContent ?? '';
        const target = parseInt(raw.replace(/\D/g, ''), 10);
        return { el, target };
      })
      .filter((x) => Number.isFinite(x.target));

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) continue; // leave final value visible, skip animation

    // Reset to 0 so the count animates from the start.
    for (const { el } of items) {
      el.textContent = '0';
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          items.forEach(({ el, target }, i) => animateCount(el, target, i * 180));
          io.disconnect();
        }
      },
      { threshold: 0.4 }
    );
    io.observe(section);
  }

  function animateCount(el: HTMLElement, target: number, delay: number) {
    const duration = 2800;
    const start = performance.now() + delay;
    function tick(now: number) {
      const t = Math.max(0, (now - start) / duration);
      const v = Math.min(1, t);
      const n = Math.round(target * easeOutExpo(v));
      el.textContent = formatNum(n);
      if (v < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
