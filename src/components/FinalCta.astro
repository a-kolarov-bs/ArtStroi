---
import Reveal from './Reveal.astro';
---

<section class="relative isolate overflow-hidden bg-cream-100 text-ink-900" aria-labelledby="cta-heading">
  <!-- Brand-red separator line at top, mirroring the legacy site style -->
  <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-brand"></span>

  <!-- Architectural sheet — back layer -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet"></div>

  <!-- Decorative oversized italic year, very faint -->
  <span
    aria-hidden="true"
    class="absolute -left-8 -top-10 select-none font-display italic text-ink-900/[0.06] leading-none pointer-events-none"
    style="font-size: clamp(12rem, 22vw, 28rem); font-variation-settings:'opsz' 144,'SOFT' 100;"
  >
    1992
  </span>

  <div class="container-page relative py-28 md:py-40">
    <Reveal class="max-w-4xl">
      <p class="eyebrow">Започни проект · Get in touch</p>
      <h2
        id="cta-heading"
        class="mt-6 font-display leading-[1.02] tracking-[-0.025em] text-balance text-ink-950"
        style="font-size: clamp(2.25rem, 1rem + 5vw, 5.75rem);"
      >
        Заедно строим <br/>
        <span class="italic text-brand" style="font-variation-settings:'opsz' 144,'SOFT' 100;">следващия знак</span>.
      </h2>
      <p class="mt-8 max-w-lg text-base md:text-lg text-ink-900/75 leading-[1.65]">
        Готови сме да обсъдим вашия проект — общинска инвестиция, частен жилищен комплекс, хотел или реконструкция. Първа консултация без ангажимент.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/kontakti" class="btn-brand">
          Получи оферта
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="tel:+359878715936" class="btn-ghost-dark">
          +359 878 715 936
        </a>
      </div>
    </Reveal>
  </div>
</section>
