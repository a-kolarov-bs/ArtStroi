---
// Services on the home page: heading and the six services on the left,
// one looping site video on the right. A plain grid, no scroll pinning,
// so the section reads in one screen on desktop (round 1, plan 5 row 1).
import Reveal from './Reveal.astro';
import { services } from '../data/services';

const videoMobile = '/services/sample-mobile.mp4';
const videoDesktop = '/services/sample-desktop.mp4';
const videoPoster = '/services/sample-poster.jpg';

---

<section class="cap-section relative isolate overflow-clip bg-cream-100 text-ink-900 py-16 md:py-20 lg:py-24" aria-labelledby="capabilities-heading">
  <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand to-transparent opacity-60"></span>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-b"></div>

  <!-- Phones/tablets: heading, video, list. Desktop: heading and list on
       the left, the video beside them on the right. -->
  <div class="container-page relative grid gap-y-8 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-0">
      <Reveal class="row-start-1 lg:col-span-7 lg:col-start-1">
        <p class="eyebrow flex items-center gap-3">
          <span aria-hidden="true" class="inline-block h-px w-8 bg-brand"></span>
          Услуги
        </p>
        <h2
          id="capabilities-heading"
          class="mt-5 font-display text-display-md text-ink-950"
        >
          Какво <span class="text-brand">строим</span>.
        </h2>
        <p class="mt-4 max-w-xl text-base md:text-lg text-ink-900/80 leading-[1.6]">
          Шест направления, в които работим за частни инвеститори и обществени
          възложители.
        </p>
      </Reveal>

    <div class="row-start-3 lg:col-span-7 lg:col-start-1 lg:row-start-2 lg:mt-10">
      <ol class="cap-list grid gap-x-10 sm:grid-cols-2">
        {services.map((s, i) => (
          <Reveal as="li" delay={(i % 2) * 80}>
            <div class="cap-item">
              <span class="cap-item__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="cap-item__title">{s.title}</h3>
                <p class="cap-item__body">{s.short}</p>
              </div>
            </div>
          </Reveal>
        ))}
      </ol>

      <a href="/uslugi" class="btn-ghost-dark mt-8">
        Вижте всички услуги
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="row-start-2 lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:row-span-2">
      <div class="cap-media">
        <video
          class="cap-video"
          data-motion-video
          muted
          loop
          playsinline
          preload="metadata"
          poster={videoPoster}
          aria-hidden="true"
        >
          <source src={videoMobile} type="video/mp4" media="(max-width: 767px)" />
          <source src={videoDesktop} type="video/mp4" />
        </video>
        <span aria-hidden="true" class="cap-scrim"></span>
      </div>
    </div>
  </div>

  <style>
    .cap-item {
      display: grid;
      grid-template-columns: 2.75rem 1fr;
      gap: 0.75rem;
      padding-block: 1.1rem 1.25rem;
      border-top: 1px solid rgba(186, 45, 32, 0.22);
    }
    .cap-item__num {
      font-family: var(--font-display);
      font-size: 1.6rem;
      line-height: 1.05;
      color: #BA2D20;
    }
    .cap-item__title {
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 1.15rem + 0.5vw, 1.65rem);
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: #12161C;
    }
    .cap-item__body {
      margin-top: 0.4rem;
      font-size: 15px;
      line-height: 1.5;
      color: rgba(18, 22, 28, 0.72);
    }

    .cap-media {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 14px;
      overflow: hidden;
      isolation: isolate;
      background: #1A1F26;
      box-shadow: 0 24px 50px -22px rgba(28, 22, 20, 0.28);
    }
    @media (min-width: 1024px) {
      /* Same height as the heading + list column beside it. */
      .cap-media {
        aspect-ratio: auto;
        height: 100%;
        min-height: 28rem;
      }
    }
    .cap-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .cap-scrim {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        rgba(18, 22, 28, 0.2) 0%,
        rgba(18, 22, 28, 0.1) 40%,
        rgba(18, 22, 28, 0.5) 100%
      );
    }
  </style>

  <script>
    import { initMotionVideos } from '../scripts/motion-video';
    // The services video stays on its poster under reduced motion.
    initMotionVideos();
    document.addEventListener('astro:page-load', initMotionVideos);
  </script>
</section>
