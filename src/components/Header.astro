---
// Sticky transparent-over-hero header. NO top investment buttons (per CLAUDE.md).
// Layout by width (grid 1fr auto 1fr, the middle item is centred):
//   < 1024  menu chip · logo · call chip
//   ≥ 1024  logo · five links · manager's number with a handset icon
// The menu panel (< 1024) carries the links plus „Обадете се“.
// No „get a quote“ button anywhere: the site is informational (26.11.2026).
import { phone, telHref } from '../data/company';

const nav = [
  { href: '/', label: 'Начало' },
  { href: '/uslugi', label: 'Услуги' },
  { href: '/proekti', label: 'Проекти' },
  { href: '/za-nas', label: 'За нас' },
  { href: '/kontakti', label: 'Контакти' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const manager = phone('Управител');
const managerTel = telHref(manager.number);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 transition-colors duration-400 ease-out-expo"
  data-state="top"
>
  <span class="menu-scrim" aria-hidden="true" data-menu-scrim></span>

  <!-- One three-column bar at every width, so the middle item is always
       centred on the screen:
         < 1024  menu chip · logo · call chip
         ≥ 1024  logo · five links · manager's number
       DOM order follows the visual order (Tab goes left to right), and the
       menu panel follows its toggle so Tab moves straight into it. -->
  <div class="container-page grid h-20 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 md:gap-4 lg:gap-6">
    <div class="col-start-1 row-start-1 justify-self-start lg:hidden">
      <button
        type="button"
        class="header-chip grid"
        aria-label="Отворете менюто"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <span class="mobile-menu-button__lines" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <nav
        id="mobile-menu"
        class="mobile-menu"
        aria-label="Мобилна навигация"
        aria-hidden="true"
        data-mobile-menu
        inert
      >
        {nav.map((item) => (
          <a
            href={item.href}
            class="mobile-menu__link"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            data-mobile-menu-link
          >
            <span>{item.label}</span>
            <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}

        <div class="mobile-menu__actions">
          <a href={managerTel} class="btn-brand w-full justify-between" data-mobile-menu-link>
            <span>Обадете се</span>
            <span class="tabular-nums">{manager.number}</span>
          </a>
          <p class="mobile-menu__note">Управител · пон.–пет. 9:00–18:00</p>
        </div>
      </nav>
    </div>

    <a
      href="/"
      class="site-logo group col-start-2 row-start-1 flex items-center justify-self-center transition-transform duration-400 hover:scale-[1.02] focus:outline-none focus-visible:outline-none lg:col-start-1 lg:justify-self-start"
      aria-label="АРТСТРОЙ ООД, начало"
    >
      <img
        src="/brand/logo-original.webp"
        alt="АРТСТРОЙ ООД"
        width="478"
        height="112"
        class="site-logo__img site-logo__img--light h-9 md:h-10 w-auto"
        decoding="async"
      />
      <img
        src="/brand/logo-dark.webp"
        alt=""
        width="478"
        height="112"
        class="site-logo__img site-logo__img--dark absolute inset-0 h-9 md:h-10 w-auto"
        decoding="async"
        aria-hidden="true"
      />
    </a>

    <nav class="col-start-2 row-start-1 hidden items-center gap-1 lg:flex" aria-label="Главна навигация">
      {nav.map((item) => (
        <a
          href={item.href}
          class="site-nav-link text-ink [--ink:0.03em] rounded-full px-4 py-2 text-[15px] transition-colors duration-300"
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          data-nav-link
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- The manager's number: a round chip on phones, the number itself from
         1024. A line-drawn handset, not an emoji (emoji differ per device). -->
    <a
      href={managerTel}
      class="header-chip header-call col-start-3 row-start-1 grid justify-self-end"
      aria-label={`Обадете се на управителя, ${manager.number}`}
      data-header-call
    >
      <span class="header-call__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M5.2 3.5h3.1l1.6 4.1-2.1 1.3a11.4 11.4 0 0 0 7.3 7.3l1.3-2.1 4.1 1.6v3.1a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="header-call__number">{manager.number}</span>
    </a>
  </div>

  <!-- Top brand progress bar, fills with scroll -->
  <div class="absolute inset-x-0 top-0 h-[2px] bg-white/10">
    <div id="scroll-progress" class="h-full w-0 bg-brand origin-left transition-[width] duration-100 ease-linear"></div>
  </div>
</header>

<style is:global>
  /* ── Bar behind the header ─────────────────────────────────────────
     Scrolled past the hero, or on a page with body.has-solid-header,
     the header gets a bar; its material follows the tone below. */
  #site-header[data-state='scrolled'],
  body.has-solid-header #site-header {
    background-color: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid rgb(0 0 0 / 0.06);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.72) inset,
      0 18px 46px -34px rgb(18 22 28 / 0.42),
      0 6px 18px -16px rgb(18 22 28 / 0.26);
  }

  #site-header[data-tone='dark'] {
    background-color: transparent;
    border-bottom-color: transparent;
  }

  body.has-solid-header #site-header[data-tone='dark'],
  #site-header[data-state='scrolled'][data-tone='dark'] {
    background-color: rgb(18 22 28 / 0.18);
    backdrop-filter: saturate(145%) blur(10px);
    -webkit-backdrop-filter: saturate(145%) blur(10px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.08) inset,
      0 20px 50px -34px rgb(0 0 0 / 0.62),
      0 8px 22px -18px rgb(0 0 0 / 0.42);
  }

  body.has-solid-header #site-header[data-tone='light'],
  #site-header[data-state='scrolled'][data-tone='light'] {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.60), rgba(247, 244, 238, 0.38)),
      rgba(226, 219, 207, 0.34);
    backdrop-filter: blur(20px) saturate(178%);
    -webkit-backdrop-filter: blur(20px) saturate(178%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.58);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.98),
      inset 0 8px 16px -10px rgba(255, 255, 255, 0.58),
      inset 0 -1px 0 rgba(18, 22, 28, 0.045),
      0 22px 54px -36px rgba(18, 22, 28, 0.34),
      0 8px 22px -18px rgba(18, 22, 28, 0.20);
  }

  /* ── Tone → colours of the links ─────────────────────────────────────
     The tone (set by the script from what is behind the logo) only sets
     these variables. The links read them in exactly one rule
     each, and :hover is one rule on top, so no tone selector can outrank
     the hover state. Before the script runs there is no data-tone:
     a solid-header page starts light, every other page starts dark. */
  #site-header {
    --hdr-link: rgb(255 255 255 / 0.86);
    --hdr-link-hover: #fff;
    --hdr-link-hover-bg: rgb(255 255 255 / 0.10);
  }

  #site-header[data-tone='light'],
  body.has-solid-header #site-header:not([data-tone]) {
    --hdr-link: theme('colors.ink.900');
    --hdr-link-hover: theme('colors.ink.950');
    --hdr-link-hover-bg: rgb(18 22 28 / 0.07);
  }

  #site-header [data-nav-link] {
    position: relative;
    color: var(--hdr-link);
  }
  #site-header [data-nav-link]:hover {
    color: var(--hdr-link-hover);
    background-color: var(--hdr-link-hover-bg);
  }
  /* Current page: full-strength text and a short red rule under the label. */
  #site-header [data-nav-link][aria-current='page'] {
    color: var(--hdr-link-hover);
  }
  #site-header [data-nav-link][aria-current='page']::after {
    content: '';
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: theme('colors.brand.DEFAULT');
  }


  /* ── Round chips (call, menu): dark glass, readable on any surface ── */
  .header-chip {
    position: relative;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    color: #fff;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.06)),
      rgba(18, 22, 28, 0.66);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.76),
      inset 0 10px 16px -10px rgba(255, 255, 255, 0.46),
      inset 0 -1px 0 rgba(0, 0, 0, 0.16),
      0 12px 28px -14px rgba(18, 22, 28, 0.80),
      0 0 0 1px rgba(18, 22, 28, 0.10);
    transition:
      background-color 300ms theme('transitionTimingFunction.out-expo'),
      border-color 300ms theme('transitionTimingFunction.out-expo');
  }
  .header-chip:hover {
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08)),
      rgba(18, 22, 28, 0.78);
    border-color: rgba(255, 255, 255, 0.50);
  }
  /* ── Call: same neutral glass chip as the menu below 1024 (no red),
     the manager's number in the link colour from 1024. ─────────────── */
  .header-call__icon {
    display: grid;
    place-items: center;
  }
  .header-call__number {
    display: none;
  }

  @media (min-width: 1024px) {
    #site-header .header-call {
      display: inline-flex;
      width: auto;
      height: 2.75rem;
      align-items: center;
      gap: 0.7rem;
      border: 0;
      padding: 0 0.35rem 0 0;
      color: var(--hdr-link);
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transition: color 300ms theme('transitionTimingFunction.out-expo');
    }
    #site-header .header-call:hover {
      color: var(--hdr-link-hover);
      background: none;
    }
    .header-call__icon {
      width: 2.25rem;
      height: 2.25rem;
      border: 1px solid currentColor;
      border-color: color-mix(in srgb, currentColor 38%, transparent);
      border-radius: 999px;
      transition:
        background-color 300ms theme('transitionTimingFunction.out-expo'),
        border-color 300ms theme('transitionTimingFunction.out-expo');
    }
    .header-call__icon svg {
      width: 16px;
      height: 16px;
    }
    .header-call:hover .header-call__icon {
      border-color: currentColor;
      background-color: var(--hdr-link-hover-bg);
    }
    .header-call__number {
      display: inline;
      font-size: 15px;
      letter-spacing: 0.02em;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
  }

  /* ── Logo: light and dark versions cross-fade with the tone ─────── */
  .site-logo {
    position: relative;
    border-radius: 0.25rem;
    padding: 0;
  }
  /* Optical alignment to the left edge, only where the logo sits there. */
  @media (min-width: 1024px) {
    .site-logo {
      margin-inline-start: -0.18rem;
    }
  }

  .site-logo:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 0.45rem;
  }

  .site-logo__img {
    display: block;
    transition:
      opacity 320ms theme('transitionTimingFunction.out-expo');
  }

  .site-logo__img--dark {
    opacity: 0;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.42));
  }

  #site-header[data-state='top'] .site-logo__img--light {
    opacity: 0;
  }

  #site-header[data-state='top'] .site-logo__img--dark {
    opacity: 1;
  }

  #site-header[data-state='scrolled'] .site-logo__img--light,
  body.has-solid-header #site-header .site-logo__img--light {
    opacity: 1;
  }

  #site-header[data-state='scrolled'] .site-logo__img--dark,
  body.has-solid-header #site-header .site-logo__img--dark {
    opacity: 0;
  }

  #site-header[data-tone='dark'] .site-logo__img--light {
    opacity: 0;
  }

  #site-header[data-tone='dark'] .site-logo__img--dark {
    opacity: 1;
  }

  #site-header[data-tone='light'] .site-logo__img--light {
    opacity: 1;
  }

  #site-header[data-tone='light'] .site-logo__img--dark {
    opacity: 0;
  }

  body.has-solid-header #site-header[data-tone='light'] .site-logo__img--light,
  #site-header[data-state='scrolled'][data-tone='light'] .site-logo__img--light {
    opacity: 1;
  }

  body.has-solid-header #site-header[data-tone='light'] .site-logo__img--dark,
  #site-header[data-state='scrolled'][data-tone='light'] .site-logo__img--dark {
    opacity: 0;
  }

  /* ── Menu button lines → cross when open ───────────────────────── */
  .mobile-menu-button__lines {
    display: grid;
    gap: 3.5px;
    width: 18px;
  }

  .mobile-menu-button__lines span {
    display: block;
    height: 1.5px;
    width: 18px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 400ms theme('transitionTimingFunction.out-expo'),
      opacity 250ms ease;
  }

  #site-header[data-menu-open='true'] .mobile-menu-button__lines span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  #site-header[data-menu-open='true'] .mobile-menu-button__lines span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.55);
  }

  #site-header[data-menu-open='true'] .mobile-menu-button__lines span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* ── Scrim behind the open menu ────────────────────────────────────
     Absolute, not fixed: the header's backdrop-filter makes it the
     containing block for fixed children. The header sits at top 0, so
     top 0 + 100dvh covers the viewport either way. */
  .menu-scrim {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: rgb(18 22 28 / 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms theme('transitionTimingFunction.out-expo');
  }

  #site-header[data-menu-open='true'] .menu-scrim {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Menu panel (< 1024) ───────────────────────────────────────── */
  .mobile-menu {
    position: absolute;
    inset-inline-start: 1.5rem;
    inset-inline-end: auto;
    top: calc(100% + 0.35rem);
    z-index: 1;
    display: grid;
    gap: 0.05rem;
    width: min(32.5rem, calc(100vw - 3rem));
    max-height: calc(100dvh - 6.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(0.72rem, 3.2vw, 1.15rem);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: clamp(1.65rem, 6vw, 2.35rem);
    color: #fff;
    background:
      radial-gradient(circle at 12% 100%, rgba(186, 45, 32, 0.18), transparent 44%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.045) 44%, rgba(18, 22, 28, 0.18)),
      rgba(19, 23, 30, 0.96);
    backdrop-filter: blur(30px) saturate(150%);
    -webkit-backdrop-filter: blur(30px) saturate(150%);
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.62),
      inset 0 22px 36px -28px rgba(255, 255, 255, 0.54),
      inset 0 -1px 0 rgba(0, 0, 0, 0.22),
      0 22px 60px -28px rgba(0, 0, 0, 0.68),
      0 0 0 1px rgba(18, 22, 28, 0.20);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px) scale(0.985);
    transform-origin: top left;
    transition:
      opacity 320ms theme('transitionTimingFunction.out-expo'),
      visibility 320ms step-end,
      transform 420ms theme('transitionTimingFunction.out-expo');
  }

  @media (min-width: 768px) {
    .mobile-menu {
      inset-inline-start: 2.5rem;
      width: min(26rem, calc(100vw - 5rem));
    }
  }

  /* The panel is dark on every surface, so its focus ring is cream. */
  .mobile-menu > * {
    --focus-ring: theme('colors.cream.50');
  }

  #site-header[data-menu-open='true'] .mobile-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 280ms theme('transitionTimingFunction.out-expo'),
      visibility 0ms,
      transform 420ms theme('transitionTimingFunction.out-expo');
  }

  .mobile-menu__link {
    position: relative;
    display: flex;
    min-height: max(2.75rem, clamp(2.55rem, 8.6vw, 3.55rem));
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 1.15rem;
    padding: 0.34rem clamp(0.65rem, 2.7vw, 0.95rem);
    color: rgb(255 255 255 / 0.9);
    font-family: theme('fontFamily.display');
    font-size: clamp(1.18rem, 5.9vw, 1.62rem);
    -webkit-text-stroke: 0.03em currentColor;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition:
      background-color 260ms theme('transitionTimingFunction.out-expo'),
      color 260ms theme('transitionTimingFunction.out-expo'),
      transform 260ms theme('transitionTimingFunction.out-expo');
  }

  @media (min-width: 768px) {
    .mobile-menu__link {
      font-size: 1.45rem;
    }
  }

  .mobile-menu__link:hover,
  .mobile-menu__link:focus-visible {
    background-color: rgb(255 255 255 / 0.12);
    color: #fff;
    transform: translateX(2px);
  }

  /* Current page: a lighter row only (no red bar, owner 26.11.2026). */
  .mobile-menu__link[aria-current='page'] {
    background-color: rgb(255 255 255 / 0.1);
    color: #fff;
  }

  .mobile-menu__link svg {
    width: clamp(0.9rem, 4vw, 1.2rem);
    height: clamp(0.9rem, 4vw, 1.2rem);
    flex: 0 0 auto;
    opacity: 0.94;
  }

  .mobile-menu__actions {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.6rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .mobile-menu__note {
    padding-top: 0.15rem;
    text-align: center;
    color: rgb(255 255 255 / 0.6);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }


  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-scrim,
    .mobile-menu-button__lines span,
    .mobile-menu__link {
      transition: none;
    }

    .mobile-menu__link:hover,
    .mobile-menu__link:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  const setup = () => {
    const w = window as Window & {
      __artstroiHeaderCleanup?: () => void;
      __lenis?: { stop: () => void; start: () => void };
    };
    w.__artstroiHeaderCleanup?.();

    const header = document.getElementById('site-header');
    const progress = document.getElementById('scroll-progress');
    const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu-link]'));
    if (!header || !progress) return;

    const controller = new AbortController();
    const { signal } = controller;

    let raf = 0;
    const logo = header.querySelector<HTMLElement>('.site-logo');

    const parseRgb = (value: string) => {
      const match = value.match(/rgba?\(([^)]+)\)/);
      if (!match) return null;
      const parts = match[1].split(/,\s*/).map((part) => Number.parseFloat(part));
      const [r, g, b, a = 1] = parts;
      if ([r, g, b, a].some((part) => Number.isNaN(part))) return null;
      return { r, g, b, a };
    };

    const luminance = ({ r, g, b }: { r: number; g: number; b: number }) => {
      const channel = (value: number) => {
        const normal = value / 255;
        return normal <= 0.03928 ? normal / 12.92 : ((normal + 0.055) / 1.055) ** 2.4;
      };
      return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
    };

    const explicitTone = (element: Element | null) => {
      const toneElement = element?.closest<HTMLElement>('[data-header-tone]');
      const tone = toneElement?.dataset.headerTone;
      return tone === 'dark' || tone === 'light' ? tone : null;
    };

    const inferTone = () => {
      if (!logo) return window.scrollY > 80 || document.body.classList.contains('has-solid-header') ? 'light' : 'dark';

      const rect = logo.getBoundingClientRect();
      const x = Math.round(rect.left + rect.width * 0.5);
      const y = Math.round(rect.top + rect.height * 0.5);
      const stack = document.elementsFromPoint(x, y);
      const target = stack.find((element) => !header.contains(element) && element !== document.documentElement && element !== document.body);
      const explicit = explicitTone(target ?? null);
      if (explicit) return explicit;

      let current: Element | null = target ?? document.elementFromPoint(x, Math.min(window.innerHeight - 1, y + 48));
      let levels = 0;
      while (current && levels < 8) {
        const explicitCurrent = explicitTone(current);
        if (explicitCurrent) return explicitCurrent;

        const styles = window.getComputedStyle(current);
        const color = parseRgb(styles.backgroundColor);
        if (color && color.a >= 0.35) {
          return luminance(color) < 0.36 ? 'dark' : 'light';
        }

        current = current.parentElement;
        levels += 1;
      }

      return window.scrollY > 80 || document.body.classList.contains('has-solid-header') ? 'light' : 'dark';
    };

    // While the menu is open the page behind the scrim does not scroll.
    const lockScroll = (locked: boolean) => {
      const value = locked ? 'hidden' : '';
      document.documentElement.style.overflow = value;
      document.body.style.overflow = value;
      if (locked) w.__lenis?.stop();
      else w.__lenis?.start();
    };

    const isOpen = () => header.dataset.menuOpen === 'true';

    const closeMenu = () => {
      const wasOpen = isOpen();
      header.dataset.menuOpen = 'false';
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Отворете менюто');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.setAttribute('inert', '');
      if (wasOpen) lockScroll(false);
    };
    const openMenu = () => {
      header.dataset.menuOpen = 'true';
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Затворете менюто');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.removeAttribute('inert');
      lockScroll(true);
    };
    const toggleMenu = () => {
      if (isOpen()) closeMenu();
      else openMenu();
    };
    const update = () => {
      raf = 0;
      const y = window.scrollY;
      const h = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = h > 0 ? Math.min(y / h, 1) : 0;
      progress.style.width = `${ratio * 100}%`;
      header.dataset.state = y > 80 ? 'scrolled' : 'top';
      header.dataset.tone = inferTone();
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    header.dataset.menuOpen = 'false';
    closeMenu();
    update();
    toggle?.addEventListener('click', toggleMenu, { signal });
    scrim?.addEventListener('click', closeMenu, { signal });
    links.forEach((link) => link.addEventListener('click', closeMenu, { signal }));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      closeMenu();
      toggle?.focus();
    }, { signal });
    // Tabbing out of the open menu closes it, so focus never lands on the
    // page hidden behind the scrim.
    header.addEventListener('focusout', (event) => {
      if (!isOpen()) return;
      const next = event.relatedTarget;
      if (next instanceof Node && !header.contains(next)) closeMenu();
    }, { signal });
    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      const target = event.target;
      if (target instanceof Node && !header.contains(target)) closeMenu();
    }, { signal });
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', () => {
      closeMenu();
      onScroll();
    }, { passive: true, signal });

    w.__artstroiHeaderCleanup = () => {
      closeMenu();
      controller.abort();
      if (raf) cancelAnimationFrame(raf);
    };
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
