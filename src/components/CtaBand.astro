---
// Closing call-to-action band shared by /uslugi and /za-nas: dark slab,
// title left, hours + three direct phone lines + two buttons right.
// One look and one button text on every page that uses it (vizualen Н11).
import Reveal from './Reveal.astro';
import { company, phone, telHref } from '../data/company';

const phones = [phone('Управител'), phone('Технически директор'), phone('Транспорт')];
---

<section class="cta-band relative isolate overflow-hidden bg-ink-950 text-white py-16 lg:py-20" aria-labelledby="cta-band-heading">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet opacity-[0.18]"></div>

  <div class="container-page relative">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-end">
      <Reveal class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-brand"></span>
          Запитване
        </p>
        <h2
          id="cta-band-heading"
          class="cta-band__title mt-5 font-display tracking-tight leading-[1.05] text-white max-w-[24ch]"
          style="font-size: clamp(1.9rem, 1rem + 2.8vw, 3.5rem); letter-spacing: -0.02em;"
        >
          Имате обект за строеж или ремонт?
          <span class="block text-white/65">Обадете се или ни пишете.</span>
        </h2>
      </Reveal>

      <Reveal class="lg:col-span-5 lg:pb-2" delay={120}>
        <p class="cta-band__lead text-[15px] md:text-base text-white/70 leading-[1.65] max-w-[44ch]">
          Работим {company.hoursDays} {company.hoursTime}. Пишете ни и за по-необичайни задачи: реставрация, аварийни укрепвания, общински обекти.
        </p>

        <ul class="cta-band__phones mt-6 grid grid-cols-1 sm:grid-cols-3 gap-px bg-white/12 rounded-[4px] overflow-hidden">
          {phones.map((p) => (
            <li class="cta-band__phone bg-ink-950 px-4 py-3.5">
              <p class="text-xs uppercase tracking-eyebrow text-brand">{p.roleShort}</p>
              <a href={telHref(p.number)} class="mt-1 block text-[15px] text-white tabular-nums whitespace-nowrap hover:text-brand transition-colors">
                {p.number}
              </a>
            </li>
          ))}
        </ul>

        <div class="cta-band__actions mt-6 flex flex-wrap gap-3">
          <a href="/kontakti" class="btn-brand">
            Изпратете запитване
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/proekti" class="btn-ghost">
            Реализирани обекти
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .cta-band__phone {
    transition: background-color 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-band__phone:hover {
    background: rgba(186, 45, 32, 0.10);
  }
  /* Phones: three in a row from 640px; below that the manager's line is
     full width and the other two share a row. */
  @media (max-width: 639px) {
    .cta-band__phones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cta-band__phone { padding: 0.8rem 0.85rem; }
    .cta-band__phone:first-child { grid-column: 1 / -1; }
    .cta-band__actions > a { flex: 1 1 auto; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-band__phone { transition: none; }
  }
</style>
