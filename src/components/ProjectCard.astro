---
import type { Project } from '../data/projects';
import { responsiveImage } from '../data/assets';

interface Props {
  project: Project;
  index?: number;
  /** Optional override aspect ratio (defaults to portrait 3/4 desktop) */
  aspect?: string;
  /** Compact variant for one-row featured grids — smaller type, smaller arrow */
  size?: 'default' | 'sm';
  /** When set, the card plays this video on hover and reveals a description. */
  videoUrl?: string;
  /** When set, the card cycles through these images on hover (slideshow). */
  hoverImages?: string[];
  /**
   * `sizes` for the photo: the width it is drawn at. Photos are landscape
   * and cropped into a portrait box, so this is ~1.7× the card width.
   * Default: the /proekti grid (2 columns, 3 from md).
   */
  sizes?: string;
}

const {
  project,
  index = 0,
  aspect = 'aspect-[3/4]',
  size = 'default',
  videoUrl,
  hoverImages = [],
  sizes = '(min-width: 1280px) 620px, (min-width: 768px) 50vw, 80vw',
} = Astro.props;
const isSmall = size === 'sm';
const hasVideo = Boolean(videoUrl);
const hasSlideshow = !hasVideo && hoverImages.length > 0;
const hasHoverFx = hasVideo || hasSlideshow;

const cover = project.coverImageUrl ?? '/hero/hero-poster.jpg';
const coverImg = responsiveImage(cover, sizes);
const locationLabel = (project.location ?? '').split(',')[0]?.trim().toUpperCase() || 'БЪЛГАРИЯ';
const href = `/proekti/${project.slug}`;
const description = project.description?.trim() || '';
---

<a
  href={href}
  class:list={[
    'project-card group relative block overflow-hidden rounded-2xl bg-ink-900 text-white',
    aspect,
    hasHoverFx && 'has-hover-fx',
    hasVideo && 'has-hover-video',
    hasSlideshow && 'has-hover-slideshow',
  ]}
  data-index={index}
  style={`view-transition-name: project-${project.slug};`}
>
  <!-- Image layer (slow zoom on hover) -->
  <div class="absolute inset-0">
    <img
      {...coverImg}
      alt={project.title}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-[4000ms] ease-out-expo group-hover:scale-[1.08]"
    />
  </div>

  {hasVideo && (
    <!-- Video layer (hidden by default; fades in & plays on hover) -->
    <video
      class="hover-video absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-out-expo group-hover:opacity-100"
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  )}

  {hasSlideshow && (
    <!-- Slideshow layer (hidden by default; cycles through gallery on hover) -->
    <div class="hover-slideshow absolute inset-0" aria-hidden="true">
      {/* No `src` until the first hover: the slides are never shown on touch
          screens, so they must not cost a download there. */}
      {hoverImages.map((url) => {
        const { src, srcset, ...rest } = responsiveImage(url, sizes);
        return (
        <img
          data-src={src}
          data-srcset={srcset}
          {...rest}
          alt=""
          decoding="async"
          class="slide absolute inset-0 h-full w-full object-cover"
        />
        );
      })}
    </div>
  )}

  <!-- Gradient overlay -->
  <div
    class="absolute inset-0 transition-opacity duration-600 ease-out-expo"
    aria-hidden="true"
    style="background: linear-gradient(to top, rgba(18,22,28,0.92) 0%, rgba(18,22,28,0.62) 32%, rgba(18,22,28,0.12) 62%, rgba(18,22,28,0.0) 80%);"
  ></div>

  {hasHoverFx && (
    <!-- Extra darkening on hover so description text reads cleanly over media -->
    <div
      class="absolute inset-0 bg-ink-950/55 opacity-0 transition-opacity duration-500 ease-out-expo group-hover:opacity-100"
      aria-hidden="true"
    ></div>
  )}

  <!-- Content (bottom) -->
  <div class:list={[
    'relative z-10 flex h-full flex-col justify-end',
    isSmall ? 'p-4' : 'p-3 md:p-4 lg:p-7',
  ]}>
    <div class="flex items-end justify-between gap-3">
      <div class="min-w-0 flex-1">
        <!-- Place chip. On a two-column phone grid the title needs the room,
             and most titles already name the place. -->
        <p class:list={['card-loc', !isSmall && 'card-loc--wide']}>
          {locationLabel}
        </p>
        <h3
          class:list={[
            'font-display tracking-tight text-white',
            isSmall
              ? 'mt-2 text-base leading-[1.1] md:text-[15px] max-w-[26ch] line-clamp-3'
              : 'text-base leading-[1.15] line-clamp-4 md:mt-3 md:text-lg md:leading-[1.1] md:line-clamp-3 lg:text-2xl lg:leading-[1.05] max-w-[26ch]',
          ]}
        >
          {project.title}
        </h3>
        {hasHoverFx && description && (
          <p
            class:list={[
              'hover-desc text-white/85 max-w-[34ch] line-clamp-3',
              'text-sm leading-snug',
            ]}
          >
            {description}
          </p>
        )}
        {!isSmall && !hasHoverFx && (
          <span
            class="mt-4 block h-px w-0 bg-brand transition-[width] duration-700 ease-out-expo group-hover:w-24 hidden md:block"
            aria-hidden="true"
          />
        )}
      </div>
      <span
        class:list={[
          'grid shrink-0 place-items-center rounded-full bg-brand text-white shadow-lift transition-all duration-500 ease-out-expo group-hover:scale-110 group-hover:-rotate-12',
          isSmall ? 'h-9 w-9' : 'max-lg:hidden h-12 w-12',
        ]}
        aria-hidden="true"
      >
        <svg
          class={isSmall ? 'w-[11px] h-[11px]' : 'w-3.5 h-3.5'}
          viewBox="0 0 14 14"
          fill="none"
        >
          <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .project-card {
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 32px 64px -16px rgba(0, 0, 0, 0.35),
                0 0 0 1px rgba(186, 45, 32, 0.20);
  }

  /* Description reveal — collapsed by default, expands on hover with a soft
     fade-up. Uses grid-rows trick to animate height without max-height jank. */
  .hover-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    transform: translateY(8px);
    overflow: hidden;
    transition:
      max-height 1000ms cubic-bezier(0.16, 1, 0.3, 1),
      margin-top 1000ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 800ms cubic-bezier(0.16, 1, 0.3, 1) 200ms,
      transform 800ms cubic-bezier(0.16, 1, 0.3, 1) 200ms;
  }
  @media (hover: hover) {
    .has-hover-fx:hover .hover-desc {
      max-height: 8rem;
      margin-top: 0.5rem;
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Touch screens have no hover: the description and the slideshow are not
     part of the card there (the archive grid shows the text under the card
     from tablet width; the detail page has it in full). */
  @media (hover: none) {
    .hover-desc,
    .hover-slideshow { display: none; }
  }

  /* Place chip on the photo */
  .card-loc {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
  }
  @media (max-width: 767.98px) {
    .card-loc--wide { display: none; }
  }

  /* Slideshow: each slide stacked over the cover image, hidden by default.
     Snappy crossfade — short duration with a faster ease-in-out curve,
     so transitions feel decisive rather than buttery-smooth. */
  .hover-slideshow .slide {
    opacity: 0;
    transition: opacity 280ms cubic-bezier(0.7, 0, 0.3, 1);
  }
  .hover-slideshow .slide.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover { transform: none; }
    .project-card img { transform: none !important; }
    .hover-desc { transition: none; }
    .hover-video { transition: none !important; }
    .hover-slideshow .slide { transition: none !important; }
  }
</style>

<script>
  // Hover behaviour of the cards on the current page. ClientRouter runs this
  // module once per visit, so the cards are wired on every `astro:page-load`
  // and released on `astro:before-swap` (timers, playing videos, listeners).
  const SLIDE_INTERVAL_MS = 1700;
  let pageScope: AbortController | null = null;

  function releaseCards() {
    pageScope?.abort();
    pageScope = null;
  }

  function initProjectCards() {
    releaseCards();
    const scope = new AbortController();
    pageScope = scope;
    const { signal } = scope;

    // ── Hover videos: play on enter, rewind on leave ──────────
    for (const card of document.querySelectorAll<HTMLElement>('.has-hover-video')) {
      const video = card.querySelector<HTMLVideoElement>('video.hover-video');
      if (!video) continue;
      let playPromise: Promise<void> | undefined;
      const reset = () => {
        video.pause();
        video.currentTime = 0;
      };
      card.addEventListener('mouseenter', () => {
        playPromise = video.play().catch(() => undefined);
      }, { signal });
      card.addEventListener('mouseleave', () => {
        if (playPromise) playPromise.then(reset);
        else reset();
      }, { signal });
      signal.addEventListener('abort', () => video.pause());
    }

    // ── Hover slideshow: cycle through the gallery while hovered ──
    // The slides get their `src` on the first hover only.
    for (const card of document.querySelectorAll<HTMLElement>('.has-hover-slideshow')) {
      const slides = Array.from(card.querySelectorAll<HTMLImageElement>('img.slide'));
      if (slides.length === 0) continue;
      let current = -1;
      let timerId: number | null = null;

      const advance = () => {
        const next = (current + 1) % slides.length;
        if (current >= 0) slides[current].classList.remove('is-active');
        slides[next].classList.add('is-active');
        current = next;
      };
      const stop = () => {
        if (timerId !== null) {
          window.clearInterval(timerId);
          timerId = null;
        }
        for (const s of slides) s.classList.remove('is-active');
        current = -1;
      };

      card.addEventListener('mouseenter', () => {
        if (timerId !== null) return;
        for (const s of slides) {
          if (s.getAttribute('src') || !s.dataset.src) continue;
          if (s.dataset.srcset) s.srcset = s.dataset.srcset;
          s.src = s.dataset.src;
        }
        advance();
        timerId = window.setInterval(advance, SLIDE_INTERVAL_MS);
      }, { signal });
      card.addEventListener('mouseleave', stop, { signal });
      // A click navigates without `mouseleave`.
      signal.addEventListener('abort', stop);
    }
  }

  document.addEventListener('astro:page-load', initProjectCards);
  document.addEventListener('astro:before-swap', releaseCards);
</script>
