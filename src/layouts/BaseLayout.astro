---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noHeader?: boolean;
  noFooter?: boolean;
  /** When the page top is light (no dark hero), force the header into its
      solid/opaque state so the nav stays readable from the start. */
  solidHeader?: boolean;
}

const {
  title = 'АРТСТРОЙ ООД — Строителство в Смолян и България',
  description = 'Строителна компания АРТСТРОЙ ООД от Смолян. Жилищни сгради, обществени обекти, хотели и инфраструктура. Над 55 реализирани проекта от 1992.',
  ogImage = '/og-default.jpg',
  noHeader = false,
  noFooter = false,
  solidHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#12161C" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="bg_BG" />

    <!-- Fonts: Fraunces only — single-family system covering body, UI and
         display headings. Cyrillic + Latin subsets, italics included. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600&display=swap&subset=cyrillic,latin"
    />

    <ClientRouter />
  </head>
  <body class:list={["min-h-screen bg-ink-0 text-ink-900 antialiased", solidHeader && "has-solid-header"]}>
    {!noHeader && <Header />}
    <main>
      <slot />
    </main>
    {!noFooter && <Footer />}
    <SmoothScroll />
  </body>
</html>
