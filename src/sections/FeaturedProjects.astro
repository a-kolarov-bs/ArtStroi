---
import type { Project } from '../data/projects';
import { projects as allProjects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
import Reveal from '../components/Reveal.astro';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const total = allProjects.length;
---

<section class="relative isolate overflow-hidden bg-cream-50 py-16 md:py-20 lg:py-24" id="featured-projects" aria-labelledby="fp-heading">
  <!-- Architectural sheet — back layer -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bp-sheet bp-sheet-d"></div>

  <div class="container-page relative">
    <Reveal class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8 md:mb-10">
      <div>
        <p class="eyebrow flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-brand"></span>
          Реализирани обекти
        </p>
        <h2
          id="fp-heading"
          class="mt-5 font-display text-display-md text-ink-950"
        >
          Избрани <span class="text-brand">проекти</span>.
        </h2>
      </div>
      <div class="flex items-center gap-5">
        <p class="text-xs uppercase tracking-eyebrow text-ink-600 whitespace-nowrap">
          <span class="text-ink-950">{projects.length}</span> от <span class="text-ink-950">{total}</span>
        </p>
        <a href="/proekti" class="btn-ghost-dark">
          Вижте всички
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 11L11 3m0 0H5m6 0v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Reveal>
  </div>

  <!-- One horizontal scroll-snap track for every width; the first card
       lines up with the content edge of .container-page. -->
  <ul class="fp-track flex gap-3 md:gap-4 lg:gap-5 overflow-x-auto snap-x-mandatory pb-4">
    {projects.map((p, i) => (
      <li class="fp-card snap-start shrink-0">
        <ProjectCard
          project={p}
          index={i}
          aspect="aspect-[3/4]"
          size="sm"
          sizes="(min-width: 417px) 534px, 128vw"
          videoUrl={i === 0 ? '/services/sample-desktop.mp4' : undefined}
        />
      </li>
    ))}
  </ul>
</section>

<style>
  .fp-track {
    /* Content edge of .container-page: half of what is left beside the
       80rem column, plus the page gutter (px-6 / md:px-10 / lg:px-12). */
    --fp-gutter: 1.5rem;
    --fp-start: calc(max(0px, (100% - 80rem) / 2) + var(--fp-gutter));
    --fp-card-w: min(72vw, 300px);

    padding-inline: var(--fp-start) var(--fp-gutter);
    scroll-padding-inline-start: var(--fp-start);
    scrollbar-width: none;
  }
  @media (min-width: 768px) {
    .fp-track {
      --fp-gutter: 2.5rem;
      --fp-card-w: clamp(280px, 30vw, 340px);
    }
  }
  @media (min-width: 1024px) {
    .fp-track {
      --fp-gutter: 3rem;
      --fp-card-w: clamp(280px, 24vw, 340px);
    }
  }
  .fp-track::-webkit-scrollbar { display: none; }

  /* Explicit width AND aspect-ratio keep every card the same height. */
  .fp-card {
    width: var(--fp-card-w);
    aspect-ratio: 3 / 4;
  }
  .fp-card > :global(a) {
    height: 100%;
  }
</style>
